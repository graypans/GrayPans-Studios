{
  "name": "ProjectPorcelain",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "CharacterWalkSpeed": 14
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap",
        "Brightness": 1,
        "ClockTime": 0,
        "GlobalShadows": true,
        "Ambient": [0.1058, 0.0901, 0.1215],
        "OutdoorAmbient": [0.0705, 0.0627, 0.0901]
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
