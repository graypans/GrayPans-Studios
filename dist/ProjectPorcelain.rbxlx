          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">CameraReporter</string>
              <string name="Source"><![CDATA[--!strict
-- Streams the local camera CFrame so the server can run the watched-check (Weeping Angels rule).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any

local CameraReporter = {}

function CameraReporter.init()
	local remote = Remotes.get(Remotes.Names.CameraReport)
	local interval = 1 / Config.Tells.WatchReportHz
	local acc = 0
	RunService.RenderStepped:Connect(function(dt: number)
		acc += dt
		if acc < interval then
			return
		end
		acc = 0
		local camera = workspace.CurrentCamera
		if camera then
			remote:FireServer(camera.CFrame)
		end
	end)
end

return CameraReporter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">DebugOverlay</string>
              <string name="Source"><![CDATA[--!strict
-- Debug overlay (R7): presence, tier, state, watched map, marked doll. DebugMode only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local DebugOverlay = {}

function DebugOverlay.init()
	if not Config.DebugMode then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Theme.screenGui("PorcelainDebug", 25)
	gui.Parent = playerGui
	local panel = Theme.panel(gui, {
		Position = UDim2.new(0, 8, 0.35, 0),
		Size = UDim2.new(0, 240, 0, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.35,
	})
	local text = Theme.label(panel, {
		Position = UDim2.new(0, 8, 0, 6),
		Size = UDim2.new(1, -16, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Enum.Font.Code,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "debug: waiting…",
	})
	local pad = Instance.new("UIPadding")
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = panel

	Remotes.get(Remotes.Names.DebugInfo).OnClientEvent:Connect(function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		local lines = {
			("state: %s   shift: %s"):format(tostring(payload.state), tostring(payload.shift)),
			("presence: %s  tier: %s"):format(tostring(payload.presence), tostring(payload.tier)),
			("marked: %s"):format(tostring(payload.marked)),
			"watched:",
		}
		if typeof(payload.watched) == "table" then
			for dollId, watched in payload.watched do
				table.insert(lines, ("  %s %s"):format(if watched then "👁" else "·", tostring(dollId)))
			end
		end
		text.Text = table.concat(lines, "\n")
	end)
end

return DebugOverlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">DetectorClient</string>
              <string name="Source"><![CDATA[--!strict
-- Spirit Compass feel: passive rattle rate + glow by distance to the nearest uncollected glyph.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any

local DetectorClient = {}

local equipped: Tool? = nil
local lastTick = 0

local function watchCharacter(char: Model)
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == "Spirit Compass" then
			equipped = child
		end
	end)
	char.ChildRemoved:Connect(function(child)
		if child == equipped then
			equipped = nil
		end
	end)
	local existing = char:FindFirstChild("Spirit Compass")
	if existing and existing:IsA("Tool") then
		equipped = existing
	end
end

function DetectorClient.init()
	if not Config.Features.Detector then
		return
	end
	local player = Players.LocalPlayer
	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)

	RunService.Heartbeat:Connect(function()
		local tool = equipped
		if not tool then
			return
		end
		local handle = tool:FindFirstChild("Handle")
		local targets = tool:FindFirstChild("GlyphTargets")
		if not (handle and handle:IsA("BasePart") and targets) then
			return
		end
		local best = math.huge
		for _, value in targets:GetChildren() do
			if value:IsA("Vector3Value") then
				local d = (value.Value - handle.Position).Magnitude
				best = math.min(best, d)
			end
		end
		local light = handle:FindFirstChild("GlowLight")
		if best == math.huge or best > Config.Glyphs.DetectorMaxRange then
			if light and light:IsA("PointLight") then
				light.Brightness = 0
			end
			return
		end
		local closeness = 1 - best / Config.Glyphs.DetectorMaxRange -- 0..1
		if light and light:IsA("PointLight") then
			light.Brightness = 0.2 + closeness * 3
		end
		-- tick rate 0.2..5 Hz by proximity
		local rate = 0.2 + closeness * 4.8
		local now = os.clock()
		if now - lastTick >= 1 / rate then
			lastTick = now
			SoundKit.play("DetectorTick")
		end
	end)
end

return DetectorClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">ErrorPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Error panel (R7): last 10 client errors, screenshot-friendly, toggled by a small bug button.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ScriptContext = game:GetService("ScriptContext")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local ErrorPanel = {}

local errors: { string } = {}

function ErrorPanel.init()
	if not Config.DebugMode then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Theme.screenGui("PorcelainErrors", 26)
	gui.Parent = playerGui

	local panel = Theme.panel(gui, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -90),
		Size = UDim2.new(0, 420, 0, 200),
		BackgroundTransparency = 0.15,
		Visible = false,
	})
	local text = Theme.label(panel, {
		Position = UDim2.new(0, 8, 0, 26),
		Size = UDim2.new(1, -16, 1, -34),
		Font = Enum.Font.Code,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Theme.Danger,
		Text = "no client errors 🎉  (server errors: check Studio Output)",
	})
	Theme.label(panel, {
		Position = UDim2.new(0, 8, 0, 4),
		Size = UDim2.new(1, -16, 0, 20),
		TextSize = 13,
		TextColor3 = Theme.Muted,
		Text = "last 10 client errors — screenshot this for bug reports",
	})

	local toggle = Theme.button(gui, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -14),
		Size = UDim2.new(0, 64, 0, 64),
		TextSize = 26,
		Text = "🐞",
	})
	toggle.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)

	ScriptContext.Error:Connect(function(message: string, _trace: string, _source: Instance?)
		table.insert(errors, 1, ("[%s] %s"):format(os.date("%H:%M:%S"), message))
		while #errors > 10 do
			table.remove(errors)
		end
		text.Text = table.concat(errors, "\n")
	end)
end

return ErrorPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">HauntClient</string>
              <string name="Source"><![CDATA[--!strict
-- Client-scope haunts: WhisperPass, the Taken stub, and the DollmakerReveal run-end scare.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local HauntClient = {}

local gui: ScreenGui? = nil

local function cameraShake(intensity: number, duration: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < duration do
			local offset = CFrame.new(
				(math.random() - 0.5) * intensity,
				(math.random() - 0.5) * intensity,
				0
			)
			camera.CFrame = camera.CFrame * offset
			task.wait(0.03)
		end
	end)
end

local function whisperPass()
	SoundKit.play("WhisperPass")
	cameraShake(0.08, 0.6)
	local g = gui
	if not g then
		return
	end
	local vignette = Instance.new("Frame")
	vignette.BackgroundColor3 = Color3.new(0, 0, 0)
	vignette.BackgroundTransparency = 1
	vignette.BorderSizePixel = 0
	vignette.Size = UDim2.new(1, 0, 1, 0)
	vignette.Parent = g
	TweenService:Create(vignette, TweenInfo.new(0.3), { BackgroundTransparency = 0.55 }):Play()
	task.delay(0.8, function()
		TweenService:Create(vignette, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
		task.delay(1.1, function()
			vignette:Destroy()
		end)
	end)
end

local function takenStub()
	local g = gui
	if not g then
		return
	end
	local dark = Instance.new("Frame")
	dark.BackgroundColor3 = Color3.new(0, 0, 0)
	dark.BackgroundTransparency = 0.2
	dark.BorderSizePixel = 0
	dark.Size = UDim2.new(1, 0, 1, 0)
	dark.Parent = g
	local label = Theme.label(dark, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0.8, 0, 0, 60),
		Font = Theme.TitleFont,
		TextSize = 32,
		Text = "wake up… (tap 5 times)",
	})
	local taps = 0
	local button = Instance.new("TextButton")
	button.BackgroundTransparency = 1
	button.Size = UDim2.new(1, 0, 1, 0)
	button.Text = ""
	button.Parent = dark
	button.Activated:Connect(function()
		taps += 1
		label.Text = ("wake up… (%d more)"):format(math.max(0, 5 - taps))
		if taps >= 5 then
			dark:Destroy()
		end
	end)
	task.delay(20, function() -- hard auto-clear (R2)
		if dark.Parent then
			dark:Destroy()
		end
	end)
end

local function dollmakerReveal()
	local g = gui
	if not g then
		return
	end
	local dark = Instance.new("Frame")
	dark.BackgroundColor3 = Color3.new(0, 0, 0)
	dark.BackgroundTransparency = 0
	dark.BorderSizePixel = 0
	dark.Size = UDim2.new(1, 0, 1, 0)
	dark.ZIndex = 5
	dark.Parent = g
	task.delay(0.5, function()
		SoundKit.play("DollmakerScream")
		cameraShake(0.35, 1.2)
		-- the towering shadow face, assembled from frames
		local face = Instance.new("Frame")
		face.AnchorPoint = Vector2.new(0.5, 0.5)
		face.Position = UDim2.new(0.5, 0, 1.4, 0)
		face.Size = UDim2.new(0, 500, 0, 620)
		face.BackgroundTransparency = 1
		face.ZIndex = 6
		face.Parent = dark
		local function facePart(pos: UDim2, size: UDim2, color: Color3, rotation: number?)
			local frame = Instance.new("Frame")
			frame.AnchorPoint = Vector2.new(0.5, 0.5)
			frame.Position = pos
			frame.Size = size
			frame.Rotation = rotation or 0
			frame.BackgroundColor3 = color
			frame.BorderSizePixel = 0
			frame.ZIndex = 6
			frame.Parent = face
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.5, 0)
			corner.Parent = frame
		end
		local shadow = Color3.fromRGB(16, 12, 18)
		local eye = Color3.fromRGB(212, 175, 96)
		facePart(UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.9, 0.95), shadow) -- head mass
		facePart(UDim2.fromScale(0.32, 0.38), UDim2.fromScale(0.16, 0.1), eye) -- left eye
		facePart(UDim2.fromScale(0.68, 0.36), UDim2.fromScale(0.13, 0.13), eye, 12) -- right eye, wrong size
		facePart(UDim2.fromScale(0.5, 0.68), UDim2.fromScale(0.5, 0.05), Color3.fromRGB(60, 40, 50), -6) -- stitched smile
		for i = 1, 6 do
			facePart(
				UDim2.fromScale(0.28 + (i - 1) * 0.09, 0.68 + (if i % 2 == 0 then 0.03 else -0.03)),
				UDim2.fromScale(0.02, 0.09),
				Color3.fromRGB(60, 40, 50),
				15
			)
		end
		TweenService:Create(face, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, 0, 0.5, 0),
		}):Play()
		task.delay(2.5, function()
			TweenService:Create(dark, TweenInfo.new(1.5), { BackgroundTransparency = 1 }):Play()
			for _, child in face:GetChildren() do
				if child:IsA("Frame") then
					TweenService:Create(child, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
				end
			end
			task.delay(1.6, function()
				dark:Destroy()
			end)
		end)
	end)
end

function HauntClient.init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainHaunts", 18)
	g.Parent = playerGui
	gui = g

	Remotes.get(Remotes.Names.HauntFired).OnClientEvent:Connect(function(hauntId: any)
		if hauntId == "WhisperPass" then
			whisperPass()
		elseif hauntId == "Taken" then
			takenStub()
		elseif hauntId == "DollmakerReveal" then
			dollmakerReveal()
		end
		-- unknown ids: ignore silently
	end)
end

return HauntClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- HUD: shift banner, objective, strikes, doll checklist (5 listed steps only), countdown, version stamp.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local CareSteps = require(Shared:WaitForChild("Defs"):WaitForChild("CareSteps")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local Hud = {}

local shiftLabel: TextLabel? = nil
local objectiveLabel: TextLabel? = nil
local strikePips: { Frame } = {}
local dollList: Frame? = nil
local countdownLabel: TextLabel? = nil
local dollRows: { [string]: { row: Frame, ticks: { Frame }, nameLabel: TextLabel } } = {}

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Theme.screenGui("PorcelainHud", 5)
	gui.Parent = playerGui

	-- top center: shift + objective
	local top = Instance.new("Frame")
	top.BackgroundTransparency = 1
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, 12)
	top.Size = UDim2.new(0.6, 0, 0, 100)
	top.Parent = gui
	shiftLabel = Theme.label(top, {
		Size = UDim2.new(1, 0, 0, 52),
		Font = Theme.TitleFont,
		TextSize = 46,
		Text = "",
		TextStrokeTransparency = 0.5,
	})
	objectiveLabel = Theme.label(top, {
		Position = UDim2.new(0, 0, 0, 52),
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.BodyFont,
		TextSize = 18,
		TextColor3 = Theme.Muted,
		Text = "",
		TextStrokeTransparency = 0.6,
	})

	-- strikes under objective
	local strikeRow = Instance.new("Frame")
	strikeRow.BackgroundTransparency = 1
	strikeRow.AnchorPoint = Vector2.new(0.5, 0)
	strikeRow.Position = UDim2.new(0.5, 0, 0, 86)
	strikeRow.Size = UDim2.new(0, 120, 0, 18)
	strikeRow.Parent = top
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 8)
	layout.Parent = strikeRow
	for _ = 1, Config.Shift.StrikeLimit do
		local pip = Instance.new("Frame")
		pip.Size = UDim2.new(0, 14, 0, 14)
		pip.BackgroundColor3 = Theme.BgSoft
		pip.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = pip
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Danger
		stroke.Transparency = 0.4
		stroke.Parent = pip
		pip.Parent = strikeRow
		table.insert(strikePips, pip)
	end

	-- right side: doll checklist
	dollList = Theme.panel(gui, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 210, 0, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.35,
		Visible = false,
	})
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 6)
	listLayout.Parent = dollList
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 8)
	listPad.PaddingBottom = UDim.new(0, 8)
	listPad.PaddingLeft = UDim.new(0, 8)
	listPad.PaddingRight = UDim.new(0, 8)
	listPad.Parent = dollList

	-- lobby countdown overlay
	countdownLabel = Theme.label(gui, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 130),
		Size = UDim2.new(0, 400, 0, 60),
		Font = Theme.TitleFont,
		TextSize = 40,
		TextColor3 = Theme.Accent,
		Text = "",
		TextStrokeTransparency = 0.4,
	})

	-- version stamp
	Theme.label(gui, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.new(0, 300, 0, 16),
		Font = Enum.Font.Code,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Muted,
		TextTransparency = 0.4,
		Text = ("%s %s"):format(Config.Version, Config.BuildStamp),
	})
end

local function addDollRow(dollId: string, name: string)
	local list = dollList
	if not list then
		return
	end
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 40)
	row.Parent = list
	local nameLabel = Theme.label(row, {
		Size = UDim2.new(1, 0, 0, 20),
		Font = Theme.TitleFont,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = name,
	})
	local ticksRow = Instance.new("Frame")
	ticksRow.BackgroundTransparency = 1
	ticksRow.Position = UDim2.new(0, 0, 0, 22)
	ticksRow.Size = UDim2.new(1, 0, 0, 14)
	ticksRow.Parent = row
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 6)
	layout.Parent = ticksRow
	local ticks = {}
	for _ in CareSteps.list do
		local tick = Instance.new("Frame")
		tick.Size = UDim2.new(0, 22, 0, 10)
		tick.BackgroundColor3 = Theme.BgSoft
		tick.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 3)
		corner.Parent = tick
		tick.Parent = ticksRow
		table.insert(ticks, tick)
	end
	dollRows[dollId] = { row = row, ticks = ticks, nameLabel = nameLabel }
end

function Hud.init()
	build()

	Remotes.get(Remotes.Names.StateChanged).OnClientEvent:Connect(function(state: any, data: any)
		if typeof(data) ~= "table" then
			return
		end
		if shiftLabel then
			shiftLabel.Text = if state == "LobbyIdle" then "THE DOLLMAKER'S" else ("SHIFT %d"):format(data.shift or 1)
		end
		if objectiveLabel then
			objectiveLabel.Text = data.objective or ""
		end
		for i, pip in strikePips do
			pip.BackgroundColor3 = if i <= (data.strikes or 0) then Theme.Danger else Theme.BgSoft
		end
		if dollList and (state == "LobbyIdle" or state == "RunEnd") then
			dollList.Visible = false
			for _, entry in dollRows do
				entry.row:Destroy()
			end
			dollRows = {}
		end
	end)

	Remotes.get(Remotes.Names.ShiftData).OnClientEvent:Connect(function(data: any)
		if typeof(data) ~= "table" or typeof(data.dolls) ~= "table" then
			return
		end
		for _, entry in dollRows do
			entry.row:Destroy()
		end
		dollRows = {}
		if dollList then
			dollList.Visible = true
		end
		for _, doll in data.dolls do
			addDollRow(doll.id, doll.name)
		end
	end)

	Remotes.get(Remotes.Names.DollUpdate).OnClientEvent:Connect(function(dollId: any, update: any)
		local entry = dollRows[dollId]
		if not entry or typeof(update) ~= "table" then
			return
		end
		if typeof(update.name) == "string" then
			entry.nameLabel.Text = update.name
		end
		if typeof(update.careDone) == "table" then
			local doneSet: { [string]: boolean } = {}
			for _, stepId in update.careDone do
				doneSet[stepId] = true
			end
			for i, step in CareSteps.list do
				if doneSet[step.id] and entry.ticks[i] then
					entry.ticks[i].BackgroundColor3 = Theme.Gold
				end
			end
		end
		if update.done == true then
			entry.nameLabel.TextColor3 = Theme.Gold
		end
	end)

	Remotes.get(Remotes.Names.ReadyCountdown).OnClientEvent:Connect(function(seconds: any)
		if countdownLabel then
			countdownLabel.Text = if typeof(seconds) == "number" then ("The shift begins in %d…"):format(seconds) else ""
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">LedgerUI</string>
              <string name="Source"><![CDATA[--!strict
-- The Dollmaker's ledger: spirits + codes on the left, shared slots + found tray on the right.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Glyphs = require(Shared:WaitForChild("Defs"):WaitForChild("Glyphs")) :: any
local Spirits = require(Shared:WaitForChild("Defs"):WaitForChild("Spirits")) :: any
local GlyphMatch = require(Shared:WaitForChild("Logic"):WaitForChild("GlyphMatch")) :: any
local GlyphRender = require(Shared:WaitForChild("GlyphRender")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local LedgerUI = {}

local gui: ScreenGui? = nil
local slotFrames: { Frame } = {}
local trayFrame: Frame? = nil
local matchBanner: TextLabel? = nil
local found: { string } = {}
local slots: { [number]: string? } = {}
local selectedGlyph: string? = nil

local function glyphButton(parent: Instance, glyphId: string, size: number, onTap: (() -> ())?): TextButton
	local button = Theme.button(parent, {
		Size = UDim2.new(0, size, 0, size),
		Text = "",
	})
	local canvas = Instance.new("Frame")
	canvas.BackgroundTransparency = 1
	canvas.Size = UDim2.new(1, -10, 1, -10)
	canvas.Position = UDim2.new(0, 5, 0, 5)
	canvas.Parent = button
	GlyphRender.render(glyphId, canvas)
	if onTap then
		button.Activated:Connect(onTap)
	end
	return button
end

local function refreshSlots()
	for i, frame in slotFrames do
		for _, child in frame:GetChildren() do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local glyphId = slots[i]
		if glyphId then
			local canvas = Instance.new("Frame")
			canvas.BackgroundTransparency = 1
			canvas.Size = UDim2.new(1, -10, 1, -10)
			canvas.Position = UDim2.new(0, 5, 0, 5)
			canvas.Parent = frame
			GlyphRender.render(glyphId, canvas, Theme.Gold)
		else
			Theme.label(frame, {
				Size = UDim2.new(1, 0, 1, 0),
				Font = Theme.TitleFont,
				TextSize = 30,
				TextColor3 = Theme.Muted,
				TextTransparency = 0.5,
				Text = tostring(i),
			})
		end
	end
	-- client-side match feedback (server stays authoritative)
	if matchBanner then
		local spiritId = GlyphMatch.identify(Spirits.list, slots)
		if spiritId then
			local spirit = Spirits.byId[spiritId]
			matchBanner.Text = ("MATCHED: %s"):format(spirit.name)
			matchBanner.TextColor3 = Theme.Gold
		else
			matchBanner.Text = "no match yet…"
			matchBanner.TextColor3 = Theme.Muted
		end
	end
end

local function refreshTray()
	local tray = trayFrame
	if not tray then
		return
	end
	for _, child in tray:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	for _, glyphId in found do
		local button = glyphButton(tray, glyphId, 62, function()
			selectedGlyph = glyphId
			SoundKit.play("UiClick")
		end)
		local _ = button
	end
end

local function buildBook()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainLedger", 12)
	g.Enabled = false
	g.Parent = playerGui
	gui = g

	local b = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 760, 0, 460),
		BackgroundTransparency = 0.03,
	})

	Theme.label(b, {
		Position = UDim2.new(0, 0, 0, 8),
		Size = UDim2.new(1, 0, 0, 34),
		Font = Theme.TitleFont,
		TextSize = 28,
		Text = "— The Spirit Ledger —",
	})

	local close = Theme.button(b, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.new(0, 40, 0, 34),
		TextSize = 20,
		Text = "✕",
	})
	close.Activated:Connect(function()
		g.Enabled = false
	end)

	-- left page: spirits
	local left = Instance.new("ScrollingFrame")
	left.BackgroundTransparency = 1
	left.Position = UDim2.new(0, 14, 0, 50)
	left.Size = UDim2.new(0.5, -20, 1, -64)
	left.CanvasSize = UDim2.new(0, 0, 0, 0)
	left.AutomaticCanvasSize = Enum.AutomaticSize.Y
	left.ScrollBarThickness = 4
	left.Parent = b
	local leftLayout = Instance.new("UIListLayout")
	leftLayout.Padding = UDim.new(0, 8)
	leftLayout.Parent = left
	for _, spirit in Spirits.list do
		local entry = Instance.new("Frame")
		entry.BackgroundTransparency = 1
		entry.Size = UDim2.new(1, -8, 0, 88)
		entry.Parent = left
		Theme.label(entry, {
			Size = UDim2.new(1, 0, 0, 22),
			Font = Theme.TitleFont,
			TextSize = 21,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = spirit.name,
		})
		local codeRow = Instance.new("Frame")
		codeRow.BackgroundTransparency = 1
		codeRow.Position = UDim2.new(0, 0, 0, 24)
		codeRow.Size = UDim2.new(1, 0, 0, 34)
		codeRow.Parent = entry
		local rowLayout = Instance.new("UIListLayout")
		rowLayout.FillDirection = Enum.FillDirection.Horizontal
		rowLayout.Padding = UDim.new(0, 8)
		rowLayout.Parent = codeRow
		for _, glyphId in spirit.code do
			local cell = Instance.new("Frame")
			cell.Size = UDim2.new(0, 32, 0, 32)
			cell.BackgroundColor3 = Theme.BgSoft
			cell.BorderSizePixel = 0
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 6)
			corner.Parent = cell
			cell.Parent = codeRow
			local canvas = Instance.new("Frame")
			canvas.BackgroundTransparency = 1
			canvas.Size = UDim2.new(1, -6, 1, -6)
			canvas.Position = UDim2.new(0, 3, 0, 3)
			canvas.Parent = cell
			GlyphRender.render(glyphId, canvas)
		end
		Theme.label(entry, {
			Position = UDim2.new(0, 0, 0, 60),
			Size = UDim2.new(1, 0, 0, 26),
			TextSize = 13,
			TextColor3 = Theme.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = spirit.flavor,
		})
	end

	-- right page: slots + tray
	local right = Instance.new("Frame")
	right.BackgroundTransparency = 1
	right.Position = UDim2.new(0.5, 8, 0, 50)
	right.Size = UDim2.new(0.5, -22, 1, -64)
	right.Parent = b
	Theme.label(right, {
		Size = UDim2.new(1, 0, 0, 22),
		TextSize = 15,
		TextColor3 = Theme.Muted,
		Text = "Tap a found glyph, then tap a slot. Order matters.",
	})
	local slotRow = Instance.new("Frame")
	slotRow.BackgroundTransparency = 1
	slotRow.Position = UDim2.new(0, 0, 0, 30)
	slotRow.Size = UDim2.new(1, 0, 0, 92)
	slotRow.Parent = right
	local slotLayout = Instance.new("UIListLayout")
	slotLayout.FillDirection = Enum.FillDirection.Horizontal
	slotLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	slotLayout.Padding = UDim.new(0, 12)
	slotLayout.Parent = slotRow
	for i = 1, 3 do
		local slot = Instance.new("Frame")
		slot.Size = UDim2.new(0, 84, 0, 84)
		slot.BackgroundColor3 = Theme.BgSoft
		slot.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = slot
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Accent
		stroke.Transparency = 0.5
		stroke.Parent = slot
		slot.Parent = slotRow
		table.insert(slotFrames, slot)
		local button = Instance.new("TextButton")
		button.BackgroundTransparency = 1
		button.Size = UDim2.new(1, 0, 1, 0)
		button.Text = ""
		button.ZIndex = 5
		button.Parent = slot
		button.Activated:Connect(function()
			if selectedGlyph then
				Remotes.get(Remotes.Names.SlotGlyph):FireServer(i, selectedGlyph)
				selectedGlyph = nil
			elseif slots[i] then
				Remotes.get(Remotes.Names.SlotGlyph):FireServer(i, nil)
			end
		end)
	end

	matchBanner = Theme.label(right, {
		Position = UDim2.new(0, 0, 0, 128),
		Size = UDim2.new(1, 0, 0, 26),
		Font = Theme.TitleFont,
		TextSize = 22,
		Text = "no match yet…",
		TextColor3 = Theme.Muted,
	})

	Theme.label(right, {
		Position = UDim2.new(0, 0, 0, 160),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 14,
		TextColor3 = Theme.Muted,
		Text = "Found glyphs:",
	})
	local tray = Instance.new("Frame")
	tray.BackgroundTransparency = 1
	tray.Position = UDim2.new(0, 0, 0, 184)
	tray.Size = UDim2.new(1, 0, 1, -184)
	tray.Parent = right
	local trayLayout = Instance.new("UIGridLayout")
	trayLayout.CellSize = UDim2.new(0, 62, 0, 62)
	trayLayout.CellPadding = UDim2.new(0, 8, 0, 8)
	trayLayout.Parent = tray
	trayFrame = tray

	refreshSlots()
end

function LedgerUI.init()
	buildBook()

	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if player ~= Players.LocalPlayer then
			return
		end
		local parent = prompt.Parent
		local desk = parent and parent:FindFirstAncestorOfClass("Model")
		-- the ledger prompt sits on the book part; identify by tag on the desk or the prompt's ObjectText
		if prompt.ObjectText == "Spirit Ledger" and gui then
			gui.Enabled = true
		end
		local _ = desk
		local _2 = CollectionService
	end)

	Remotes.get(Remotes.Names.GlyphFound).OnClientEvent:Connect(function(_glyphId: any, data: any)
		if typeof(data) ~= "table" then
			return
		end
		if typeof(data.found) == "table" then
			found = data.found
		end
		if typeof(data.slots) == "table" then
			slots = {}
			for i = 1, 3 do
				local v = data.slots[i]
				slots[i] = if typeof(v) == "string" then v else nil
			end
		end
		refreshTray()
		refreshSlots()
	end)

	-- close the book when a shift ends
	Remotes.get(Remotes.Names.StateChanged).OnClientEvent:Connect(function(state: any)
		if (state == "LobbyIdle" or state == "RunEnd") and gui then
			gui.Enabled = false
		end
	end)
end

local _ = Glyphs -- glyph defs consumed via GlyphRender

return LedgerUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">MinigameController</string>
              <string name="Source"><![CDATA[--!strict
-- The four care minigames. Touch-first, bottom-anchored, driven by MinigameStart/Done/Cancel.
-- Failure inside the lock window just retries — TIME is the cost (Presence keeps filling).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local CareSteps = require(Shared:WaitForChild("Defs"):WaitForChild("CareSteps")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local MinigameController = {}

local gui: ScreenGui? = nil
local activePanel: Frame? = nil
local activeKey: string? = nil -- dollId..stepId
local heartbeat: RBXScriptConnection? = nil

local function closePanel()
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	if activePanel then
		activePanel:Destroy()
		activePanel = nil
	end
	activeKey = nil
end

local function finish(dollId: string, stepId: string, success: boolean)
	if activeKey ~= dollId .. stepId then
		return
	end
	if success then
		SoundKit.play("StepDone")
	end
	Remotes.get(Remotes.Names.MinigameDone):FireServer(dollId, stepId, success)
	closePanel()
end

local function makePanel(title: string, subtitle: string): (Frame, Frame)
	local g = gui
	assert(g, "gui missing")
	local panel = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.new(0, 480, 0, 300),
		BackgroundTransparency = 0.06,
	})
	Theme.label(panel, {
		Position = UDim2.new(0, 0, 0, 10),
		Size = UDim2.new(1, 0, 0, 34),
		Font = Theme.TitleFont,
		TextSize = 28,
		Text = title,
	})
	Theme.label(panel, {
		Position = UDim2.new(0, 0, 0, 44),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 15,
		TextColor3 = Theme.Muted,
		Text = subtitle,
	})
	local arena = Instance.new("Frame")
	arena.BackgroundTransparency = 1
	arena.Position = UDim2.new(0, 16, 0, 70)
	arena.Size = UDim2.new(1, -32, 1, -86)
	arena.Parent = panel
	activePanel = panel
	return panel, arena
end

local function progressBar(panel: Frame): (Frame, (n: number) -> ())
	local barBg = Instance.new("Frame")
	barBg.AnchorPoint = Vector2.new(0.5, 1)
	barBg.Position = UDim2.new(0.5, 0, 1, -8)
	barBg.Size = UDim2.new(1, -32, 0, 10)
	barBg.BackgroundColor3 = Theme.BgSoft
	barBg.BorderSizePixel = 0
	barBg.Parent = panel
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = barBg
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Theme.Gold
	fill.BorderSizePixel = 0
	fill.Parent = barBg
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(1, 0)
	fc.Parent = fill
	return barBg, function(n: number)
		fill.Size = UDim2.new(math.clamp(n, 0, 1), 0, 1, 0)
	end
end

-- ---------- minigames ----------

local function mashGame(dollId: string, stepId: string)
	local panel, arena = makePanel("Brush the Hair", "Tap the brush — smooth every tangle!")
	local _, setProgress = progressBar(panel)
	local progress = 0
	local button = Theme.button(arena, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 160, 0, 120),
		TextSize = 40,
		Text = "🪮",
	})
	button.Activated:Connect(function()
		SoundKit.play("BrushStroke")
		progress += 0.09
		setProgress(progress)
		button.Rotation = (math.random() - 0.5) * 20
		if progress >= 1 then
			finish(dollId, stepId, true)
		end
	end)
end

local function holdGame(dollId: string, stepId: string, title: string, subtitle: string)
	local panel, arena = makePanel(title, subtitle)
	local _, setProgress = progressBar(panel)
	local progress = 0
	local holding = false
	local circle = Theme.button(arena, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 130, 0, 130),
		TextSize = 20,
		Text = "HOLD",
	})
	local corner = circle:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(1, 0)
	end
	circle.MouseButton1Down:Connect(function()
		holding = true
	end)
	circle.MouseButton1Up:Connect(function()
		holding = false
	end)
	local t = 0
	heartbeat = RunService.Heartbeat:Connect(function(dt: number)
		t += dt
		-- circle drifts slowly; player must keep the press
		circle.Position = UDim2.new(0.5 + math.sin(t * 0.7) * 0.22, 0, 0.5 + math.cos(t * 0.9) * 0.14, 0)
		if holding then
			progress += dt / 4
			setProgress(progress)
			if progress >= 1 then
				finish(dollId, stepId, true)
			end
		end
	end)
end

local function sequenceGame(dollId: string, stepId: string, seed: number)
	local panel, arena = makePanel("Paint the Face", "Tap the paint dots IN ORDER — 1, 2, 3, 4, 5.")
	local _, setProgress = progressBar(panel)
	local rng = Random.new(seed)
	local expected = 1
	for i = 1, 5 do
		local dot = Theme.button(arena, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.12 + rng:NextNumber() * 0.76, 0, 0.15 + rng:NextNumber() * 0.7, 0),
			Size = UDim2.new(0, 64, 0, 64),
			TextSize = 26,
			Text = tostring(i),
		})
		local corner = dot:FindFirstChildOfClass("UICorner")
		if corner then
			corner.CornerRadius = UDim.new(1, 0)
		end
		dot.Activated:Connect(function()
			if i == expected then
				expected += 1
				dot.Visible = false
				setProgress((expected - 1) / 5)
				SoundKit.play("UiClick")
				if expected > 5 then
					finish(dollId, stepId, true)
				end
			else
				-- wrong tap: reset order (retry within the lock window)
				expected = 1
				setProgress(0)
				for _, child in arena:GetChildren() do
					if child:IsA("TextButton") then
						child.Visible = true
					end
				end
			end
		end)
	end
	local _ = panel
end

local function timingGame(dollId: string, stepId: string)
	local panel, arena = makePanel("Button the Coat", "Tap when the needle is in the GOLD zone. 3 buttons.")
	local _, setProgress = progressBar(panel)
	local hits = 0
	local zoneWidth = 0.3
	local track = Instance.new("Frame")
	track.AnchorPoint = Vector2.new(0.5, 0.5)
	track.Position = UDim2.new(0.5, 0, 0.35, 0)
	track.Size = UDim2.new(0.9, 0, 0, 22)
	track.BackgroundColor3 = Theme.BgSoft
	track.BorderSizePixel = 0
	track.Parent = arena
	local zone = Instance.new("Frame")
	zone.BackgroundColor3 = Theme.Gold
	zone.BackgroundTransparency = 0.4
	zone.BorderSizePixel = 0
	zone.Parent = track
	local needle = Instance.new("Frame")
	needle.Size = UDim2.new(0, 4, 1.6, 0)
	needle.AnchorPoint = Vector2.new(0.5, 0.2)
	needle.BackgroundColor3 = Theme.Parchment
	needle.BorderSizePixel = 0
	needle.Parent = track
	local function rollZone()
		zone.Size = UDim2.new(zoneWidth, 0, 1, 0)
		zone.Position = UDim2.new(math.random() * (1 - zoneWidth), 0, 0, 0)
	end
	rollZone()
	local t = 0
	heartbeat = RunService.Heartbeat:Connect(function(dt: number)
		t += dt
		local x = (math.sin(t * 2.2) + 1) / 2
		needle.Position = UDim2.new(x, 0, 0, 0)
	end)
	local tapButton = Theme.button(arena, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.75, 0),
		Size = UDim2.new(0, 180, 0, 70),
		TextSize = 24,
		Text = "BUTTON IT",
	})
	tapButton.Activated:Connect(function()
		local x = needle.Position.X.Scale
		local z0 = zone.Position.X.Scale
		if x >= z0 and x <= z0 + zoneWidth then
			hits += 1
			setProgress(hits / 3)
			SoundKit.play("UiConfirm")
			zoneWidth = math.max(0.12, zoneWidth - 0.08)
			rollZone()
			if hits >= 3 then
				finish(dollId, stepId, true)
			end
		end
	end)
end

-- ---------- wiring ----------

function MinigameController.init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainMinigames", 10)
	g.Parent = playerGui
	gui = g

	Remotes.get(Remotes.Names.MinigameStart).OnClientEvent:Connect(function(dollId: any, stepId: any, seed: any)
		if typeof(dollId) ~= "string" or typeof(stepId) ~= "string" then
			return
		end
		closePanel()
		activeKey = dollId .. stepId
		local step = CareSteps.byId[stepId]
		local kind = step and step.minigame or "mash"
		if kind == "mash" then
			mashGame(dollId, stepId)
		elseif kind == "hold" then
			if stepId == "Eyes" then
				holdGame(dollId, stepId, "Polish the Eyes", "Hold the cloth steady — follow it as it drifts.")
			else
				holdGame(dollId, stepId, "Wind the Music Box", "Hold the crank — don't let go until it sings.")
			end
		elseif kind == "sequence" then
			sequenceGame(dollId, stepId, if typeof(seed) == "number" then seed else 1)
		elseif kind == "timing" then
			timingGame(dollId, stepId)
		end
		-- client-side watchdog mirror (R2): close a bit after the server lock expires
		task.delay(Config.Care.MinigameSeconds + 2, function()
			if activeKey == dollId .. stepId then
				closePanel()
			end
		end)
	end)

	Remotes.get(Remotes.Names.MinigameCancel).OnClientEvent:Connect(function(dollId: any, stepId: any)
		if typeof(dollId) == "string" and typeof(stepId) == "string" and activeKey == dollId .. stepId then
			closePanel()
		end
	end)
end

return MinigameController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">NamingUI</string>
              <string name="Source"><![CDATA[--!strict
-- Doll naming: compact top-half picker, once per doll, on the local player's first completed step.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local DollNames = require(Shared:WaitForChild("Defs"):WaitForChild("DollNames")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local NamingUI = {}

local gui: ScreenGui? = nil
local panel: Frame? = nil
local offeredFor: { [string]: boolean } = {}
local currentDollId: string? = nil

local function close()
	if panel then
		panel:Destroy()
		panel = nil
	end
	currentDollId = nil
end

local function offer(dollId: string)
	if panel then
		return
	end
	currentDollId = dollId
	local g = gui
	assert(g)
	local p = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 120),
		Size = UDim2.new(0, 460, 0, 220),
		BackgroundTransparency = 0.06,
	})
	panel = p
	Theme.label(p, {
		Position = UDim2.new(0, 0, 0, 10),
		Size = UDim2.new(1, 0, 0, 28),
		Font = Theme.TitleFont,
		TextSize = 24,
		Text = "Name this doll?",
	})
	local grid = Instance.new("Frame")
	grid.BackgroundTransparency = 1
	grid.Position = UDim2.new(0, 14, 0, 46)
	grid.Size = UDim2.new(1, -28, 0, 118)
	grid.Parent = p
	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.new(0.333, -8, 0, 52)
	layout.CellPadding = UDim2.new(0, 8, 0, 8)
	layout.Parent = grid

	local function fillNames()
		for _, child in grid:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		local picked: { [number]: boolean } = {}
		while true do
			local count = 0
			for _ in picked do
				count += 1
			end
			if count >= 6 then
				break
			end
			picked[math.random(1, #DollNames)] = true
		end
		for index in picked do
			local button = Theme.button(grid, {
				TextSize = 18,
				Text = DollNames[index],
			})
			button.Activated:Connect(function()
				local id = currentDollId
				if id then
					SoundKit.play("UiConfirm")
					Remotes.get(Remotes.Names.ChooseName):FireServer(id, index)
				end
				close()
			end)
		end
	end
	fillNames()

	local shuffle = Theme.button(p, {
		Position = UDim2.new(0, 14, 1, -46),
		Size = UDim2.new(0.5, -22, 0, 36),
		TextSize = 17,
		Text = "↻ other names",
	})
	shuffle.Activated:Connect(fillNames)
	local skip = Theme.button(p, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 1, -46),
		Size = UDim2.new(0.5, -22, 0, 36),
		TextSize = 17,
		Text = "keep current name",
	})
	skip.Activated:Connect(close)

	-- never block the loop: auto-dismiss (R2)
	task.delay(15, function()
		if currentDollId == dollId then
			close()
		end
	end)
end

function NamingUI.init()
	if not Config.Features.Naming then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainNaming", 11)
	g.Parent = playerGui
	gui = g

	-- offer naming when the local player finishes their first minigame on a doll:
	-- MinigameStart implies this player is working that doll; offer after the step completes (DollUpdate).
	local workingDoll: string? = nil
	Remotes.get(Remotes.Names.MinigameStart).OnClientEvent:Connect(function(dollId: any)
		if typeof(dollId) == "string" then
			workingDoll = dollId
		end
	end)
	Remotes.get(Remotes.Names.DollUpdate).OnClientEvent:Connect(function(dollId: any, update: any)
		if typeof(dollId) ~= "string" or typeof(update) ~= "table" then
			return
		end
		if update.careDone and dollId == workingDoll and not offeredFor[dollId] then
			offeredFor[dollId] = true
			offer(dollId)
		end
	end)
	Remotes.get(Remotes.Names.StateChanged).OnClientEvent:Connect(function(state: any)
		if state == "LobbyIdle" or state == "RunEnd" then
			offeredFor = {}
			close()
		end
	end)
end

return NamingUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">PanicEmote</string>
              <string name="Source"><![CDATA[--!strict
-- Panic emote: corner button + E key. The characters scream so the players don't have to.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local PanicEmote = {}

local cooldownUntil = 0

local function panic()
	local now = os.clock()
	if now < cooldownUntil then
		return
	end
	cooldownUntil = now + 3
	local player = Players.LocalPlayer
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	SoundKit.play("PanicBark", head)
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Jump = true
	end
	-- local "!!" billboard (local-only stub for the beta)
	if head and head:IsA("BasePart") then
		local billboard = Instance.new("BillboardGui")
		billboard.Adornee = head
		billboard.Size = UDim2.new(0, 60, 0, 40)
		billboard.StudsOffset = Vector3.new(0, 3.4, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = head
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = Theme.Danger
		label.Text = "!!"
		label.Parent = billboard
		task.delay(2, function()
			billboard:Destroy()
		end)
	end
	-- tiny camera pop
	local camera = workspace.CurrentCamera
	if camera then
		task.spawn(function()
			for _ = 1, 6 do
				camera.CFrame = camera.CFrame * CFrame.new((math.random() - 0.5) * 0.15, (math.random() - 0.5) * 0.15, 0)
				task.wait(0.03)
			end
		end)
	end
end

function PanicEmote.init()
	if not Config.Features.PanicEmote then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Theme.screenGui("PorcelainPanic", 8)
	gui.Parent = playerGui
	local button = Theme.button(gui, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -14, 1, -90),
		Size = UDim2.new(0, 68, 0, 68),
		TextSize = 30,
		Text = "😱",
	})
	local corner = button:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(1, 0)
	end
	button.Activated:Connect(panic)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.E then
			panic()
		end
	end)
end

return PanicEmote
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">PresenceClient</string>
              <string name="Source"><![CDATA[--!strict
-- Diegetic Presence rendering: LOCAL lighting shifts + lamp flicker + ambience layers by tier.

local Lighting = game:GetService("Lighting")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any

local PresenceClient = {}

local tier = 0
local ambienceBase: Sound? = nil
local ambienceT2: Sound? = nil
local ambienceT3: Sound? = nil

local TIER_AMBIENT = {
	[0] = Color3.fromRGB(27, 23, 31),
	[1] = Color3.fromRGB(24, 20, 30),
	[2] = Color3.fromRGB(20, 22, 24),
	[3] = Color3.fromRGB(16, 24, 18),
}

local function applyTier()
	local target = TIER_AMBIENT[tier] or TIER_AMBIENT[0]
	TweenService:Create(Lighting, TweenInfo.new(3), {
		Ambient = target,
		OutdoorAmbient = target,
	}):Play()
	local function setVolume(sound: Sound?, on: boolean, volume: number)
		if sound then
			TweenService:Create(sound, TweenInfo.new(2), { Volume = if on then volume else 0 }):Play()
		end
	end
	setVolume(ambienceT2, tier >= 2, 0.3)
	setVolume(ambienceT3, tier >= 3, 0.35)
end

local function flickerLoop()
	task.spawn(function()
		while true do
			local interval = if tier >= 3 then 0.8 elseif tier == 2 then 2 elseif tier == 1 then 5 else 12
			task.wait(interval + math.random() * interval)
			if tier < 1 then
				continue
			end
			-- flicker a random lamp locally
			local lamps = CollectionService:GetTagged("Lamp")
			if #lamps == 0 then
				continue
			end
			local lamp = lamps[math.random(1, #lamps)]
			local light = lamp:FindFirstChildOfClass("PointLight")
			if light and light.Enabled then
				task.spawn(function()
					for _ = 1, math.random(2, 5) do
						light.Brightness = 0.2
						task.wait(0.05 + math.random() * 0.08)
						light.Brightness = 1.4
						task.wait(0.05 + math.random() * 0.1)
					end
				end)
			end
		end
	end)
end

function PresenceClient.init()
	ambienceBase = SoundKit.attach("AmbienceBase", SoundService)
	ambienceT2 = SoundKit.attach("AmbienceTier2", SoundService)
	ambienceT3 = SoundKit.attach("AmbienceTier3", SoundService)
	for _, sound in { ambienceBase, ambienceT2, ambienceT3 } do
		if sound then
			sound.Volume = if sound == ambienceBase then sound.Volume else 0
			sound:Play()
		end
	end

	Remotes.get(Remotes.Names.PresenceTier).OnClientEvent:Connect(function(newTier: any)
		if typeof(newTier) == "number" then
			tier = newTier
			applyTier()
		end
	end)

	flickerLoop()
end

return PresenceClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">RecapUI</string>
              <string name="Source"><![CDATA[--!strict
-- The staged banish-reveal beat + the end-of-run recap card.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local RecapUI = {}

local gui: ScreenGui? = nil

local function black(transparency: number): Frame
	local g = gui
	assert(g)
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = Color3.new(0, 0, 0)
	frame.BackgroundTransparency = transparency
	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.ZIndex = 2
	frame.Parent = g
	return frame
end

-- The reveal: black flash -> sting -> name-slam line
local function playReveal(data: any)
	local g = gui
	if not g then
		return
	end
	local flash = black(0)
	SoundKit.play(if data.correct then "StingReveal" else "StingWrong")
	local line = Theme.label(g, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.45, 0),
		Size = UDim2.new(0.9, 0, 0, 120),
		Font = Theme.TitleFont,
		TextSize = 12,
		TextColor3 = if data.correct then Theme.Gold else Theme.Sickly,
		TextStrokeTransparency = 0.3,
		ZIndex = 3,
		Text = if data.correct
			then ("%s WAS %s"):format(string.upper(data.dollName or "?"), string.upper(data.spiritName or "THE SPIRIT"))
			else ("%s WAS INNOCENT."):format(string.upper(data.dollName or "?")),
	})
	TweenService:Create(line, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { TextSize = 52 }):Play()
	task.delay(3, function()
		TweenService:Create(flash, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(line, TweenInfo.new(0.8), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.delay(0.9, function()
			flash:Destroy()
			line:Destroy()
		end)
	end)
end

local function showRecap(data: any)
	local g = gui
	if not g then
		return
	end
	local dim = black(0.35)
	local card = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 460, 0, 400),
		BackgroundTransparency = 0.02,
		ZIndex = 3,
	})
	Theme.label(card, {
		Position = UDim2.new(0, 0, 0, 14),
		Size = UDim2.new(1, 0, 0, 26),
		TextSize = 16,
		TextColor3 = Theme.Muted,
		Text = "THE NIGHT ENDS",
	})
	Theme.label(card, {
		Position = UDim2.new(0, 0, 0, 40),
		Size = UDim2.new(1, 0, 0, 110),
		Font = Theme.TitleFont,
		TextSize = 92,
		Text = ("SHIFT %d"):format(data.shiftReached or 0),
	})
	local statLines = {
		("Dolls cared for: %d"):format(data.dollsCleared or 0),
		("The traitor was %s."):format(data.traitorName or "…unknown"),
		("Best shift: %d"):format(data.bestShift or 0),
	}
	for i, text in statLines do
		Theme.label(card, {
			Position = UDim2.new(0, 0, 0, 150 + (i - 1) * 30),
			Size = UDim2.new(1, 0, 0, 26),
			Font = Theme.TitleFont,
			TextSize = 21,
			Text = text,
		})
	end
	if data.isNewBest then
		Theme.label(card, {
			Position = UDim2.new(0, 0, 0, 246),
			Size = UDim2.new(1, 0, 0, 34),
			Font = Theme.TitleFont,
			TextSize = 30,
			TextColor3 = Theme.Gold,
			Text = "✦ NEW BEST ✦",
		})
	end
	if data.perfect then
		Theme.label(card, {
			Position = UDim2.new(0, 0, 0, 278),
			Size = UDim2.new(1, 0, 0, 26),
			TextSize = 16,
			TextColor3 = Theme.Gold,
			Text = "Perfect shifts, zero strikes. The Dollmaker approves.",
		})
	end
	local button = Theme.button(card, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.new(0, 220, 0, 56),
		TextSize = 22,
		Text = "RETURN",
	})
	button.Activated:Connect(function()
		dim:Destroy()
		card:Destroy()
	end)
	task.delay(20, function()
		if dim.Parent then
			dim:Destroy()
			card:Destroy()
		end
	end)
end

function RecapUI.init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainRecap", 16)
	g.Parent = playerGui
	gui = g

	Remotes.get(Remotes.Names.BanishResult).OnClientEvent:Connect(function(data: any)
		if typeof(data) == "table" then
			playReveal(data)
		end
	end)
	Remotes.get(Remotes.Names.Recap).OnClientEvent:Connect(function(data: any)
		if typeof(data) == "table" then
			task.delay(1, function()
				showRecap(data)
			end)
		end
	end)
end

return RecapUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Toast</string>
              <string name="Source"><![CDATA[--!strict
-- Bottom-center transient message queue. Other controllers may require this for local toasts.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local Toast = {}

local gui: ScreenGui? = nil
local container: Frame? = nil

local function ensureGui()
	if gui and gui.Parent then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainToast", 20)
	g.Parent = playerGui
	local c = Instance.new("Frame")
	c.BackgroundTransparency = 1
	c.AnchorPoint = Vector2.new(0.5, 1)
	c.Position = UDim2.new(0.5, 0, 1, -110)
	c.Size = UDim2.new(0.7, 0, 0, 200)
	c.Parent = g
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Padding = UDim.new(0, 6)
	layout.Parent = c
	gui = g
	container = c
end

function Toast.show(message: string, seconds: number?)
	ensureGui()
	local c = container
	if not c then
		return
	end
	local panel = Theme.panel(c, {
		Size = UDim2.new(1, 0, 0, 44),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.25,
	})
	local label = Theme.label(panel, {
		Size = UDim2.new(1, -24, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Position = UDim2.new(0, 12, 0, 10),
		Font = Theme.TitleFont,
		TextSize = 22,
		Text = message,
	})
	local pad = Instance.new("UIPadding")
	pad.PaddingBottom = UDim.new(0, 10)
	pad.Parent = panel
	local _ = label
	task.delay(seconds or 4, function()
		TweenService:Create(panel, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
		for _, child in panel:GetDescendants() do
			if child:IsA("TextLabel") then
				TweenService:Create(child, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			end
		end
		task.delay(0.6, function()
			panel:Destroy()
		end)
	end)
end

function Toast.init()
	ensureGui()
	Remotes.get(Remotes.Names.Toast).OnClientEvent:Connect(function(message: any, seconds: any)
		if typeof(message) == "string" then
			Toast.show(message, if typeof(seconds) == "number" then seconds else nil)
		end
	end)
end

return Toast
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">Theme</string>
            <string name="Source"><![CDATA[--!strict
-- Client UI theme: horror-storybook. One place for colors/fonts + small constructors.

local Theme = {}

Theme.Bg = Color3.fromRGB(18, 14, 20)
Theme.BgSoft = Color3.fromRGB(28, 22, 32)
Theme.Parchment = Color3.fromRGB(230, 220, 200)
Theme.Muted = Color3.fromRGB(170, 155, 175)
Theme.Gold = Color3.fromRGB(212, 175, 96)
Theme.Sickly = Color3.fromRGB(120, 160, 90)
Theme.Danger = Color3.fromRGB(180, 70, 70)
Theme.Accent = Color3.fromRGB(150, 120, 220)

Theme.TitleFont = Enum.Font.Garamond
Theme.BodyFont = Enum.Font.Gotham

function Theme.screenGui(name: string, displayOrder: number?): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = displayOrder or 5
	return gui
end

function Theme.panel(parent: Instance, props: { [string]: any }): Frame
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = Theme.Bg
	frame.BackgroundTransparency = 0.08
	frame.BorderSizePixel = 0
	for k, v in props do
		(frame :: any)[k] = v
	end
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Muted
	stroke.Transparency = 0.65
	stroke.Thickness = 1
	stroke.Parent = frame
	frame.Parent = parent
	return frame
end

function Theme.label(parent: Instance, props: { [string]: any }): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Font = Theme.BodyFont
	label.TextColor3 = Theme.Parchment
	label.TextWrapped = true
	for k, v in props do
		(label :: any)[k] = v
	end
	label.Parent = parent
	return label
end

function Theme.button(parent: Instance, props: { [string]: any }): TextButton
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = Theme.BgSoft
	button.BorderSizePixel = 0
	button.Font = Theme.TitleFont
	button.TextColor3 = Theme.Parchment
	button.AutoButtonColor = true
	for k, v in props do
		(button :: any)[k] = v
	end
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Gold
	stroke.Transparency = 0.7
	stroke.Thickness = 1
	stroke.Parent = button
	button.Parent = parent
	return button
end

return Theme
]]></string>
          </Properties>
        </Item>
