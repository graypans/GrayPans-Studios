        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Glyphs</string>
            <string name="Source"><![CDATA[--!strict
-- Original cartoon glyph set (NO real occult symbols — policy-safe by design, MASTER.md 9.3).
-- Each glyph is drawn from primitive strokes so it can be rendered as SurfaceGui/ScreenGui Frames
-- with zero image assets. Coordinates are fractions of a square canvas (0..1), rotation in degrees.

export type Stroke = {
	x: number, -- center x (0..1)
	y: number, -- center y (0..1)
	w: number, -- width  (0..1)
	h: number, -- height (0..1)
	rot: number?, -- degrees
	round: boolean?, -- fully rounded corners (dot / ring segment look)
}

export type Glyph = {
	id: string,
	name: string,
	strokes: { Stroke },
}

local Glyphs: { Glyph } = {
	{
		id = "MoonHook",
		name = "Moon Hook",
		strokes = {
			{ x = 0.5, y = 0.25, w = 0.5, h = 0.1, rot = 0, round = true },
			{ x = 0.3, y = 0.5, w = 0.1, h = 0.5, rot = 15, round = true },
			{ x = 0.62, y = 0.72, w = 0.28, h = 0.1, rot = -30, round = true },
		},
	},
	{
		id = "TripleTear",
		name = "Triple Tear",
		strokes = {
			{ x = 0.3, y = 0.35, w = 0.12, h = 0.12, round = true },
			{ x = 0.55, y = 0.5, w = 0.12, h = 0.12, round = true },
			{ x = 0.4, y = 0.7, w = 0.12, h = 0.12, round = true },
			{ x = 0.5, y = 0.5, w = 0.66, h = 0.06, rot = 45, round = true },
		},
	},
	{
		id = "CrookedWindow",
		name = "Crooked Window",
		strokes = {
			{ x = 0.5, y = 0.28, w = 0.5, h = 0.08, rot = 8 },
			{ x = 0.5, y = 0.72, w = 0.5, h = 0.08, rot = -8 },
			{ x = 0.28, y = 0.5, w = 0.08, h = 0.5, rot = -8 },
			{ x = 0.72, y = 0.5, w = 0.08, h = 0.5, rot = 8 },
			{ x = 0.5, y = 0.5, w = 0.08, h = 0.4, rot = 20 },
		},
	},
	{
		id = "StitchedHeart",
		name = "Stitched Heart",
		strokes = {
			{ x = 0.38, y = 0.36, w = 0.22, h = 0.22, round = true },
			{ x = 0.62, y = 0.36, w = 0.22, h = 0.22, round = true },
			{ x = 0.5, y = 0.6, w = 0.36, h = 0.3, rot = 45 },
			{ x = 0.5, y = 0.48, w = 0.5, h = 0.05, rot = 12, round = true },
		},
	},
	{
		id = "BentKey",
		name = "Bent Key",
		strokes = {
			{ x = 0.35, y = 0.32, w = 0.2, h = 0.2, round = true },
			{ x = 0.35, y = 0.34, w = 0.09, h = 0.09, round = true },
			{ x = 0.5, y = 0.58, w = 0.09, h = 0.4, rot = -18, round = true },
			{ x = 0.68, y = 0.74, w = 0.2, h = 0.08, rot = 0, round = true },
			{ x = 0.62, y = 0.84, w = 0.12, h = 0.08, rot = 0, round = true },
		},
	},
	{
		id = "HollowStar",
		name = "Hollow Star",
		strokes = {
			{ x = 0.5, y = 0.5, w = 0.55, h = 0.08, rot = 0, round = true },
			{ x = 0.5, y = 0.5, w = 0.55, h = 0.08, rot = 60, round = true },
			{ x = 0.5, y = 0.5, w = 0.55, h = 0.08, rot = 120, round = true },
			{ x = 0.5, y = 0.5, w = 0.14, h = 0.14, round = true },
		},
	},
	{
		id = "SleepingEye",
		name = "Sleeping Eye",
		strokes = {
			{ x = 0.5, y = 0.5, w = 0.6, h = 0.09, rot = 0, round = true },
			{ x = 0.3, y = 0.62, w = 0.09, h = 0.2, rot = 30, round = true },
			{ x = 0.5, y = 0.66, w = 0.09, h = 0.2, rot = 0, round = true },
			{ x = 0.7, y = 0.62, w = 0.09, h = 0.2, rot = -30, round = true },
		},
	},
	{
		id = "RibbonCoil",
		name = "Ribbon Coil",
		strokes = {
			{ x = 0.5, y = 0.3, w = 0.44, h = 0.09, rot = -20, round = true },
			{ x = 0.5, y = 0.5, w = 0.44, h = 0.09, rot = 20, round = true },
			{ x = 0.5, y = 0.7, w = 0.44, h = 0.09, rot = -20, round = true },
		},
	},
}

local byId: { [string]: Glyph } = {}
for _, glyph in Glyphs do
	byId[glyph.id] = glyph
end

return {
	list = Glyphs,
	byId = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">Haunts</string>
            <string name="Source"><![CDATA[--!strict
-- Haunt event pool. tier = minimum Presence tier (1..3) before the event can draw.
-- weight = relative draw chance. cooldown = seconds before the same event may repeat.
-- Every event has BOTH a sound slot and a visual so the beta reads fully muted (audio ships ID=0).
-- Implementations live server-side (world changes) + client-side (camera/screen effects), keyed by id.

export type HauntDef = {
	id: string,
	tier: number,
	weight: number,
	cooldown: number,
	scope: "world" | "client", -- world = server manipulates instances; client = per-client screen/camera effect
}

local Haunts: { HauntDef } = {
	{ id = "BenchRattle", tier = 1, weight = 10, cooldown = 40, scope = "world" },
	{ id = "DoorCreakSlam", tier = 1, weight = 8, cooldown = 50, scope = "world" },
	{ id = "MusicBoxSwell", tier = 1, weight = 8, cooldown = 60, scope = "world" },
	{ id = "WhisperPass", tier = 2, weight = 8, cooldown = 45, scope = "client" },
	{ id = "SilhouetteDoorway", tier = 2, weight = 7, cooldown = 70, scope = "world" },
	{ id = "WindowFigure", tier = 2, weight = 6, cooldown = 80, scope = "world" },
	{ id = "DollHeadSnap", tier = 2, weight = 9, cooldown = 45, scope = "world" },
	{ id = "LightsOutBeat", tier = 3, weight = 7, cooldown = 90, scope = "world" },
	{ id = "Taken", tier = 3, weight = 4, cooldown = 180, scope = "client" }, -- stub; off by default (Config)
}

local byId: { [string]: HauntDef } = {}
for _, h in Haunts do
	byId[h.id] = h
end

return {
	list = Haunts,
	byId = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[--!strict
-- The Dollmaker's Journal: quest/checklist roster. Data only -- no game references, mirrors the
-- shape of Defs/CareSteps.luau and Defs/Spirits.luau (list + byId). Progress math lives in
-- Logic/QuestProgress.luau so both QuestService (server) and Journal (client) share one
-- implementation, the same split used for GlyphMatch/LedgerUI.

export type GoalType = "DollsCleared" | "ShiftsSurvived" | "FirstTryBanishes" | "RibbonsTied" | "Flag"

export type Quest = {
	id: string,
	title: string,
	description: string,
	goalType: GoalType,
	target: number,
	coinReward: number,
	category: "Milestone" | "EasterEgg",
	hidden: boolean?, -- true = Journal UI shows "???" until DataService stats.questFlags[id] is true
}

local Quests: { Quest } = {
	{
		id = "DollsTen",
		title = "Gentle Hands",
		description = "Finish caring for 10 dolls, across as many shifts as it takes.",
		goalType = "DollsCleared",
		target = 10,
		coinReward = 15,
		category = "Milestone",
	},
	{
		id = "DollsFifty",
		title = "Steady Hands",
		description = "Finish caring for 50 dolls in total. The Dollmaker is starting to notice.",
		goalType = "DollsCleared",
		target = 50,
		coinReward = 60,
		category = "Milestone",
	},
	{
		id = "DollsHundred",
		title = "The Dollmaker's Favorite",
		description = "Finish caring for 100 dolls in total. Nobody else lasts this long.",
		goalType = "DollsCleared",
		target = 100,
		coinReward = 150,
		category = "Milestone",
	},
	{
		id = "ShiftFive",
		title = "Steady Nerves",
		description = "Survive all the way to Shift 5.",
		goalType = "ShiftsSurvived",
		target = 5,
		coinReward = 40,
		category = "Milestone",
	},
	{
		id = "ShiftTen",
		title = "Old Hand",
		description = "Survive all the way to Shift 10. The workshop feels almost familiar now.",
		goalType = "ShiftsSurvived",
		target = 10,
		coinReward = 100,
		category = "Milestone",
	},
	{
		id = "FirstTryFive",
		title = "Sharp Eyes",
		description = "Banish the right one on your very first guess, 5 times total.",
		goalType = "FirstTryBanishes",
		target = 5,
		coinReward = 50,
		category = "Milestone",
	},
	{
		id = "RibbonsTwentyFive",
		title = "Silver Fingers",
		description = "Tie the silver ribbon 25 times in total. Never skip it. Always. — The Dollmaker",
		goalType = "RibbonsTied",
		target = 25,
		coinReward = 45,
		category = "Milestone",
	},
	{
		id = "EggFloorboard",
		title = "Under the Floorboard",
		description = "Something was hidden beneath the lobby floor. You found it.",
		goalType = "Flag",
		target = 1,
		coinReward = 20,
		category = "EasterEgg",
		hidden = true,
	},
	{
		id = "EggNote",
		title = "The Dollmaker's Handwriting",
		description = "You found a note in handwriting that isn't yours. It knew you'd look.",
		goalType = "Flag",
		target = 1,
		coinReward = 20,
		category = "EasterEgg",
		hidden = true,
	},
	{
		id = "EggStillness",
		title = "Don't Move",
		description = "You stood somewhere you shouldn't have, and stayed there. Something noticed.",
		goalType = "Flag",
		target = 1,
		coinReward = 25,
		category = "EasterEgg",
		hidden = true,
	},
}

local byId: { [string]: Quest } = {}
for _, quest in Quests do
	byId[quest.id] = quest
end

return {
	list = Quests,
	byId = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Spirits</string>
            <string name="Source"><![CDATA[--!strict
-- The six spirits of the beta (12 planned; content lever per MASTER.md 9.3).
-- Each spirit's code is an ORDERED sequence of 3 glyph ids (order matters, like the original's sigil matching).

export type Spirit = {
	id: string,
	name: string,
	code: { string }, -- ordered glyph ids, length 3
	flavor: string, -- one line in the ledger, readable by kids, adds lore
}

local Spirits: { Spirit } = {
	{
		id = "Hollow",
		name = "The Hollow One",
		code = { "SleepingEye", "MoonHook", "HollowStar" },
		flavor = "It wears what it empties. Check the eyes; the eyes are honest.",
	},
	{
		id = "Latch",
		name = "Old Latch",
		code = { "BentKey", "CrookedWindow", "TripleTear" },
		flavor = "It never uses doors. It IS doors.",
	},
	{
		id = "Thimble",
		name = "Little Thimble",
		code = { "StitchedHeart", "RibbonCoil", "SleepingEye" },
		flavor = "It sews itself in. Look for the extra stitch.",
	},
	{
		id = "Waltz",
		name = "The Midnight Waltz",
		code = { "MoonHook", "TripleTear", "SleepingEye" },
		flavor = "If the music box plays with no hand on the crank, count the dolls twice.",
	},
	{
		id = "Wick",
		name = "Sister Wick",
		code = { "HollowStar", "StitchedHeart", "BentKey" },
		flavor = "It drinks light. Lamps gutter where it sleeps.",
	},
	{
		id = "Patch",
		name = "Grandfather Patch",
		code = { "RibbonCoil", "CrookedWindow", "HollowStar" },
		flavor = "The oldest one. The ribbon remembers him, so tie it well.",
	},
}

local byId: { [string]: Spirit } = {}
for _, spirit in Spirits do
	byId[spirit.id] = spirit
end

return {
	list = Spirits,
	byId = byId,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Tells</string>
            <string name="Source"><![CDATA[--!strict
-- Tell types. Real tells fire on the marked doll; fake tells fire on innocents (framing).
-- unwatchedOnly tells require the doll to be unseen by any validated camera (Weeping Angels rule).
-- Every audio-flavored tell has a visual co-cue (audio ships silent).

export type TellDef = {
	id: string,
	weight: number,
	unwatchedOnly: boolean,
	fakeable: boolean, -- can the Presence fake this on an innocent doll?
	description: string, -- shown in the debug overlay / ledger lore page
}

local Tells: { TellDef } = {
	{
		id = "HeadTurn",
		weight = 10,
		unwatchedOnly = false,
		fakeable = true,
		description = "Its head turns a little toward you.",
	},
	{
		id = "EyesFollow",
		weight = 9,
		unwatchedOnly = false,
		fakeable = true,
		description = "The eyes track the nearest player for a few seconds.",
	},
	{
		id = "Scoot",
		weight = 8,
		unwatchedOnly = true,
		fakeable = true,
		description = "It is not where it was. Nobody saw it move.",
	},
	{
		id = "MusicBoxTurn",
		weight = 6,
		unwatchedOnly = false,
		fakeable = true,
		description = "Its music box crank turns by itself (the crank visibly rotates).",
	},
	{
		id = "Slump",
		weight = 7,
		unwatchedOnly = true,
		fakeable = true,
		description = "Its posture changed — slumped, or sat up straighter.",
	},
	{
		id = "StitchMark",
		weight = 4,
		unwatchedOnly = true,
		fakeable = false, -- marks never lie, but they are slow to appear (strong evidence, late)
		description = "A new crooked stitch mark appears on its arm (real dolls only).",
	},
}

local byId: { [string]: TellDef } = {}
for _, t in Tells do
	byId[t.id] = t
end

return {
	list = Tells,
	byId = byId,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">GlyphRender</string>
          <string name="Source"><![CDATA[--!strict
-- Draws a glyph (Defs/Glyphs stroke data) as Frames inside any GuiObject. Zero image assets.

local Glyphs = require(script.Parent.Defs.Glyphs)

local GlyphRender = {}

function GlyphRender.render(glyphId: string, parent: GuiObject, color: Color3?)
	local glyph = (Glyphs :: any).byId[glyphId]
	if not glyph then
		return
	end
	local tint = color or Color3.fromRGB(200, 180, 230)
	for _, stroke in glyph.strokes do
		local frame = Instance.new("Frame")
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(stroke.x, stroke.y)
		frame.Size = UDim2.fromScale(stroke.w, stroke.h)
		frame.Rotation = stroke.rot or 0
		frame.BackgroundColor3 = tint
		frame.BorderSizePixel = 0
		if stroke.round then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(1, 0)
			corner.Parent = frame
		end
		frame.Parent = parent
	end
end

function GlyphRender.clear(parent: GuiObject)
	for _, child in parent:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
end

return GlyphRender
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="15">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Draw</string>
            <string name="Source"><![CDATA[--!strict
-- Pure logic: seeded weighted draws for tells/haunts (no `game` references — unit-tested).
-- Deterministic given a Random object, so schedules are reproducible in tests.

export type Weighted = { id: string, weight: number }

-- Structural rng type: satisfied by Roblox's Random and by test mocks (keeps this module CLI-testable)
export type RngLike = {
	NextNumber: (self: RngLike) -> number,
	NextInteger: (self: RngLike, min: number, max: number) -> number,
}

local Draw = {}

-- Weighted pick from candidates; returns nil for an empty/zero-weight pool.
function Draw.weighted(rng: RngLike, candidates: { Weighted }): string?
	local total = 0
	for _, c in candidates do
		if c.weight > 0 then
			total += c.weight
		end
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	local acc = 0
	for _, c in candidates do
		if c.weight > 0 then
			acc += c.weight
			if roll <= acc then
				return c.id
			end
		end
	end
	return candidates[#candidates].id
end

-- Pick n distinct entries from list (uniform, seeded). Returns fewer if list is short.
function Draw.sample<T>(rng: RngLike, list: { T }, n: number): { T }
	local pool = table.clone(list)
	local out: { T } = {}
	for _ = 1, math.min(n, #pool) do
		local i = rng:NextInteger(1, #pool)
		table.insert(out, pool[i])
		table.remove(pool, i)
	end
	return out
end

-- Uniform pick
function Draw.one<T>(rng: RngLike, list: { T }): T?
	if #list == 0 then
		return nil
	end
	return list[rng:NextInteger(1, #list)]
end

return Draw
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Escalation</string>
            <string name="Source"><![CDATA[--!strict
-- Pure logic: per-shift difficulty derivation (no `game` references — unit-tested).

export type ShiftParams = {
	dollCount: number,
	fakeTellChance: number, -- 0..1 per tell window
	presenceRateMultiplier: number,
	tellIntervalMin: number,
	tellIntervalMax: number,
	glyphCount: number,
}

export type EscalationConfig = {
	BaseDollCount: number,
	SoloDollCap: number,
	MaxDollCount: number,
	DollCountShiftMilestones: { number },
	BaseFakeTellChance: number,
	BaseTellIntervalMin: number,
	BaseTellIntervalMax: number,
	GlyphsPerShift: number,
}

local Escalation = {}

function Escalation.forShift(cfg: EscalationConfig, shiftNumber: number, playerCount: number): ShiftParams
	assert(shiftNumber >= 1, "shiftNumber must be >= 1")
	assert(playerCount >= 1, "playerCount must be >= 1")

	local dollCount = cfg.BaseDollCount
	for _, milestone in cfg.DollCountShiftMilestones do
		if shiftNumber >= milestone then
			dollCount += 1
		end
	end
	dollCount = math.min(dollCount, cfg.MaxDollCount)
	if playerCount == 1 then
		-- R1/solo cap: escalation continues through tells + meter only (plan review fix)
		dollCount = math.min(dollCount, cfg.SoloDollCap)
	end

	-- Fake tells ramp: +6% per shift, capped at 75%
	local fakeTellChance = math.min(cfg.BaseFakeTellChance + 0.06 * (shiftNumber - 1), 0.75)

	-- Presence fills faster each shift: +8% per shift, capped at 3x; solo gets a 25% slower meter
	local presenceMultiplier = math.min(1 + 0.08 * (shiftNumber - 1), 3)
	if playerCount == 1 then
		presenceMultiplier *= 0.75
	end

	-- Real tells get subtler (less frequent) as shifts climb: interval stretches up to +50%
	local stretch = math.min(1 + 0.05 * (shiftNumber - 1), 1.5)

	return {
		dollCount = dollCount,
		fakeTellChance = fakeTellChance,
		presenceRateMultiplier = presenceMultiplier,
		tellIntervalMin = cfg.BaseTellIntervalMin * stretch,
		tellIntervalMax = cfg.BaseTellIntervalMax * stretch,
		glyphCount = cfg.GlyphsPerShift,
	}
end

return Escalation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">GlyphMatch</string>
            <string name="Source"><![CDATA[--!strict
-- Pure logic: ordered glyph-code matching (no `game` references — unit-tested via Luau CLI).

local GlyphMatch = {}

-- Returns true only when slots exactly equal the spirit code, in order.
function GlyphMatch.matches(code: { string }, slots: { string? }): boolean
	if #code == 0 then
		return false
	end
	for i, glyphId in code do
		if slots[i] ~= glyphId then
			return false
		end
	end
	-- reject extra slotted glyphs beyond the code length
	for i in slots do
		if i > #code and slots[i] ~= nil then
			return false
		end
	end
	return true
end

-- Given every spirit and the current slots, return the single spirit id that matches, or nil.
function GlyphMatch.identify(spirits: { { id: string, code: { string } } }, slots: { string? }): string?
	for _, spirit in spirits do
		if GlyphMatch.matches(spirit.code, slots) then
			return spirit.id
		end
	end
	return nil
end

-- Validation used by tests: every spirit code must reference only defined glyph ids and be unique.
function GlyphMatch.validateDefs(
	spirits: { { id: string, code: { string } } },
	glyphIds: { [string]: any }
): (boolean, string?)
	local seen: { [string]: string } = {}
	for _, spirit in spirits do
		if #spirit.code ~= 3 then
			return false, ("spirit %s code length %d ~= 3"):format(spirit.id, #spirit.code)
		end
		for _, glyphId in spirit.code do
			if glyphIds[glyphId] == nil then
				return false, ("spirit %s references unknown glyph %s"):format(spirit.id, glyphId)
			end
		end
		local key = table.concat(spirit.code, "|")
		if seen[key] then
			return false, ("spirits %s and %s share code %s"):format(seen[key], spirit.id, key)
		end
		seen[key] = spirit.id
	end
	return true, nil
end

return GlyphMatch
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">PresenceMath</string>
            <string name="Source"><![CDATA[--!strict
-- Pure logic: the Presence meter (no `game` references — unit-tested).
-- Constant fill + rush-surge rubber band + last-doll acceleration + event surges.

export type PresenceState = {
	value: number,
	surge: number, -- decaying extra fill from rushing
	stepTimestamps: { number }, -- recent care-step completion times (for rush detection)
	allDollsDone: boolean,
}

export type PresenceConfig = {
	Max: number,
	BaseFillPerSecond: number,
	LastDollAccelMultiplier: number,
	RushWindowSeconds: number,
	RushStepsInWindow: number,
	RushSurgeAmount: number,
	RushDecayPerSecond: number,
	Tiers: { number },
}

local PresenceMath = {}

function PresenceMath.new(): PresenceState
	return {
		value = 0,
		surge = 0,
		stepTimestamps = {},
		allDollsDone = false,
	}
end

-- Record a completed care step at time t; may trigger a rush surge.
function PresenceMath.onStepCompleted(state: PresenceState, cfg: PresenceConfig, t: number)
	table.insert(state.stepTimestamps, t)
	-- drop timestamps outside the window
	local cutoff = t - cfg.RushWindowSeconds
	while #state.stepTimestamps > 0 and state.stepTimestamps[1] < cutoff do
		table.remove(state.stepTimestamps, 1)
	end
	if #state.stepTimestamps >= cfg.RushStepsInWindow then
		state.surge += cfg.RushSurgeAmount
		table.clear(state.stepTimestamps) -- one surge per burst
	end
end

function PresenceMath.addSurge(state: PresenceState, amount: number)
	state.surge += amount
end

-- Advance the meter by dt seconds. rateMultiplier comes from Escalation.
function PresenceMath.step(state: PresenceState, cfg: PresenceConfig, dt: number, rateMultiplier: number)
	local fill = cfg.BaseFillPerSecond * rateMultiplier
	if state.allDollsDone then
		fill *= cfg.LastDollAccelMultiplier
	end
	-- Surge is a bounded "rubber band" pool: spend it into the meter at a fixed rate
	-- (RushDecayPerSecond points/sec) until the pool is empty, so a surge of amount S
	-- always contributes exactly S total points over S / RushDecayPerSecond seconds —
	-- never more. (B9 fix: the old code let the meter receive up to 4x that rate while
	-- only draining the pool at 1x that rate, so a surge silently injected ~4x its
	-- nominal amount into Presence. See tests/logic.spec.luau's "surge integral" checks.)
	local surgeSpend = math.min(state.surge, cfg.RushDecayPerSecond * dt)
	state.surge -= surgeSpend
	state.value = math.min(cfg.Max, state.value + fill * dt + surgeSpend)
end

function PresenceMath.tier(state: PresenceState, cfg: PresenceConfig): number
	local tier = 0
	for i, threshold in cfg.Tiers do
		if state.value >= threshold then
			tier = i
		end
	end
	return tier
end

function PresenceMath.isMaxed(state: PresenceState, cfg: PresenceConfig): boolean
	return state.value >= cfg.Max
end

return PresenceMath
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">QuestProgress</string>
            <string name="Source"><![CDATA[--!strict
-- Pure logic: quest progress computation, shared by QuestService (server, authoritative) and
-- Journal (client, immediate feedback) -- same split as Logic/GlyphMatch.luau for the Ledger.

export type QuestStatsView = {
	dollsCleared: number,
	bestShift: number,
	perfectShifts: number,
	ribbonsTiedTotal: number,
	questFlags: { [string]: boolean },
}

export type QuestDef = {
	id: string,
	goalType: "DollsCleared" | "ShiftsSurvived" | "FirstTryBanishes" | "RibbonsTied" | "Flag",
	target: number,
}

local QuestProgress = {}

function QuestProgress.compute(stats: QuestStatsView, quest: QuestDef): number
	if quest.goalType == "DollsCleared" then
		return stats.dollsCleared
	elseif quest.goalType == "ShiftsSurvived" then
		return stats.bestShift
	elseif quest.goalType == "FirstTryBanishes" then
		return stats.perfectShifts
	elseif quest.goalType == "RibbonsTied" then
		return stats.ribbonsTiedTotal
	elseif quest.goalType == "Flag" then
		return (stats.questFlags[quest.id] == true) and 1 or 0
	end
	return 0
end

function QuestProgress.isComplete(stats: QuestStatsView, quest: QuestDef): boolean
	return QuestProgress.compute(stats, quest) >= quest.target
end

return QuestProgress
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
-- Remote registry (R4): every remote name exists exactly once, here.
-- Server calls Remotes.init() once to create instances; both sides look up via Remotes.get().

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Util = require(script.Parent.Util)

export type RemoteKind = "Event" | "Unreliable"

local DEFS: { [string]: RemoteKind } = {
	-- Server -> Client
	StateChanged = "Event", -- (stateName: string, payload: {}?)  payload includes objective text, shift number
	ShiftData = "Event", -- (shiftNumber: number, dolls: {DollInfo}) manifest at shift start
	DollUpdate = "Event", -- (dollId: string, update: {}) care progress / name changes / removed: boolean?
	GlyphFound = "Event", -- (glyphId: string, foundList: {string}, finderName: string)
	PresenceTier = "Event", -- (tier: number) 0..3
	HauntFired = "Event", -- (hauntId: string, params: {}?) client renders visuals
	BanishResult = "Event", -- (payload: {correct: boolean, dollName: string, spiritName: string?, strikes: number})
	Recap = "Event", -- (payload: recap card data)
	Toast = "Event", -- (message: string, seconds: number?)
	ReadyCountdown = "Event", -- (secondsLeft: number?) nil cancels
	MinigameStart = "Event", -- (dollId: string, stepId: string, seed: number, speedMultiplier: number?)
	                         -- server granted the lock; speedMultiplier is the SwiftHands class buff (<1 = faster)
	MinigameCancel = "Event", -- (dollId: string, stepId: string) lock expired / released
	BanishPrompt = "Event", -- (dollId: string, dollName: string) confirm UI open/close
	DebugInfo = "Event", -- (payload: {}) overlay feed, DebugMode only

	-- Server -> Client (economy / journal / join squares)
	CoinsUpdate = "Event", -- (coins: number) pushed on any balance change (grant/spend) + once near PlayerAdded
	ClassesData = "Event", -- (data: {owned: {[string]: boolean}, equipped: string}) pushed per-player on join/buy/equip
	PlayerStats = "Event", -- (stats: DataService.Stats) full per-player stats snapshot -- fired on load + every change
	JoinSquareUpdate = "Event", -- (squareId: string, data: {count, max, occupantUserIds: {number}, phase: string})
	JoinSquareCountdown = "Event", -- (squareId: string, secondsLeft: number?) nil cancels -- mirrors ReadyCountdown

	-- Client -> Server
	RequestMinigame = "Event", -- (dollId: string, stepId: string)
	MinigameDone = "Event", -- (dollId: string, stepId: string, success: boolean)
	ChooseName = "Event", -- (dollId: string, choiceIndex: number?, freeText: string?)
	PickupDoll = "Event", -- (dollId: string)
	DropDoll = "Event", -- ()
	DepositDoll = "Event", -- () at the banish box
	ConfirmBanish = "Event", -- (confirm: boolean)
	SlotGlyph = "Event", -- (slotIndex: number, glyphId: string?) shared ledger slotting
	CollectGlyph = "Event", -- (tokenId: string)
	TieRibbon = "Event", -- (dollId: string)
	Panic = "Event", -- ()
	ReadyPad = "Event", -- (standing: boolean) redundancy for pad touch detection
	CameraReport = "Unreliable", -- (cframe: CFrame) ~8 Hz watched-check stream

	-- Client -> Server (economy / journal / join squares)
	BuyClass = "Event", -- (classId: string)
	EquipClass = "Event", -- (classId: string)
	ClaimQuest = "Event", -- (questId: string) client requests reward payout for a completed quest
	JoinSquareAction = "Event", -- (squareId: string, action: "Exit" | "StartNow" | "SkipTutorial")
}

local FOLDER_NAME = "Remotes"

local Remotes = {}
Remotes.Names = {} :: { [string]: string }
for name in DEFS do
	Remotes.Names[name] = name
end

function Remotes.init()
	assert(RunService:IsServer(), "Remotes.init is server-only")
	local folder: Instance
	local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
	if existing then
		folder = existing
	else
		local created = Instance.new("Folder")
		created.Name = FOLDER_NAME
		created.Parent = ReplicatedStorage
		folder = created
	end
	for name, kind in DEFS do
		if not folder:FindFirstChild(name) then
			local remote: Instance
			if kind == "Unreliable" then
				remote = Instance.new("UnreliableRemoteEvent")
			else
				remote = Instance.new("RemoteEvent")
			end
			remote.Name = name
			remote.Parent = folder
		end
	end
end

function Remotes.get(name: string): RemoteEvent
	assert(DEFS[name] ~= nil, ("Unknown remote '%s' — add it to Remotes.luau"):format(tostring(name)))
	local folder = Util.waitForChild(ReplicatedStorage, FOLDER_NAME, 15)
	assert(folder, "Remotes folder missing")
	local remote = Util.waitForChild(folder, name, 15)
	assert(remote, ("Remote '%s' missing"):format(name))
	return remote :: RemoteEvent
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">ServerKind</string>
          <string name="Source"><![CDATA[--!strict
-- ServerKind: single source of truth for "what kind of server is this," now that a shift can run
-- either in-place (Studio, or the Config.Features.PrivateShiftServers kill switch) or in a
-- dedicated live reserved private server (TeleportService:TeleportAsync + ShouldReserveServer).
-- MapBuilder and JoinSquareService both read this so their branches can never disagree.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any

local ServerKind = {}

-- True when this server should run the CURRENT single-server flow: MapBuilder builds both Lobby
-- and Workshop, and join squares resolve via ShiftManager.beginShiftFor instead of a real
-- cross-server teleport. True in Studio (TeleportService never functions there) OR when the team
-- has thrown Config.Features.PrivateShiftServers off (R3 escape hatch if live teleporting misbehaves).
function ServerKind.isSameServerMode(): boolean
	return RunService:IsStudio() or not Config.Features.PrivateShiftServers
end

-- True only for a live, published server that booted as a TeleportAsync-reserved instance.
function ServerKind.isReservedShiftServer(): boolean
	return (not ServerKind.isSameServerMode()) and game.PrivateServerId ~= ""
end

-- True for a live public server that is NOT a reserved shift instance -- i.e. the lobby.
function ServerKind.isPublicLobbyServer(): boolean
	return (not ServerKind.isSameServerMode()) and game.PrivateServerId == ""
end

return ServerKind
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">SoundConfig</string>
          <string name="Source"><![CDATA[--!strict
-- Every audio cue in the game, one line each. ALL catalog ids ship as 0 (silent no-op) —
-- the team fills these from the Creator Store in Studio (PLAYTEST.md has the guide).
-- Only built-in rbxasset:// files are prefilled (safe: they ship with the client).
-- soundId = 0 means SoundClient skips the cue without erroring.

export type Cue = {
	soundId: number | string, -- 0 = unset; number = catalog id; string = rbxasset:// path
	volume: number,
	looped: boolean?,
	speed: number?, -- PlaybackSpeed
}

local SoundConfig: { [string]: Cue } = {
	-- Ambience (looped beds; tier layers fade in client-side)
	AmbienceBase = { soundId = 0, volume = 0.4, looped = true }, -- TODO(team): quiet workshop room tone
	AmbienceTier2 = { soundId = 0, volume = 0.3, looped = true }, -- TODO(team): low unease drone
	AmbienceTier3 = { soundId = 0, volume = 0.35, looped = true }, -- TODO(team): close, wrong, breathing

	-- The music box (the game's musical signature; also a tell)
	MusicBoxLoop = { soundId = 0, volume = 0.5, looped = true }, -- TODO(team): music box lullaby
	MusicBoxDetuned = { soundId = 0, volume = 0.5, looped = true, speed = 0.82 }, -- TODO(team): same lullaby (client detunes)

	-- UI / feedback (built-ins prefilled — these always work)
	UiClick = { soundId = "rbxasset://sounds/button.wav", volume = 0.6 },
	UiConfirm = { soundId = "rbxasset://sounds/electronicpingshort.wav", volume = 0.6 },
	DetectorTick = { soundId = "rbxasset://sounds/snap.mp3", volume = 0.7 },

	-- Care minigames
	BrushStroke = { soundId = 0, volume = 0.5 }, -- TODO(team): soft brush swish
	StepDone = { soundId = "rbxasset://sounds/electronicpingshort.wav", volume = 0.5 },
	RibbonTie = { soundId = 0, volume = 0.6 }, -- TODO(team): delicate chime

	-- Scares (every one has a visual co-cue; silence does not break the game)
	StingReveal = { soundId = 0, volume = 0.9 }, -- TODO(team): short orchestral sting (banish reveal)
	StingWrong = { soundId = 0, volume = 0.9 }, -- TODO(team): sour, descending sting (wrong banish)
	DollmakerScream = { soundId = 0, volume = 1 }, -- TODO(team): THE scream (run-end scare; our Deer)
	WhisperPass = { soundId = 0, volume = 0.6 }, -- TODO(team): passing whisper L->R
	DoorSlam = { soundId = 0, volume = 0.8 }, -- TODO(team): heavy door slam
	BenchRattle = { soundId = 0, volume = 0.7 }, -- TODO(team): wood rattle
	LightsOut = { soundId = 0, volume = 0.8 }, -- TODO(team): breaker thunk

	-- Emotes
	PanicBark = { soundId = 0, volume = 0.8 }, -- TODO(team): character yelp ("the characters scream so players don't have to")

	-- Join squares
	SquareLockIn = { soundId = 0, volume = 0.7 }, -- TODO(team): satisfying "lock-in" chime when a
	                                                -- square resolves. UiClick/UiConfirm already cover ordinary button taps.
}

return SoundConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">SoundKit</string>
          <string name="Source"><![CDATA[--!strict
-- Sound helper honoring the ship-silent rule: cue ids of 0 no-op cleanly (no error spam).
-- Works on server (world sounds parented to parts) and client (SoundService-parented UI/ambience).

local SoundService = game:GetService("SoundService")

local SoundConfig = require(script.Parent.SoundConfig)
local Util = require(script.Parent.Util)

local SoundKit = {}

local function resolveId(id: number | string): string?
	if typeof(id) == "string" then
		return id -- rbxasset:// built-in
	end
	if typeof(id) == "number" and id > 0 then
		return ("rbxassetid://%d"):format(id)
	end
	return nil -- unset (0): silent no-op
end

-- Create a Sound for a cue, parented where you need it (a part for 3D, SoundService for 2D).
-- Returns nil when the cue is unset — callers must tolerate nil.
function SoundKit.attach(cueName: string, parent: Instance): Sound?
	local cue = SoundConfig[cueName]
	if not cue then
		Util.warn(("SoundKit: unknown cue '%s'"):format(cueName))
		return nil
	end
	local id = resolveId(cue.soundId)
	if not id then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = "Cue_" .. cueName
	sound.SoundId = id
	sound.Volume = cue.volume
	sound.Looped = cue.looped == true
	if cue.speed then
		sound.PlaybackSpeed = cue.speed
	end
	sound.Parent = parent
	return sound
end

-- Fire-and-forget one-shot. Safe with unset cues. 2D when part is nil.
function SoundKit.play(cueName: string, part: Instance?)
	local parent: Instance = part or SoundService
	local sound = SoundKit.attach(cueName, parent)
	if not sound then
		return
	end
	sound.PlayOnRemove = false
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
end

return SoundKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[--!strict
-- Small shared helpers: logging with a consistent prefix, guarded calls, timeout WaitForChild (R4).

local Util = {}

local PREFIX = "[Porcelain]"

function Util.log(...: any)
	print(PREFIX, ...)
end

function Util.warn(...: any)
	warn(PREFIX, ...)
end

-- pcall wrapper that logs failures and never throws (R3).
function Util.safeCall<T...>(label: string, fn: (T...) -> ...any, ...: T...): boolean
	local ok, err = pcall(fn, ...)
	if not ok then
		Util.warn(("safeCall '%s' failed: %s"):format(label, tostring(err)))
	end
	return ok
end

-- WaitForChild with a logged timeout instead of an infinite yield (R4).
function Util.waitForChild(parent: Instance, name: string, timeout: number?): Instance?
	local child = parent:WaitForChild(name, timeout or 10)
	if not child then
		Util.warn(("waitForChild timed out: %s.%s"):format(parent:GetFullName(), name))
	end
	return child
end

-- Shallow copy
function Util.copy<K, V>(t: { [K]: V }): { [K]: V }
	local out = {}
	for k, v in t do
		out[k] = v
	end
	return out
end

function Util.playerCount(players: { any }): number
	return #players
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="26">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="27">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- Server bootstrap: build world, wire services, start the machine.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any

Remotes.init()

local ServicesFolder = script:WaitForChild("Services")

local MapBuilder = require(ServicesFolder:WaitForChild("MapBuilder")) :: any
local DataService = require(ServicesFolder:WaitForChild("DataService")) :: any
local WatchService = require(ServicesFolder:WaitForChild("WatchService")) :: any
local DollService = require(ServicesFolder:WaitForChild("DollService")) :: any
local GlyphService = require(ServicesFolder:WaitForChild("GlyphService")) :: any
local TellService = require(ServicesFolder:WaitForChild("TellService")) :: any
local PresenceService = require(ServicesFolder:WaitForChild("PresenceService")) :: any
local HauntService = require(ServicesFolder:WaitForChild("HauntService")) :: any
local BanishService = require(ServicesFolder:WaitForChild("BanishService")) :: any
local ClassService = require(ServicesFolder:WaitForChild("ClassService")) :: any
local LobbyService = require(ServicesFolder:WaitForChild("LobbyService")) :: any
local ShiftManager = require(ServicesFolder:WaitForChild("ShiftManager")) :: any
local JoinSquareService = require(ServicesFolder:WaitForChild("JoinSquareService")) :: any
local QuestService = require(ServicesFolder:WaitForChild("QuestService")) :: any
local DebugService = require(ServicesFolder:WaitForChild("DebugService")) :: any

local manifest, failures = MapBuilder.build()

local ctx: any = {
	rng = Random.new(),
	manifest = manifest,
	services = {
		MapBuilder = MapBuilder,
		DataService = DataService,
		WatchService = WatchService,
		DollService = DollService,
		GlyphService = GlyphService,
		TellService = TellService,
		PresenceService = PresenceService,
		HauntService = HauntService,
		BanishService = BanishService,
		ClassService = ClassService,
		LobbyService = LobbyService,
		ShiftManager = ShiftManager,
		JoinSquareService = JoinSquareService,
		QuestService = QuestService,
		DebugService = DebugService,
	},
}

local initOrder = {
	"MapBuilder",
	"DataService",
	"WatchService",
	"DollService",
	"GlyphService",
	"TellService",
	"PresenceService",
	"HauntService",
	"BanishService",
	"ClassService", -- needs DataService + DollService already initialized (StartWithRibbon buff)
	"LobbyService",
	"ShiftManager",
	"JoinSquareService", -- additive; calls into ShiftManager.beginShiftFor only from event handlers
	"QuestService", -- needs ShiftManager.onShiftCleared + DollService.onRibbonTied already registerable
	"DebugService",
}

for _, name in initOrder do
	local ok, err = pcall(function()
		ctx.services[name].init(ctx)
	end)
	if not ok then
		Util.warn(("Service '%s' FAILED to init: %s"):format(name, tostring(err)))
	end
end

DollService.wireWorld(manifest)

if #failures > 0 then
	-- loud on-screen banner for the team (plan review: broken segments must be visible)
	task.delay(5, function()
		Remotes.get(Remotes.Names.Toast):FireAllClients(
			"MAP SEGMENTS FAILED: " .. table.concat(failures, ", ") .. " — screenshot this + Output window",
			30
		)
	end)
end

Util.log(("server up — v%s (%s), %d map failures"):format(Config.Version, Config.BuildStamp, #failures))
]]></string>
      </Properties>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">BanishService</string>
            <string name="Source"><![CDATA[--!strict
-- The Banish Box: unlock gating, deposit, group-confirm quorum, resolution handoff.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any

local BanishService = {}

local ctx: any
local unlocked = false
local pending: { dollId: string, confirms: { [Player]: boolean }, generation: number }? = nil
local generation = 0

local function broadcastPrompt(dollId: string?, dollName: string?, extra: any)
	Remotes.get(Remotes.Names.BanishPrompt):FireAllClients(dollId, dollName, extra)
end

local function quorumPlayers(): { Player }
	local ShiftManager = ctx.services.ShiftManager
	local participants = ShiftManager.getParticipants()
	local out = {}
	for _, player in participants do
		if player.Parent ~= nil then
			table.insert(out, player)
		end
	end
	return out
end

local function resolve()
	local p = pending
	if not p then
		return
	end
	pending = nil
	generation += 1
	broadcastPrompt(nil, nil, { cancelled = true })
	Util.safeCall("banishResolve", function()
		ctx.services.ShiftManager.onBanishResolved(p.dollId)
	end)
end

local function cancel()
	local p = pending
	if not p then
		return
	end
	pending = nil
	generation += 1
	broadcastPrompt(nil, nil, { cancelled = true })
	-- return the doll to its bench
	local DollService = ctx.services.DollService
	local model = DollService.getModel(p.dollId)
	if model then
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Transparency = if d.Name == "Root" then 1 else 0
			elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
				(d :: any).Enabled = true
			end
		end
	end
	DollService.setUnlocked(unlocked) -- refresh prompts
end

local function checkQuorum()
	local p = pending
	if not p then
		return
	end
	local players = quorumPlayers()
	local yes = 0
	for _, player in players do
		if p.confirms[player] then
			yes += 1
		end
	end
	if yes >= #players and #players > 0 then
		resolve()
	end
end

function BanishService.init(context: any)
	ctx = context
	local manifest = ctx.manifest

	if manifest.banishPrompt then
		manifest.banishPrompt.Triggered:Connect(function(player: Player)
			BanishService.deposit(player)
		end)
	end

	Remotes.get(Remotes.Names.ConfirmBanish).OnServerEvent:Connect(function(player: Player, confirm: any)
		local p = pending
		if not p then
			return
		end
		if confirm == true then
			p.confirms[player] = true
			checkQuorum()
		elseif confirm == false then
			cancel()
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local p = pending
		if p then
			p.confirms[player] = nil
			task.defer(checkQuorum)
		end
	end)
end

function BanishService.setUnlocked(state: boolean)
	unlocked = state
	local manifest = ctx.manifest
	if manifest.banishPrompt then
		manifest.banishPrompt.Enabled = state and pending == nil
	end
	if manifest.banishGlow then
		TweenService:Create(manifest.banishGlow, TweenInfo.new(1.5), { Brightness = if state then 1.6 else 0 }):Play()
	end
	Util.safeCall("dollUnlock", function()
		ctx.services.DollService.setUnlocked(state)
	end)
end

function BanishService.deposit(player: Player)
	if not unlocked or pending then
		return
	end
	local DollService = ctx.services.DollService
	local dollId = DollService.getCarried(player)
	if not dollId then
		Remotes.get(Remotes.Names.Toast):FireClient(player, "Pick up the doll you suspect first.", 3)
		return
	end
	DollService.drop(player)
	-- doll appears inside the box
	local model = DollService.getModel(dollId)
	local boxBase = ctx.manifest.banishBox and ctx.manifest.banishBox.PrimaryPart
	if model and boxBase then
		model:PivotTo(boxBase.CFrame * CFrame.new(0, 1.2, 0))
		for _, d in model:GetDescendants() do
			if d:IsA("ProximityPrompt") then
				d.Enabled = false
			end
		end
	end
	if ctx.manifest.banishPrompt then
		ctx.manifest.banishPrompt.Enabled = false
	end

	generation += 1
	local myGen = generation
	pending = { dollId = dollId, confirms = {}, generation = myGen }
	local dollName = DollService.getDisplayName(dollId)
	broadcastPrompt(dollId, dollName, nil)

	local players = quorumPlayers()
	if #players <= 1 then
		-- solo: auto-resolve countdown
		task.spawn(function()
			for remaining = Config.Banish.SoloConfirmSeconds, 1, -1 do
				if not pending or pending.generation ~= myGen then
					return
				end
				broadcastPrompt(dollId, dollName, { countdown = remaining })
				task.wait(1)
			end
			if pending and pending.generation == myGen then
				resolve()
			end
		end)
	else
		-- multiplayer: majority + timer fallback so an AFK player can't deadlock (plan review fix)
		task.spawn(function()
			local elapsed = 0
			while pending and pending.generation == myGen do
				task.wait(1)
				elapsed += 1
				local p = pending
				if not p or p.generation ~= myGen then
					return
				end
				local current = quorumPlayers()
				local yes = 0
				for _, plr in current do
					if p.confirms[plr] then
						yes += 1
					end
				end
				if yes > #current / 2 then
					local remaining = Config.Banish.MajorityTimerSeconds - elapsed
					broadcastPrompt(dollId, dollName, { countdown = math.max(remaining, 0) })
					if remaining <= 0 then
						resolve()
						return
					end
				end
				if elapsed > Config.Shift.Watchdog.BanishStaging + Config.Banish.MajorityTimerSeconds then
					cancel() -- watchdog: nobody decided (R2)
					return
				end
			end
		end)
	end
end

function BanishService.reset()
	pending = nil
	generation += 1
	-- B3 fix: always broadcast cancelled=true, unconditionally -- not just from cancel()/resolve().
	-- Confirmed live: without this, BanishPrompt countdown ticks kept firing after StateChanged(RunEnd)
	-- and BanishConfirmUI's modal stayed visible into the next lobby session.
	broadcastPrompt(nil, nil, { cancelled = true })
	BanishService.setUnlocked(false)
end

return BanishService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">ClassService</string>
            <string name="Source"><![CDATA[--!strict
-- Purchasable classes: ownership + one-equipped-at-a-time model + buff folding into shift params.
-- Persistence lives in DataService (R5); this service is validation + the buff-application hook
-- ShiftManager calls once per ShiftIntro.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Classes = require(Shared:WaitForChild("Defs"):WaitForChild("Classes")) :: any

local ClassService = {}

local ctx: any

local function starterId(): string
	return Classes.starterId
end

local function ownedSet(player: Player): { [string]: boolean }
	local stats = ctx.services.DataService.getStats(player)
	return stats.ownedClasses or {}
end

function ClassService.isOwned(player: Player, classId: string): boolean
	local def = Classes.byId[classId]
	if not def then
		return false
	end
	if def.price <= 0 then
		return true -- free classes are always owned; never persisted as "owned"
	end
	return ownedSet(player)[classId] == true
end

function ClassService.getEquippedId(player: Player): string
	local stats = ctx.services.DataService.getStats(player)
	local id = stats.equippedClass
	if typeof(id) ~= "string" or id == "" or not Classes.byId[id] then
		return starterId()
	end
	if not ClassService.isOwned(player, id) then
		return starterId() -- defensive: should not happen, but never equip something not owned
	end
	return id
end

function ClassService.getEquippedBuff(player: Player): any
	local def = Classes.byId[ClassService.getEquippedId(player)]
	return (def and def.buff) or Classes.byId[starterId()].buff
end

-- Convenience read used at every coin-award call site so award code never has to know about buff
-- "kind" strings.
function ClassService.getCoinMultiplier(player: Player): number
	local buff = ClassService.getEquippedBuff(player)
	if buff.kind == "CoinMultiplier" then
		return buff.value or 1
	end
	return 1
end

local function pushClassesData(player: Player)
	Remotes.get(Remotes.Names.ClassesData):FireClient(player, {
		owned = ownedSet(player),
		equipped = ClassService.getEquippedId(player),
	})
end

-- Returns (ok: boolean, message: string) -- message is meant to go straight into a Toast.
function ClassService.buyClass(player: Player, classId: string): (boolean, string)
	if not Config.Features.Economy then
		return false, "The shop is closed right now."
	end
	local def = Classes.byId[classId]
	if not def then
		return false, "Unknown class."
	end
	if def.price <= 0 then
		return false, "That one's already free."
	end
	if ClassService.isOwned(player, classId) then
		return false, "You already own that."
	end
	local ok = ctx.services.DataService.spendCoins(player, def.price)
	if not ok then
		return false, "Not enough coins."
	end
	ctx.services.DataService.grantClassOwnership(player, classId)
	pushClassesData(player)
	return true, ("Bought %s."):format(def.name)
end

function ClassService.equipClass(player: Player, classId: string): (boolean, string)
	if not Config.Features.Economy then
		return false, "The shop is closed right now."
	end
	local def = Classes.byId[classId]
	if not def then
		return false, "Unknown class."
	end
	if not ClassService.isOwned(player, classId) then
		return false, "You don't own that yet."
	end
	ctx.services.DataService.setEquippedClass(player, classId)
	pushClassesData(player)
	return true, ("Equipped %s."):format(def.name)
end

-- Called once per shift, from ShiftManager's ShiftIntro branch, AFTER shiftParams exists and BEFORE
-- DollService.spawnShift/TellService.startShift/etc read it. R1: correct with 1 participant.
-- Shared/global buffs (ExtraStrike, TellDurationMultiplier) take the most-generous value across ALL
-- equipped participants rather than stacking -- strikes and tell timing are shift-wide state, not
-- per-player. Per-player buffs (StartWithRibbon) are applied directly here as a side effect;
-- CoinMultiplier is read per-player at the award call site instead, not folded into this aggregate.
function ClassService.applyBuffs(_shiftParams: any, participants: { Player }): any
	local aggregate = {
		strikeLimitBonus = 0,
		careSpeedMultiplier = 1, -- <1 = faster; most-generous (lowest) among equipped participants
		tellDurationMultiplier = 1, -- >1 = tells linger longer; most-generous (highest) among equipped participants
	}
	if not Config.Features.Economy then
		return aggregate
	end
	for _, player in participants do
		local buff = ClassService.getEquippedBuff(player)
		if buff.kind == "ExtraStrike" then
			aggregate.strikeLimitBonus = math.max(aggregate.strikeLimitBonus, buff.value or 0)
		elseif buff.kind == "CareSpeedMultiplier" then
			aggregate.careSpeedMultiplier = math.min(aggregate.careSpeedMultiplier, buff.value or 1)
		elseif buff.kind == "TellDurationMultiplier" then
			aggregate.tellDurationMultiplier = math.max(aggregate.tellDurationMultiplier, buff.value or 1)
		elseif buff.kind == "StartWithRibbon" then
			Util.safeCall("giveRibbon", ctx.services.DollService.giveRibbon, player)
		end
	end
	return aggregate
end

function ClassService.init(context: any)
	ctx = context

	Remotes.get(Remotes.Names.BuyClass).OnServerEvent:Connect(function(player: Player, classId: any)
		if typeof(classId) ~= "string" then
			return
		end
		Util.safeCall("buyClass", function()
			local _ok, msg = ClassService.buyClass(player, classId)
			Remotes.get(Remotes.Names.Toast):FireClient(player, msg, 3)
		end)
	end)

	Remotes.get(Remotes.Names.EquipClass).OnServerEvent:Connect(function(player: Player, classId: any)
		if typeof(classId) ~= "string" then
			return
		end
		Util.safeCall("equipClass", function()
			local _ok, msg = ClassService.equipClass(player, classId)
			Remotes.get(Remotes.Names.Toast):FireClient(player, msg, 3)
		end)
	end)

	ctx.services.DataService.onStatsChanged(function(player: Player, _stats: any)
		pushClassesData(player)
	end)

	Players.PlayerAdded:Connect(function(player)
		pushClassesData(player)
		task.delay(3, function()
			if player.Parent then
				pushClassesData(player)
			end
		end)
	end)
end

return ClassService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
-- Persistence per R5: probe once, memory fallback, UpdateAsync merge-only, never blocks gameplay.
--
-- Extended for the lobby/economy system: coins (sum-merge), owned classes + equipped class
-- (union-merge / last-write-wins), ribbon-tie counter (sum-merge), tutorialDone (a ONE-WAY flag --
-- OR-merge, not sum/max), and two claimed/discovered id sets (per-key OR/union-merge). R5 says
-- every merge is max() or sum() UNLESS explicitly flagged otherwise -- these new shapes are that
-- flagged exception. `dirty` replaces the old "did runs/bestShift change" flush gate so that a
-- session whose ONLY changes were coin/class/ribbon/tutorial/quest updates still gets flushed.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any

local DataService = {}

type Stats = {
	bestShift: number,
	dollsCleared: number,
	perfectShifts: number,
	runs: number,
	coins: number, -- sum-merge. Spendable balance; Shop/Economy purchases debit this via a negative addCoins() amount.
	ownedClasses: { [string]: boolean }, -- per-key OR/union-merge. Classes with price > 0 this player has bought.
	equippedClass: string, -- last-write-wins. "" / unrecognized / not-owned all fall back to the free starter class at read time (ClassService's job).
	ribbonsTiedTotal: number, -- sum-merge. Career ribbon-tie count (the "Silver Fingers" quest).
	tutorialDone: boolean, -- OR-merge (one-way -- once true, always true).
	claimedQuestIds: { [string]: boolean }, -- per-key OR/union-merge. Reward paid-out guard.
	questFlags: { [string]: boolean }, -- per-key OR/union-merge. Easter-egg discovery state.
	loaded: boolean,
}

local available = false
local store: any = nil
local cache: { [Player]: Stats } = {}
local sessionDelta: {
	[Player]: {
		dollsCleared: number,
		perfectShifts: number,
		runs: number,
		bestShift: number,
		coins: number, -- signed net delta (earn positive, spend negative) since last flush
		ribbonsTiedTotal: number,
		newlyOwnedClasses: { [string]: boolean }, -- classIds bought this session, not yet flushed
		equippedClassDirty: boolean,
		equippedClass: string,
	},
} = {}
local dirty: { [Player]: boolean } = {} -- true when cache has unflushed changes
local loadedCallbacks: { (Player, Stats) -> () } = {}

local function defaultStats(): Stats
	return {
		bestShift = 0,
		dollsCleared = 0,
		perfectShifts = 0,
		runs = 0,
		coins = 0,
		ownedClasses = {},
		equippedClass = "",
		ribbonsTiedTotal = 0,
		tutorialDone = false,
		claimedQuestIds = {},
		questFlags = {},
		loaded = false,
	}
end

local function keyFor(player: Player): string
	return "u_" .. player.UserId
end

local function loadPlayer(player: Player)
	cache[player] = defaultStats()
	sessionDelta[player] = {
		dollsCleared = 0,
		perfectShifts = 0,
		runs = 0,
		bestShift = 0,
		coins = 0,
		ribbonsTiedTotal = 0,
		newlyOwnedClasses = {},
		equippedClassDirty = false,
		equippedClass = "",
	}
	dirty[player] = false

	-- Best-effort immediate push + delayed resend for late-connecting client listeners (same
	-- pattern ShiftManager uses for late-joiner StateChanged) so the Shop/HUD have SOMETHING to
	-- show before the DataStore round-trip lands (R5: never block gameplay on persistence).
	Remotes.get(Remotes.Names.CoinsUpdate):FireClient(player, cache[player].coins)
	task.delay(3, function()
		if player.Parent and cache[player] then
			Remotes.get(Remotes.Names.CoinsUpdate):FireClient(player, cache[player].coins)
		end
	end)

	if not available then
		return
	end
	task.spawn(function()
		for attempt = 1, Config.Data.ReadRetries do
			local ok, result = pcall(function()
				return store:GetAsync(keyFor(player))
			end)
			if ok then
				local stats = cache[player]
				if stats and typeof(result) == "table" then
					stats.bestShift = tonumber(result.bestShift) or 0
					stats.dollsCleared = tonumber(result.dollsCleared) or 0
					stats.perfectShifts = tonumber(result.perfectShifts) or 0
					stats.runs = tonumber(result.runs) or 0
					stats.coins = tonumber(result.coins) or 0
					stats.ownedClasses = if typeof(result.ownedClasses) == "table" then result.ownedClasses else {}
					stats.equippedClass = if typeof(result.equippedClass) == "string" then result.equippedClass else ""
					stats.ribbonsTiedTotal = tonumber(result.ribbonsTiedTotal) or 0
					stats.tutorialDone = result.tutorialDone == true
					if typeof(result.claimedQuestIds) == "table" then
						for id, v in result.claimedQuestIds do
							if v and typeof(id) == "string" then
								stats.claimedQuestIds[id] = true
							end
						end
					end
					if typeof(result.questFlags) == "table" then
						for id, v in result.questFlags do
							if v and typeof(id) == "string" then
								stats.questFlags[id] = true
							end
						end
					end
				end
				if stats then
					stats.loaded = true
					Remotes.get(Remotes.Names.CoinsUpdate):FireClient(player, stats.coins) -- correct the pre-load guess
					for _, cb in loadedCallbacks do
						Util.safeCall("statsLoaded", cb, player, stats)
					end
				end
				return
			end
			task.wait(Config.Data.RetryBackoffSeconds * attempt)
		end
		Util.warn("DataService: load failed for " .. player.Name .. " (memory-only this session)")
	end)
end

-- Why flushPlayer needs care around ownedClasses/claimedQuestIds/questFlags: UpdateAsync's transform
-- function can yield internally (Roblox may retry it), and other coroutines on the same server (e.g.
-- a BuyClass handler, or an easter-egg trigger) run concurrently while it's yielded. The numeric
-- counters dodge this because their delta always resets to 0 after a flush -- a mid-flight change
-- just adds to the now-zeroed delta and gets picked up next time, no loss. A SET-valued delta
-- (newlyOwnedClasses) can't be blindly wiped the same way: snapshot-then-clear-the-whole-table would
-- silently drop anything that arrived mid-flight. So: snapshot only what's about to be sent, and
-- after a successful flush, clear only those specific keys.
local function flushPlayer(player: Player)
	if not available or not dirty[player] then
		return
	end
	local delta = sessionDelta[player]
	local stats = cache[player]
	if not delta or not stats then
		return
	end
	local ownedSnapshot = table.clone(delta.newlyOwnedClasses)
	local equipDirty = delta.equippedClassDirty
	local equipSnapshot = delta.equippedClass
	local snapshot = {
		bestShift = delta.bestShift,
		dollsCleared = delta.dollsCleared,
		perfectShifts = delta.perfectShifts,
		runs = delta.runs,
		coins = delta.coins,
		ribbonsTiedTotal = delta.ribbonsTiedTotal,
		tutorialDone = stats.tutorialDone, -- absolute value -- OR-merge is idempotent, no delta needed
		claimedQuestIds = table.clone(stats.claimedQuestIds), -- absolute
		questFlags = table.clone(stats.questFlags), -- absolute
	}
	local ok = pcall(function()
		store:UpdateAsync(keyFor(player), function(old: any)
			old = if typeof(old) == "table" then old else {}
			local mergedOwned = if typeof(old.ownedClasses) == "table" then table.clone(old.ownedClasses) else {}
			for classId in ownedSnapshot do
				mergedOwned[classId] = true
			end
			local mergedClaimed = if typeof(old.claimedQuestIds) == "table" then table.clone(old.claimedQuestIds) else {}
			for id, v in snapshot.claimedQuestIds do
				if v then
					mergedClaimed[id] = true
				end
			end
			local mergedFlags = if typeof(old.questFlags) == "table" then table.clone(old.questFlags) else {}
			for id, v in snapshot.questFlags do
				if v then
					mergedFlags[id] = true
				end
			end
			return {
				bestShift = math.max(tonumber(old.bestShift) or 0, snapshot.bestShift),
				dollsCleared = (tonumber(old.dollsCleared) or 0) + snapshot.dollsCleared,
				perfectShifts = (tonumber(old.perfectShifts) or 0) + snapshot.perfectShifts,
				runs = (tonumber(old.runs) or 0) + snapshot.runs,
				coins = (tonumber(old.coins) or 0) + snapshot.coins,
				ribbonsTiedTotal = (tonumber(old.ribbonsTiedTotal) or 0) + snapshot.ribbonsTiedTotal,
				ownedClasses = mergedOwned,
				equippedClass = if equipDirty then equipSnapshot else (old.equippedClass or ""),
				tutorialDone = (old.tutorialDone == true) or snapshot.tutorialDone,
				claimedQuestIds = mergedClaimed,
				questFlags = mergedFlags,
			}
		end)
	end)
	if ok then
		dirty[player] = false
		local d = sessionDelta[player]
		if d then
			d.dollsCleared = 0
			d.perfectShifts = 0
			d.runs = 0
			d.coins = 0
			d.ribbonsTiedTotal = 0
			-- bestShift / tutorialDone / claimedQuestIds / questFlags stay as-is: their merges are idempotent
			for classId in ownedSnapshot do
				d.newlyOwnedClasses[classId] = nil -- only clear what THIS flush actually sent
			end
			if equipDirty and d.equippedClass == equipSnapshot then
				d.equippedClassDirty = false -- only clear if nothing newer landed mid-flight
			end
		end
	else
		Util.warn("DataService: flush failed for " .. player.Name)
	end
end

function DataService.init(_ctx: any)
	-- availability probe, deferred (R5: never blocks init)
	if Config.Features.DataStore then
		task.spawn(function()
			local ok = pcall(function()
				store = DataStoreService:GetDataStore(Config.Data.StoreName)
				store:GetAsync("__probe")
			end)
			available = ok
			Util.log("DataService: " .. (if available then "DataStores ONLINE" else "DataStores unavailable — memory-only (publish + enable Studio API access to persist)"))
			if available then
				for _, player in Players:GetPlayers() do
					if cache[player] and not cache[player].loaded then
						loadPlayer(player)
					end
				end
			end
		end)
	end

	Players.PlayerAdded:Connect(loadPlayer)
	for _, player in Players:GetPlayers() do
		if not cache[player] then
			loadPlayer(player)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		flushPlayer(player)
		cache[player] = nil
		sessionDelta[player] = nil
		dirty[player] = nil
	end)

	game:BindToClose(function()
		for _, player in Players:GetPlayers() do
			Util.safeCall("bindToCloseFlush", flushPlayer, player)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(120)
			for _, player in Players:GetPlayers() do
				Util.safeCall("autosave", flushPlayer, player)
			end
		end
	end)
end

function DataService.getStats(player: Player): Stats
	return cache[player] or defaultStats()
end

function DataService.recordRun(player: Player, result: { shiftReached: number, dollsCleared: number, perfect: number })
	local stats = cache[player]
	local delta = sessionDelta[player]
	if not stats or not delta then
		return
	end
	stats.bestShift = math.max(stats.bestShift, result.shiftReached)
	stats.dollsCleared += result.dollsCleared
	stats.perfectShifts += result.perfect
	stats.runs += 1
	delta.bestShift = math.max(delta.bestShift, result.shiftReached)
	delta.dollsCleared += result.dollsCleared
	delta.perfectShifts += result.perfect
	delta.runs += 1
	dirty[player] = true
	for _, cb in loadedCallbacks do
		Util.safeCall("statsChanged", cb, player, stats)
	end
end

-- ---------- economy / journal support ----------

-- Signed delta: positive = earn, negative = spend. Clamps so the balance never goes below 0.
-- Fires CoinsUpdate to the player so HUD/Shop stay live without polling.
function DataService.addCoins(player: Player, amount: number): number
	local stats = cache[player]
	local delta = sessionDelta[player]
	if not stats or not delta then
		return 0
	end
	local applied = math.max(amount, -stats.coins)
	stats.coins += applied
	delta.coins += applied
	dirty[player] = true
	Remotes.get(Remotes.Names.CoinsUpdate):FireClient(player, stats.coins)
	for _, cb in loadedCallbacks do
		Util.safeCall("statsChanged", cb, player, stats)
	end
	return stats.coins
end

-- Server-authoritative spend: fails closed (false) if the player can't afford it. Never trust a
-- client-sent balance -- this reads from cache, which only this service ever mutates.
function DataService.spendCoins(player: Player, amount: number): boolean
	local stats = cache[player]
	if not stats or amount <= 0 or stats.coins < amount then
		return false
	end
	DataService.addCoins(player, -amount)
	return true
end

function DataService.grantClassOwnership(player: Player, classId: string)
	local stats = cache[player]
	local delta = sessionDelta[player]
	if not stats or not delta or stats.ownedClasses[classId] then
		return
	end
	stats.ownedClasses[classId] = true
	delta.newlyOwnedClasses[classId] = true
	dirty[player] = true
end

function DataService.setEquippedClass(player: Player, classId: string)
	local stats = cache[player]
	local delta = sessionDelta[player]
	if not stats or not delta then
		return
	end
	stats.equippedClass = classId
	delta.equippedClassDirty = true
	delta.equippedClass = classId
	dirty[player] = true
end

function DataService.addRibbonTied(player: Player, amount: number)
	local stats = cache[player]
	local delta = sessionDelta[player]
	if not stats or not delta then
		return
	end
	stats.ribbonsTiedTotal += amount
	delta.ribbonsTiedTotal += amount
	dirty[player] = true
	for _, cb in loadedCallbacks do
		Util.safeCall("statsChanged", cb, player, stats)
	end
end

-- One-way flag. Idempotent: calling this after it's already true is a harmless no-op.
function DataService.setTutorialDone(player: Player)
	local stats = cache[player]
	if not stats or stats.tutorialDone then
		return
	end
	stats.tutorialDone = true
	dirty[player] = true
	for _, cb in loadedCallbacks do
		Util.safeCall("statsChanged", cb, player, stats)
	end
end

function DataService.setQuestFlag(player: Player, questId: string)
	local stats = cache[player]
	if not stats or stats.questFlags[questId] then
		return
	end
	stats.questFlags[questId] = true
	dirty[player] = true
	for _, cb in loadedCallbacks do
		Util.safeCall("statsChanged", cb, player, stats)
	end
end

-- Returns false if already claimed (caller should treat as "nothing to pay out" -- this is the
-- double-payout guard).
function DataService.markQuestClaimed(player: Player, questId: string): boolean
	local stats = cache[player]
	if not stats or stats.claimedQuestIds[questId] then
		return false
	end
	stats.claimedQuestIds[questId] = true
	dirty[player] = true
	for _, cb in loadedCallbacks do
		Util.safeCall("statsChanged", cb, player, stats)
	end
	return true
end

function DataService.onStatsChanged(fn: (Player, Stats) -> ())
	table.insert(loadedCallbacks, fn)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">DebugService</string>
            <string name="Source"><![CDATA[--!strict
-- Debug commands + overlay feed (R7). Active only when Config.DebugMode.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any

local DebugService = {}

local ctx: any

local function allowed(player: Player): boolean
	if not Config.DebugMode then
		return false
	end
	if #Config.DebugAllowlist == 0 then
		return true
	end
	return table.find(Config.DebugAllowlist, player.Name) ~= nil
end

local function toast(player: Player, msg: string)
	Remotes.get(Remotes.Names.Toast):FireClient(player, msg, 5)
end

local function handleCommand(player: Player, message: string)
	if not allowed(player) or message:sub(1, 1) ~= "/" then
		return
	end
	local args = message:split(" ")
	local cmd = args[1]:lower()
	local S = ctx.services

	if cmd == "/skipstate" then
		S.ShiftManager.debugForceState()
		toast(player, "state forced")
	elseif cmd == "/shift" then
		local n = tonumber(args[2])
		if n then
			S.ShiftManager.debugSetShift(n)
			toast(player, "shift set to " .. n)
		end
	elseif cmd == "/reveal" then
		local markedName, code = S.ShiftManager.debugReveal()
		toast(player, ("marked: %s | spirit: %s (%s)"):format(
			tostring(markedName),
			code and code.name or "?",
			code and code.code or "?"
		))
	elseif cmd == "/completedoll" then
		local CareSteps = require(Shared:WaitForChild("Defs"):WaitForChild("CareSteps")) :: any
		for _, dollId in S.DollService.getDollIds() do
			for _, step in CareSteps.list do
				S.DollService.completeStep(player, dollId, step.id)
			end
		end
		toast(player, "all care steps completed")
	elseif cmd == "/strike" then
		local delta = tonumber(args[2]) or 1
		S.ShiftManager.debugStrike(delta)
		toast(player, "strike " .. delta)
	elseif cmd == "/presence" then
		local n = tonumber(args[2])
		if n then
			S.PresenceService.setValue(n)
			toast(player, "presence = " .. n)
		end
	elseif cmd == "/haunt" then
		local id = args[2]
		if id then
			S.HauntService.force(id, ctx.rng)
			toast(player, "haunt " .. id)
		end
	elseif cmd == "/ribbon" then
		-- direct-grant path for testing
		local manifest = ctx.manifest
		if manifest.ribbonPrompt then
			toast(player, "walk to the spool; or use prompt — granting via spool trigger not simulated")
		end
	elseif cmd == "/sound" then
		-- audio test: /sound <CueName> plays it for everyone (fills the audio-test-board role)
		local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
		local cue = args[2]
		if cue then
			SoundKit.play(cue)
			toast(player, "played cue " .. cue .. " (silence = id still 0 in SoundConfig)")
		end
	elseif cmd == "/endrun" then
		S.ShiftManager.debugEndRun()
		toast(player, "run ended")
	elseif cmd == "/resetrun" then
		S.ShiftManager.debugEndRun()
		toast(player, "run reset")
	end
end

function DebugService.init(context: any)
	ctx = context
	if not Config.DebugMode then
		return
	end
	Util.log("DebugService ACTIVE — /skipstate /shift N /reveal /completedoll /strike N /presence N /haunt <id> /endrun")

	local function hook(player: Player)
		player.Chatted:Connect(function(message)
			Util.safeCall("debugCommand", handleCommand, player, message)
		end)
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end

	-- overlay feed at 2 Hz
	task.spawn(function()
		while true do
			task.wait(0.5)
			local S = ctx.services
			local payload = {
				presence = math.floor(S.PresenceService.getValue() * 10) / 10,
				tier = S.PresenceService.getTier(),
				state = S.ShiftManager.getState(),
				shift = S.ShiftManager.getShiftNumber(),
				watched = S.WatchService.watchedMap(),
				marked = S.DollService.getMarkedId(),
			}
			for _, player in Players:GetPlayers() do
				if allowed(player) then
					Remotes.get(Remotes.Names.DebugInfo):FireClient(player, payload)
				end
			end
		end
	end)
end

return DebugService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DollService</string>
            <string name="Source"><![CDATA[--!strict
-- Dolls: rigs, care chain + minigame locks, ribbon, naming, carry (R6), procedural tells, consume.
-- Marked state lives ONLY in server tables (never attributes — replication leaks to exploiters).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local CareSteps = require(Shared:WaitForChild("Defs"):WaitForChild("CareSteps")) :: any
local DollNames = require(Shared:WaitForChild("Defs"):WaitForChild("DollNames")) :: any

local DollService = {}

local PALETTES = {
	{ body = Color3.fromRGB(214, 178, 148), dress = Color3.fromRGB(120, 60, 70), hair = Color3.fromRGB(60, 40, 30) },
	{ body = Color3.fromRGB(228, 200, 178), dress = Color3.fromRGB(60, 80, 120), hair = Color3.fromRGB(220, 190, 120) },
	{ body = Color3.fromRGB(200, 170, 150), dress = Color3.fromRGB(80, 110, 70), hair = Color3.fromRGB(40, 30, 28) },
	{ body = Color3.fromRGB(222, 190, 165), dress = Color3.fromRGB(130, 100, 150), hair = Color3.fromRGB(150, 60, 40) },
	{ body = Color3.fromRGB(206, 182, 160), dress = Color3.fromRGB(140, 120, 60), hair = Color3.fromRGB(90, 70, 50) },
	{ body = Color3.fromRGB(232, 210, 190), dress = Color3.fromRGB(90, 60, 60), hair = Color3.fromRGB(230, 225, 215) },
}

type DollRecord = {
	id: string,
	model: Model,
	slot: BasePart,
	name: string,
	variant: number,
	careDone: { [string]: boolean },
	ribbonTied: boolean,
	marked: boolean,
	consumed: boolean,
	prompt: ProximityPrompt,
	pupils: { Frame },
	resting: CFrame,
	slumped: boolean,
	namedByPicker: boolean,
}

local ctx: any
local dolls: { [string]: DollRecord } = {}
local dollOrder: { string } = {}
local locks: { [string]: { player: Player, stepId: string, expiry: number } } = {}
local ribbonHolders: { [Player]: boolean } = {}
local carriers: { [Player]: { dollId: string, clone: Model } } = {}
local stepCallbacks: { (Player, string, string) -> () } = {}
local ribbonCallbacks: { (Player, string) -> () } = {} -- Social/Journal ribbon-tie counter hook
local generation = 0
local unlocked = false
local careSpeedMultiplier = 1 -- shift-wide, from ClassService.applyBuffs' aggregate (SwiftHands buff)

local function fire(name: string, ...: any)
	Remotes.get(Remotes.Names[name]):FireAllClients(...)
end

local function fireTo(player: Player, name: string, ...: any)
	Remotes.get(Remotes.Names[name]):FireClient(player, ...)
end

-- ---------- rig ----------

local function buildRig(id: string, variant: number, slot: BasePart): (Model, { Frame })
	local pal = PALETTES[((variant - 1) % #PALETTES) + 1]
	local model = Instance.new("Model")
	model.Name = "Doll"
	model:SetAttribute("DollId", id)
	model:SetAttribute("Variant", variant)
	CollectionService:AddTag(model, "Doll")

	local function dp(name: string, size: Vector3, cf: CFrame, color: Color3): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.CanCollide = false
		p.Material = Enum.Material.SmoothPlastic
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end

	local base = slot.CFrame
	local root = dp("Root", Vector3.new(0.5, 0.5, 0.5), base, pal.body)
	root.Transparency = 1
	root.CanQuery = false
	model.PrimaryPart = root

	local _body = dp("Body", Vector3.new(1.6, 2.2, 1), base * CFrame.new(0, 1.1, 0), pal.dress)
	local head = dp("Head", Vector3.new(1.3, 1.3, 1.2), base * CFrame.new(0, 2.9, 0), pal.body)
	dp("Hair", Vector3.new(1.45, 0.6, 1.3), base * CFrame.new(0, 3.55, 0), pal.hair)
	dp("ArmL", Vector3.new(0.45, 1.6, 0.45), base * CFrame.new(-1.1, 1.4, 0) * CFrame.Angles(0, 0, math.rad(12)), pal.body)
	dp("ArmR", Vector3.new(0.45, 1.6, 0.45), base * CFrame.new(1.1, 1.4, 0) * CFrame.Angles(0, 0, math.rad(-12)), pal.body)
	local musicBox = dp("MusicBox", Vector3.new(1.1, 0.7, 0.9), base * CFrame.new(0, 0.4, -1), Color3.fromRGB(80, 55, 40))
	dp("Crank", Vector3.new(0.15, 0.5, 0.15), musicBox.CFrame * CFrame.new(0.7, 0.1, 0), Color3.fromRGB(180, 160, 90))

	-- face: SurfaceGui with movable pupils
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 100
	gui.Parent = head
	local pupils: { Frame } = {}
	for i, x in { 0.28, 0.62 } do
		local eye = Instance.new("Frame")
		eye.Name = "Eye" .. i
		eye.AnchorPoint = Vector2.new(0.5, 0.5)
		eye.Position = UDim2.fromScale(x, 0.42)
		eye.Size = UDim2.fromScale(0.2, 0.24)
		eye.BackgroundColor3 = Color3.fromRGB(240, 238, 232)
		eye.BorderSizePixel = 0
		eye.Parent = gui
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = eye
		local pupil = Instance.new("Frame")
		pupil.Name = "Pupil"
		pupil.AnchorPoint = Vector2.new(0.5, 0.5)
		pupil.Position = UDim2.fromScale(0.5, 0.5)
		pupil.Size = UDim2.fromScale(0.45, 0.45)
		pupil.BackgroundColor3 = Color3.fromRGB(20, 16, 22)
		pupil.BorderSizePixel = 0
		pupil.Parent = eye
		local pc = Instance.new("UICorner")
		pc.CornerRadius = UDim.new(1, 0)
		pc.Parent = pupil
		table.insert(pupils, pupil)
	end
	-- stitched mouth
	local mouth = Instance.new("Frame")
	mouth.AnchorPoint = Vector2.new(0.5, 0.5)
	mouth.Position = UDim2.fromScale(0.45, 0.74)
	mouth.Size = UDim2.fromScale(0.34, 0.045)
	mouth.BackgroundColor3 = Color3.fromRGB(120, 70, 70)
	mouth.BorderSizePixel = 0
	mouth.Parent = gui

	-- name tag
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "NameTag"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 120, 0, 28)
	billboard.StudsOffset = Vector3.new(0, 1.6, 0)
	billboard.MaxDistance = 40
	billboard.AlwaysOnTop = false
	billboard.Parent = head
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "NameLabel"
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.fromScale(1, 1)
	nameLabel.Font = Enum.Font.Garamond
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.fromRGB(226, 216, 196)
	nameLabel.TextStrokeTransparency = 0.6
	nameLabel.Parent = billboard

	return model, pupils
end

-- ---------- prompt state ----------

local function refreshPrompt(rec: DollRecord)
	if rec.consumed then
		rec.prompt.Enabled = false
		return
	end
	if locks[rec.id] then
		rec.prompt.Enabled = false
		return
	end
	local nextStep = DollService.nextStepFor(rec.id)
	if nextStep then
		rec.prompt.ActionText = CareSteps.byId[nextStep].name
		rec.prompt.ObjectText = rec.name
		rec.prompt.Enabled = true
	else
		rec.prompt.ObjectText = rec.name
		-- 5 steps done: ribbon (if holder) takes precedence, else pickup when unlocked
		rec.prompt.Enabled = true
		rec.prompt.ActionText = "…" -- resolved per-player at trigger; show generic
		if unlocked then
			rec.prompt.ActionText = "Pick Up / Tie Ribbon"
		elseif not rec.ribbonTied then
			rec.prompt.ActionText = "Tie Ribbon (if you have one)"
		else
			rec.prompt.Enabled = false
		end
		-- keep it enabled if ribbon still possible even when tied dolls wait for unlock
		if not unlocked and rec.ribbonTied then
			rec.prompt.Enabled = false
		end
	end
end

local function refreshAllPrompts()
	for _, rec in dolls do
		refreshPrompt(rec)
	end
end

-- ---------- naming ----------

local function applyName(rec: DollRecord, name: string)
	rec.name = name
	rec.model:SetAttribute("DisplayName", name)
	local head = rec.model:FindFirstChild("Head")
	if head then
		local tag = head:FindFirstChild("NameTag")
		local label = tag and tag:FindFirstChild("NameLabel")
		if label and label:IsA("TextLabel") then
			label.Text = name
		end
	end
	fire("DollUpdate", rec.id, { name = name })
	refreshPrompt(rec)
end

-- ---------- public API ----------

function DollService.init(context: any)
	ctx = context

	Remotes.get(Remotes.Names.MinigameDone).OnServerEvent:Connect(function(player: Player, dollId: any, stepId: any, success: any)
		if typeof(dollId) ~= "string" or typeof(stepId) ~= "string" then
			return
		end
		local lock = locks[dollId]
		if not lock or lock.player ~= player or lock.stepId ~= stepId then
			return
		end
		locks[dollId] = nil
		if success == true then
			DollService.completeStep(player, dollId, stepId)
		else
			fireTo(player, "MinigameCancel", dollId, stepId)
		end
		local rec = dolls[dollId]
		if rec then
			refreshPrompt(rec)
		end
	end)

	Remotes.get(Remotes.Names.ChooseName).OnServerEvent:Connect(function(player: Player, dollId: any, choiceIndex: any, freeText: any)
		if not Config.Features.Naming or typeof(dollId) ~= "string" then
			return
		end
		local rec = dolls[dollId]
		if not rec or rec.consumed or rec.namedByPicker then
			return
		end
		if typeof(choiceIndex) == "number" and DollNames[choiceIndex] then
			rec.namedByPicker = true
			applyName(rec, DollNames[choiceIndex])
		elseif Config.Features.FreeTextNames and typeof(freeText) == "string" then
			local trimmed = freeText:gsub("^%s+", ""):gsub("%s+$", ""):sub(1, 20)
			if #trimmed < 2 then
				return
			end
			task.spawn(function()
				local okFilter, result = pcall(function()
					return TextService:FilterStringAsync(trimmed, player.UserId)
				end)
				if not okFilter then
					return
				end
				local okGet, filtered = pcall(function()
					return result:GetNonChatStringForBroadcastAsync()
				end)
				if okGet and typeof(filtered) == "string" and #filtered >= 2 and not filtered:find("^#+$") then
					rec.namedByPicker = true
					applyName(rec, filtered)
				end
			end)
		end
	end)

	Remotes.get(Remotes.Names.DropDoll).OnServerEvent:Connect(function(player: Player)
		DollService.drop(player)
	end)

	-- leave/reset glue for carriers + ribbon holders + locks
	Players.PlayerRemoving:Connect(function(player)
		DollService.drop(player)
		ribbonHolders[player] = nil
		for dollId, lock in locks do
			if lock.player == player then
				locks[dollId] = nil
				local rec = dolls[dollId]
				if rec then
					refreshPrompt(rec)
				end
			end
		end
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(char: Model)
			local humanoid = char:WaitForChild("Humanoid", 10)
			if humanoid and humanoid:IsA("Humanoid") then
				humanoid.Died:Connect(function()
					DollService.drop(player)
					ribbonHolders[player] = nil
				end)
			end
		end)
	end)

	-- lock expiry sweeper (R2)
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for dollId, lock in locks do
				if now > lock.expiry then
					locks[dollId] = nil
					Util.safeCall("minigameExpire", function()
						fireTo(lock.player, "MinigameCancel", dollId, lock.stepId)
					end)
					local rec = dolls[dollId]
					if rec then
						refreshPrompt(rec)
					end
				end
			end
		end
	end)
end

-- Wire ribbon spool + doll prompts against the manifest (called once from bootstrap after build)
function DollService.wireWorld(manifest: any)
	if manifest.ribbonPrompt then
		manifest.ribbonPrompt.Triggered:Connect(function(player: Player)
			ribbonHolders[player] = true
			fireTo(player, "Toast", "You take a length of silver ribbon.", 3)
		end)
	end
end

function DollService.spawnShift(shiftParams: any, names: { string }, markedIndex: number, rng: any): { any }
	generation += 1
	DollService.clearShift()
	unlocked = false
	careSpeedMultiplier = (shiftParams.classBuffs and shiftParams.classBuffs.careSpeedMultiplier) or 1
	local manifest = ctx.manifest
	local infos = {}
	for i = 1, shiftParams.dollCount do
		local slot = manifest.benchSlots[i]
		if not slot then
			break
		end
		local id = ("doll_%d_%d"):format(generation, i)
		local variant = rng:NextInteger(1, #PALETTES)
		local model, pupils = buildRig(id, variant, slot)
		model.Parent = manifest.root
		local p = Instance.new("ProximityPrompt")
		p.RequiresLineOfSight = false
		p.MaxActivationDistance = Config.Care.PromptDistance
		p.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
		local body = model:FindFirstChild("Body")
		p.Parent = body or model
		local rec: DollRecord = {
			id = id,
			model = model,
			slot = slot,
			name = names[i] or ("Doll #" .. i),
			variant = variant,
			careDone = {},
			ribbonTied = false,
			marked = (i == markedIndex),
			consumed = false,
			prompt = p,
			pupils = pupils,
			resting = slot.CFrame,
			slumped = false,
			namedByPicker = false,
		}
		dolls[id] = rec
		table.insert(dollOrder, id)
		applyName(rec, rec.name)
		p.Triggered:Connect(function(player: Player)
			DollService.onPromptTriggered(player, id)
		end)
		refreshPrompt(rec)
		table.insert(infos, { id = id, name = rec.name, variant = variant })
	end
	return infos
end

function DollService.onPromptTriggered(player: Player, dollId: string)
	local rec = dolls[dollId]
	if not rec or rec.consumed or locks[dollId] then
		return
	end
	local nextStep = DollService.nextStepFor(dollId)
	if nextStep then
		locks[dollId] = { player = player, stepId = nextStep, expiry = os.clock() + Config.Care.MinigameSeconds }
		refreshPrompt(rec)
		-- SwiftHands class buff: shift-wide "<1 = faster" multiplier for MinigameController to apply
		fireTo(player, "MinigameStart", dollId, nextStep, math.random(1, 2 ^ 30), careSpeedMultiplier)
		return
	end
	-- 5 steps done: ribbon first if held, else pickup when unlocked
	if ribbonHolders[player] and not rec.ribbonTied then
		DollService.tieRibbon(player, dollId)
		return
	end
	if unlocked then
		DollService.pickup(player, dollId)
	end
end

function DollService.nextStepFor(dollId: string): string?
	local rec = dolls[dollId]
	if not rec then
		return nil
	end
	for _, step in CareSteps.list do
		if not rec.careDone[step.id] then
			return step.id
		end
	end
	return nil
end

function DollService.completeStep(player: Player, dollId: string, stepId: string)
	local rec = dolls[dollId]
	if not rec or rec.consumed then
		return
	end
	if DollService.nextStepFor(dollId) ~= stepId then
		return
	end
	rec.careDone[stepId] = true
	local doneList = {}
	for id in rec.careDone do
		table.insert(doneList, id)
	end
	local allDone = DollService.nextStepFor(dollId) == nil
	fire("DollUpdate", dollId, { careDone = doneList, done = allDone })
	refreshPrompt(rec)
	for _, cb in stepCallbacks do
		Util.safeCall("stepCallback", cb, player, dollId, stepId)
	end
end

function DollService.allListedCareDone(): boolean
	for _, rec in dolls do
		if not rec.consumed and DollService.nextStepFor(rec.id) ~= nil then
			return false
		end
	end
	return next(dolls) ~= nil
end

function DollService.tieRibbon(player: Player, dollId: string): boolean
	local rec = dolls[dollId]
	if not rec or rec.consumed or rec.ribbonTied then
		return false
	end
	if not ribbonHolders[player] then
		return false
	end
	if DollService.nextStepFor(dollId) ~= nil then
		return false
	end
	ribbonHolders[player] = nil
	rec.ribbonTied = true
	-- small visible ribbon on the doll
	local body = rec.model:FindFirstChild("Body")
	if body and body:IsA("BasePart") then
		local ribbon = Instance.new("Part")
		ribbon.Name = "Ribbon"
		ribbon.Anchored = true
		ribbon.CanCollide = false
		ribbon.Material = Enum.Material.Neon
		ribbon.Color = Color3.fromRGB(210, 215, 225)
		ribbon.Size = Vector3.new(1.7, 0.25, 1.05)
		ribbon.CFrame = body.CFrame * CFrame.new(0, 0.4, 0)
		ribbon.Parent = rec.model
	end
	fireTo(player, "DollUpdate", dollId, { ribbon = true })
	fireTo(player, "Toast", ("You tie the silver ribbon around %s."):format(rec.name), 3)
	refreshPrompt(rec)
	for _, cb in ribbonCallbacks do
		Util.safeCall("ribbonCallback", cb, player, dollId)
	end
	return true
end

function DollService.hasRibbon(dollId: string): boolean
	local rec = dolls[dollId]
	return rec ~= nil and rec.ribbonTied
end

-- grants a ribbon outside the spool-prompt flow (used by ClassService's StartWithRibbon buff at
-- ShiftIntro). Mirrors the spool-prompt Triggered handler in wireWorld() exactly.
function DollService.giveRibbon(player: Player): boolean
	ribbonHolders[player] = true
	fireTo(player, "Toast", "A silver ribbon is already tucked in your pocket.", 3)
	return true
end

function DollService.setUnlocked(state: boolean)
	unlocked = state
	refreshAllPrompts()
end

function DollService.pickup(player: Player, dollId: string): boolean
	local rec = dolls[dollId]
	if not rec or rec.consumed or carriers[player] then
		return false
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp or not hrp:IsA("BasePart") then
		return false
	end
	-- hide original
	for _, d in rec.model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = 1
		elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
			(d :: any).Enabled = false
		end
	end
	rec.prompt.Enabled = false
	-- visual clone, zero physics (R6)
	local clone = rec.model:Clone()
	clone.Name = "CarriedDoll"
	for _, d in clone:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = if d.Name == "Root" then 1 else 0
			d.Anchored = false
			d.Massless = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		elseif d:IsA("ProximityPrompt") then
			d:Destroy()
		elseif d:IsA("SurfaceGui") then
			d.Enabled = true
		elseif d:IsA("BillboardGui") then
			d.Enabled = false
		end
	end
	local cloneRoot = clone.PrimaryPart
	if not cloneRoot then
		clone:Destroy()
		return false
	end
	-- weld every part to the clone root, then root to carrier
	for _, d in clone:GetDescendants() do
		if d:IsA("BasePart") and d ~= cloneRoot then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = cloneRoot
			weld.Part1 = d
			weld.Parent = d
		end
	end
	clone:PivotTo(hrp.CFrame * CFrame.new(0, 0, -2.2))
	local carryWeld = Instance.new("WeldConstraint")
	carryWeld.Part0 = hrp
	carryWeld.Part1 = cloneRoot
	carryWeld.Parent = cloneRoot
	clone.Parent = char
	carriers[player] = { dollId = dollId, clone = clone }
	fireTo(player, "Toast", ("You pick up %s. Carry them to the Banish Box… if you're sure."):format(rec.name), 4)
	return true
end

function DollService.drop(player: Player)
	local carry = carriers[player]
	if not carry then
		return
	end
	carriers[player] = nil
	Util.safeCall("destroyCarryClone", function()
		carry.clone:Destroy()
	end)
	local rec = dolls[carry.dollId]
	if rec and not rec.consumed then
		for _, d in rec.model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Transparency = if d.Name == "Root" then 1 else 0
			elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
				(d :: any).Enabled = true
			end
		end
		refreshPrompt(rec)
	end
end

-- companion to consume() -- undoes a deposit-into-the-box WITHOUT destroying the doll, for the
-- "right doll, missing requirement" banish outcome (A4). Mirrors drop()'s restore logic but also
-- moves the model back to its bench slot, since deposit() PivotTo'd it into the Banish Box.
function DollService.returnToBench(dollId: string): boolean
	local rec = dolls[dollId]
	if not rec or rec.consumed then
		return false
	end
	rec.model:PivotTo(rec.resting)
	for _, d in rec.model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = if d.Name == "Root" then 1 else 0
		elseif d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
			(d :: any).Enabled = true
		end
	end
	refreshPrompt(rec)
	return true
end

function DollService.getCarried(player: Player): string?
	local carry = carriers[player]
	return carry and carry.dollId or nil
end

function DollService.isMarked(dollId: string): boolean
	local rec = dolls[dollId]
	return rec ~= nil and rec.marked
end

function DollService.getMarkedId(): string?
	for id, rec in dolls do
		if rec.marked and not rec.consumed then
			return id
		end
	end
	return nil
end

function DollService.getDisplayName(dollId: string): string
	local rec = dolls[dollId]
	return rec and rec.name or "???"
end

function DollService.getDollIds(): { string }
	local out = {}
	for _, id in dollOrder do
		if dolls[id] and not dolls[id].consumed then
			table.insert(out, id)
		end
	end
	return out
end

function DollService.getModel(dollId: string): Model?
	local rec = dolls[dollId]
	return rec and rec.model or nil
end

function DollService.hasActiveLock(): boolean
	return next(locks) ~= nil
end

function DollService.consume(dollId: string)
	local rec = dolls[dollId]
	if not rec or rec.consumed then
		return
	end
	rec.consumed = true
	rec.prompt.Enabled = false
	-- B8 fix: tell clients this doll is gone so Hud.luau's checklist panel stops showing it as a
	-- fully-cared-for, still-in-play doll.
	fire("DollUpdate", dollId, { removed = true })
	-- sink + fade
	local parts = {}
	for _, d in rec.model:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	for _, p in parts do
		TweenService:Create(p, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Transparency = 1,
			CFrame = p.CFrame * CFrame.new(0, -2, 0),
		}):Play()
	end
	task.delay(2, function()
		Util.safeCall("consumeDestroy", function()
			rec.model:Destroy()
		end)
	end)
end

function DollService.onStepCompleted(fn: (Player, string, string) -> ())
	table.insert(stepCallbacks, fn)
end

function DollService.onRibbonTied(fn: (Player, string) -> ())
	table.insert(ribbonCallbacks, fn)
end

-- ---------- tells (procedural motion) ----------

local function tweenPart(inst: Instance?, time: number, props: { [string]: any })
	if inst and inst:IsA("BasePart") then
		TweenService:Create(inst, TweenInfo.new(time, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), props):Play()
	end
end

function DollService.performTell(dollId: string, tellId: string): boolean
	local rec = dolls[dollId]
	if not rec or rec.consumed then
		return false
	end
	local model = rec.model
	local head = model:FindFirstChild("Head")

	if tellId == "HeadTurn" then
		if not (head and head:IsA("BasePart")) then
			return false
		end
		local original = head.CFrame
		tweenPart(head, 1.2, { CFrame = original * CFrame.Angles(0, math.rad(22), 0) })
		task.delay(2.4, function()
			tweenPart(model:FindFirstChild("Head"), 1.2, { CFrame = original })
		end)
		return true
	elseif tellId == "EyesFollow" then
		local target: BasePart? = nil
		local best = math.huge
		for _, player in Players:GetPlayers() do
			local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if hrp and hrp:IsA("BasePart") and head and head:IsA("BasePart") then
				local d = (hrp.Position - head.Position).Magnitude
				if d < best then
					best = d
					target = hrp
				end
			end
		end
		if not target or not (head and head:IsA("BasePart")) then
			return false
		end
		task.spawn(function()
			local t0 = os.clock()
			while os.clock() - t0 < 4 do
				local h = model:FindFirstChild("Head")
				if not (h and h:IsA("BasePart")) or rec.consumed then
					break
				end
				local dir = h.CFrame:PointToObjectSpace(target.Position)
				local px = math.clamp(0.5 + dir.X * 0.06, 0.2, 0.8)
				local py = math.clamp(0.5 - dir.Y * 0.05, 0.25, 0.75)
				for _, pupil in rec.pupils do
					pupil.Position = UDim2.fromScale(px, py)
				end
				task.wait(0.1)
			end
			for _, pupil in rec.pupils do
				pupil.Position = UDim2.fromScale(0.5, 0.5)
			end
		end)
		return true
	elseif tellId == "Scoot" then
		local offset = CFrame.new((math.random() - 0.5) * 3, 0, (math.random() - 0.5) * 1.2)
		rec.resting = rec.resting * offset
		model:PivotTo(rec.resting)
		return true
	elseif tellId == "MusicBoxTurn" then
		local crank = model:FindFirstChild("Crank")
		if not (crank and crank:IsA("BasePart")) then
			return false
		end
		task.spawn(function()
			for _ = 1, 10 do
				local c = model:FindFirstChild("Crank")
				if not (c and c:IsA("BasePart")) or rec.consumed then
					break
				end
				c.CFrame = c.CFrame * CFrame.Angles(math.rad(36), 0, 0)
				task.wait(0.5)
			end
		end)
		return true
	elseif tellId == "Slump" then
		local body = model:FindFirstChild("Body")
		if not (body and body:IsA("BasePart")) then
			return false
		end
		local angle = if rec.slumped then 0 else math.rad(12)
		rec.slumped = not rec.slumped
		tweenPart(body, 1.5, { CFrame = rec.resting * CFrame.new(0, 1.1, 0) * CFrame.Angles(0, 0, angle) })
		return true
	elseif tellId == "StitchMark" then
		local arm = model:FindFirstChild("ArmL")
		if not (arm and arm:IsA("BasePart")) then
			return false
		end
		if arm:FindFirstChild("StitchGui") then
			return false
		end
		local gui = Instance.new("SurfaceGui")
		gui.Name = "StitchGui"
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 100
		gui.Parent = arm
		for i = 1, 4 do
			local seg = Instance.new("Frame")
			seg.AnchorPoint = Vector2.new(0.5, 0.5)
			seg.Position = UDim2.fromScale(0.5 + (if i % 2 == 0 then 0.12 else -0.12), 0.2 + i * 0.15)
			seg.Size = UDim2.fromScale(0.4, 0.06)
			seg.Rotation = if i % 2 == 0 then 25 else -25
			seg.BackgroundColor3 = Color3.fromRGB(70, 30, 40)
			seg.BorderSizePixel = 0
			seg.Parent = gui
		end
		return true
	end
	return false
end

function DollService.clearShift()
	for _, rec in dolls do
		Util.safeCall("clearDoll", function()
			rec.model:Destroy()
		end)
	end
	dolls = {}
	dollOrder = {}
	locks = {}
	for player in carriers do
		DollService.drop(player)
	end
	carriers = {}
	ribbonHolders = {}
	unlocked = false
end

return DollService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">GlyphService</string>
            <string name="Source"><![CDATA[--!strict
-- Glyph tokens, the Spirit Compass tool, and the SHARED found-set + ledger slots.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Glyphs = require(Shared:WaitForChild("Defs"):WaitForChild("Glyphs")) :: any
local Draw = require(Shared:WaitForChild("Logic"):WaitForChild("Draw")) :: any

local GlyphService = {}

local ctx: any
local tokens: { [string]: { part: BasePart, glyphId: string, targetValue: Vector3Value } } = {}
local found: { string } = {}
local slots: { [number]: string? } = {}
local detectorTool: Tool? = nil
local generation = 0

local function broadcast(glyphId: string?, finder: string?)
	local slotsCopy: { any } = {}
	for i = 1, 3 do
		slotsCopy[i] = slots[i] or false -- false travels; nil holes don't
	end
	Remotes.get(Remotes.Names.GlyphFound):FireAllClients(glyphId, {
		found = table.clone(found),
		slots = slotsCopy,
		finder = finder,
	})
end

local function buildDetector(): Tool
	local tool = Instance.new("Tool")
	tool.Name = "Spirit Compass"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.8, 0.5, 1.4)
	handle.Color = Color3.fromRGB(120, 96, 60)
	handle.Material = Enum.Material.Metal
	handle.CanCollide = false
	handle.Parent = tool
	local needle = Instance.new("Part")
	needle.Name = "Needle"
	needle.Size = Vector3.new(0.1, 0.1, 0.9)
	needle.Color = Color3.fromRGB(200, 205, 215)
	needle.Material = Enum.Material.Neon
	needle.Massless = true
	needle.CanCollide = false
	needle.CFrame = handle.CFrame * CFrame.new(0, 0.35, 0)
	needle.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = needle
	weld.Parent = needle
	local light = Instance.new("PointLight")
	light.Name = "GlowLight"
	light.Color = Color3.fromRGB(180, 120, 255)
	light.Brightness = 0
	light.Range = 8
	light.Parent = handle
	local targets = Instance.new("Folder")
	targets.Name = "GlyphTargets"
	targets.Parent = tool
	return tool
end

local function placeDetectorAtRack()
	local tool = detectorTool
	if not tool then
		return
	end
	local rack = ctx.manifest.detectorRack
	if not rack then
		return
	end
	tool.Parent = workspace
	local handle = tool:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then
		handle.CFrame = rack.CFrame * CFrame.new(0, 3.6, 0)
		handle.Anchored = true
		-- prompt to take it (tools on the ground need touch; prompt is mobile-friendlier)
		if not handle:FindFirstChildOfClass("ProximityPrompt") then
			local p = Instance.new("ProximityPrompt")
			p.ActionText = "Take Spirit Compass"
			p.ObjectText = "Detector"
			p.RequiresLineOfSight = false
			p.MaxActivationDistance = Config.Care.PromptDistance
			p.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
			p.Parent = handle
			p.Triggered:Connect(function(player: Player)
				local t = detectorTool
				local h = t and t:FindFirstChild("Handle")
				if t and h and h:IsA("BasePart") and t.Parent == workspace then
					h.Anchored = false
					p.Enabled = false
					local backpack = player:FindFirstChildOfClass("Backpack")
					if backpack then
						t.Parent = backpack
						local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
						if humanoid then
							humanoid:EquipTool(t)
						end
					end
				end
			end)
		else
			local p = handle:FindFirstChildOfClass("ProximityPrompt")
			if p then
				p.Enabled = true
			end
		end
	end
end

function GlyphService.init(context: any)
	ctx = context
	if Config.Features.Detector then
		detectorTool = buildDetector()
		placeDetectorAtRack()
	end

	Remotes.get(Remotes.Names.SlotGlyph).OnServerEvent:Connect(function(_player: Player, slotIndex: any, glyphId: any)
		if typeof(slotIndex) ~= "number" or slotIndex < 1 or slotIndex > 3 or slotIndex % 1 ~= 0 then
			return
		end
		if glyphId == nil then
			slots[slotIndex] = nil
			broadcast(nil, nil)
			Util.safeCall("shiftObjectiveRefresh", function()
				ctx.services.ShiftManager.refreshObjective()
			end)
			return
		end
		if typeof(glyphId) ~= "string" or not table.find(found, glyphId) then
			return
		end
		slots[slotIndex] = glyphId
		broadcast(nil, nil)
		-- B2 fix: slotting into (or clearing from) the ledger can complete/break the spirit match.
		Util.safeCall("shiftObjectiveRefresh", function()
			ctx.services.ShiftManager.refreshObjective()
		end)
	end)

	-- re-rack the detector if its carrier leaves/dies
	Players.PlayerRemoving:Connect(function(player: Player)
		local tool = detectorTool
		if tool and (tool:IsDescendantOf(player) or (player.Character and tool:IsDescendantOf(player.Character))) then
			task.defer(placeDetectorAtRack)
		end
	end)
end

function GlyphService.startShift(spiritCode: { string }, rng: any)
	generation += 1
	GlyphService.stopShift()
	local myGen = generation
	local spawnParts = Draw.sample(rng, ctx.manifest.glyphSpawns, #spiritCode)
	for i, glyphId in spiritCode do
		local marker = spawnParts[i]
		if not marker then
			break
		end
		local tokenId = ("glyph_%d_%d"):format(myGen, i)
		local token = Instance.new("Part")
		token.Name = "GlyphToken"
		token.Shape = Enum.PartType.Ball
		token.Size = Vector3.new(0.9, 0.9, 0.9)
		token.Color = Color3.fromRGB(40, 30, 55)
		token.Material = Enum.Material.Neon
		token.Anchored = true
		token.CanCollide = false
		token.CFrame = marker.CFrame
		CollectionService:AddTag(token, "GlyphToken")
		token:SetAttribute("GlyphId", glyphId)
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(160, 110, 240)
		light.Brightness = 0.5
		light.Range = 6
		light.Parent = token
		TweenService:Create(
			token,
			TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ CFrame = marker.CFrame * CFrame.new(0, 0.8, 0) }
		):Play()
		local p = Instance.new("ProximityPrompt")
		p.ActionText = "Collect Glyph"
		p.ObjectText = "Strange Mark"
		p.RequiresLineOfSight = false
		p.MaxActivationDistance = Config.Glyphs.CollectDistance
		p.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
		p.Parent = token
		token.Parent = ctx.manifest.root

		local targetValue = Instance.new("Vector3Value")
		targetValue.Name = tokenId
		targetValue.Value = marker.CFrame.Position
		local tool = detectorTool
		if tool then
			local folder = tool:FindFirstChild("GlyphTargets")
			if folder then
				targetValue.Parent = folder
			end
		end

		tokens[tokenId] = { part = token, glyphId = glyphId, targetValue = targetValue }
		p.Triggered:Connect(function(player: Player)
			GlyphService.collect(player, tokenId)
		end)
	end
end

function GlyphService.collect(player: Player, tokenId: string)
	local token = tokens[tokenId]
	if not token then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hrp and hrp:IsA("BasePart")) then
		return
	end
	if (hrp.Position - token.part.Position).Magnitude > Config.Glyphs.CollectDistance + 4 then
		return
	end
	tokens[tokenId] = nil
	Util.safeCall("destroyToken", function()
		token.part:Destroy()
		token.targetValue:Destroy()
	end)
	if not table.find(found, token.glyphId) then
		table.insert(found, token.glyphId)
	end
	local glyphName = Glyphs.byId[token.glyphId] and Glyphs.byId[token.glyphId].name or token.glyphId
	broadcast(token.glyphId, player.DisplayName)
	Remotes.get(Remotes.Names.Toast):FireAllClients(("%s found a glyph: %s"):format(player.DisplayName, glyphName), 4)
	-- B2 fix: a glyph collect can flip the HUD objective (care -> glyphs -> ledger), but nothing
	-- told ShiftManager to recompute + rebroadcast it.
	Util.safeCall("shiftObjectiveRefresh", function()
		ctx.services.ShiftManager.refreshObjective()
	end)
end

function GlyphService.getSlots(): { [number]: string? }
	return table.clone(slots)
end

function GlyphService.getFound(): { string }
	return table.clone(found)
end

function GlyphService.stopShift()
	for _, token in tokens do
		Util.safeCall("stopToken", function()
			token.part:Destroy()
			token.targetValue:Destroy()
		end)
	end
	tokens = {}
	found = {}
	slots = {}
	broadcast(nil, nil)
	placeDetectorAtRack()
end

return GlyphService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">HauntService</string>
            <string name="Source"><![CDATA[--!strict
-- Haunt scheduler + world-scope event implementations. Every event pcall'd; per-event kill switches.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Haunts = require(Shared:WaitForChild("Defs"):WaitForChild("Haunts")) :: any
local Draw = require(Shared:WaitForChild("Logic"):WaitForChild("Draw")) :: any

local HauntService = {}

local ctx: any
local generation = 0
local currentTier = 0
local lastFired: { [string]: number } = {}
local participantsGetter: (() -> { Player })? = nil

local function randomParticipant(rng: any): Player?
	local list = if participantsGetter then participantsGetter() else Players:GetPlayers()
	return Draw.one(rng, list)
end

-- ---------- world event implementations ----------

local events: { [string]: (rng: any) -> () } = {}

events.BenchRattle = function(_rng)
	local bench = ctx.manifest.workbench
	if not bench then
		return
	end
	local original = bench.CFrame
	SoundKit.play("BenchRattle", bench)
	task.spawn(function()
		for _ = 1, 10 do
			bench.CFrame = original * CFrame.new((math.random() - 0.5) * 0.3, 0, (math.random() - 0.5) * 0.3)
			task.wait(0.12)
		end
		bench.CFrame = original
	end)
end

events.DoorCreakSlam = function(rng)
	local door = Draw.one(rng, ctx.manifest.hauntDoors)
	if not door or not door.PrimaryPart then
		return
	end
	local hinge = door.PrimaryPart
	local original = hinge.CFrame
	local opened = original * CFrame.Angles(0, math.rad(70), 0)
	local panel = door:FindFirstChild("Panel")
	local function setDoor(cf: CFrame)
		hinge.CFrame = cf
		if panel and panel:IsA("BasePart") then
			panel.CFrame = cf * CFrame.new(0, 0, 2)
		end
	end
	task.spawn(function()
		for i = 1, 30 do
			setDoor(original:Lerp(opened, i / 30))
			task.wait(0.1)
		end
		task.wait(0.4)
		SoundKit.play("DoorSlam", hinge)
		setDoor(original)
	end)
end

events.MusicBoxSwell = function(rng)
	local DollService = ctx.services.DollService
	local dollId = Draw.one(rng, DollService.getDollIds())
	if not dollId then
		return
	end
	DollService.performTell(dollId, "MusicBoxTurn")
	local model = DollService.getModel(dollId)
	local musicBox = model and model:FindFirstChild("MusicBox")
	if musicBox then
		local sound = SoundKit.attach("MusicBoxLoop", musicBox)
		if sound then
			sound:Play()
			task.delay(6, function()
				sound:Destroy()
			end)
		end
	end
end

events.SilhouetteDoorway = function(rng)
	local door = Draw.one(rng, ctx.manifest.hauntDoors)
	if not door or not door.PrimaryPart then
		return
	end
	local target = randomParticipant(rng)
	local lookAt = if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
		then (target.Character:FindFirstChild("HumanoidRootPart") :: BasePart).Position
		else door.PrimaryPart.Position + door.PrimaryPart.CFrame.LookVector * 10
	local base = door.PrimaryPart.Position
	local figure = Instance.new("Model")
	figure.Name = "Silhouette"
	local function fp(size: Vector3, offset: Vector3)
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Material = Enum.Material.SmoothPlastic
		p.Color = Color3.fromRGB(8, 6, 10)
		p.Size = size
		p.CFrame = CFrame.lookAt(Vector3.new(base.X, 0, base.Z) + Vector3.new(0, offset.Y, 0), Vector3.new(lookAt.X, offset.Y, lookAt.Z)) * CFrame.new(offset.X, 0, offset.Z)
		p.Parent = figure
	end
	fp(Vector3.new(1.6, 4.4, 0.9), Vector3.new(0, 3.4, 0)) -- body
	fp(Vector3.new(1.1, 1.1, 0.9), Vector3.new(0, 6.2, 0)) -- head
	figure.Parent = ctx.manifest.root
	task.delay(1.2, function()
		figure:Destroy()
	end)
end

events.WindowFigure = function(rng)
	local pane = Draw.one(rng, ctx.manifest.windowPanes)
	if not pane then
		return
	end
	local figure = Instance.new("Part")
	figure.Anchored = true
	figure.CanCollide = false
	figure.CanQuery = false
	figure.Material = Enum.Material.SmoothPlastic
	figure.Color = Color3.fromRGB(5, 4, 8)
	figure.Size = Vector3.new(2, 5, 0.4)
	figure.CFrame = pane.CFrame * CFrame.new(0, -0.5, -1)
	figure.Parent = ctx.manifest.root
	task.delay(1.5, function()
		figure:Destroy()
	end)
end

events.DollHeadSnap = function(rng)
	local DollService = ctx.services.DollService
	local dollId = Draw.one(rng, DollService.getDollIds())
	if dollId then
		DollService.performTell(dollId, "HeadTurn")
	end
end

events.LightsOutBeat = function(_rng)
	local lamps = ctx.manifest.lamps
	SoundKit.play("LightsOut")
	local lights: { Light } = {}
	for _, lamp in lamps do
		local light = lamp:FindFirstChildOfClass("PointLight")
		if light then
			light.Enabled = false
			table.insert(lights, light)
		end
	end
	task.delay(2.5, function()
		for _, light in lights do
			light.Enabled = true
		end
	end)
end

-- ---------- scheduler ----------

function HauntService.init(context: any)
	ctx = context
end

function HauntService.setParticipantsGetter(fn: () -> { Player })
	participantsGetter = fn
end

function HauntService.setTier(tier: number)
	currentTier = tier
end

function HauntService.force(hauntId: string, rng: any)
	local def = Haunts.byId[hauntId]
	if not def then
		return
	end
	lastFired[hauntId] = os.clock()
	if def.scope == "world" then
		local impl = events[hauntId]
		if impl then
			Util.safeCall("haunt:" .. hauntId, impl, rng)
		end
	else
		if hauntId == "Taken" then
			if not Config.Features.Taken then
				return
			end
			local list = if participantsGetter then participantsGetter() else Players:GetPlayers()
			if #list <= 1 then
				return -- never solo
			end
		end
		local target = randomParticipant(rng)
		if target then
			Remotes.get(Remotes.Names.HauntFired):FireClient(target, hauntId, {})
		end
	end
end

function HauntService.startShift(rng: any)
	generation += 1
	local myGen = generation
	lastFired = {}
	task.spawn(function()
		while generation == myGen do
			task.wait(Config.Haunts.MinSecondsBetween + rng:NextNumber() * 15)
			if generation ~= myGen then
				break
			end
			if not Config.Haunts.Enabled or currentTier < 1 then
				continue
			end
			if ctx.services.DollService.hasActiveLock() then
				continue
			end
			local now = os.clock()
			local candidates = {}
			for _, def in Haunts.list do
				local enabled = Config.Haunts.Events[def.id] ~= false
				local offCooldown = (now - (lastFired[def.id] or -math.huge)) >= def.cooldown
				if enabled and offCooldown and def.tier <= currentTier then
					table.insert(candidates, { id = def.id, weight = def.weight })
				end
			end
			local pick = Draw.weighted(rng, candidates)
			if pick then
				HauntService.force(pick, rng)
			end
		end
	end)
end

function HauntService.stopShift()
	generation += 1
	currentTier = 0
end

return HauntService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">JoinSquareService</string>
            <string name="Source"><![CDATA[--!strict
-- JoinSquareService: lobby floor-tile "join squares" (Animal-Hospital-style party assembly).
-- Each tagged part fills with 1..MaxGroupSize players, runs a countdown once the first player
-- steps on, then hands the group off to a shift -- either a fresh private reserved server (live)
-- or the existing in-place ShiftIntro flow (Studio / Config.Features.PrivateShiftServers=false).
-- Also owns the RECEIVING side of that handoff: in a live reserved shift server (no lobby, no
-- squares exist there) it waits for the expected arrivals and starts the shift the same way.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local ServerKind = require(Shared:WaitForChild("ServerKind")) :: any

local JOIN_SQUARE_TAG = "JoinSquare"

local JoinSquareService = {}

local ctx: any

type Phase = "Idle" | "Waiting" | "Locking"

type SquareState = {
	id: string,
	part: BasePart,
	occupants: { Player },
	phase: Phase,
	countdownGen: number,
	countdownActive: boolean,
}

local squares: { [BasePart]: SquareState } = {}

-- ---------- visuals ----------

local function colorFor(phase: Phase): Color3
	if phase == "Idle" then
		return Config.JoinSquares.IdleColor
	elseif phase == "Waiting" then
		return Config.JoinSquares.OccupiedColor
	else
		return Config.JoinSquares.LockingColor
	end
end

local function ensureLabel(square: SquareState): TextLabel
	local part = square.part
	local billboard = part:FindFirstChild("JoinSquareGui")
	if not billboard then
		local b = Instance.new("BillboardGui")
		b.Name = "JoinSquareGui"
		b.Adornee = part
		b.Size = UDim2.new(0, 160, 0, 60)
		b.StudsOffset = Vector3.new(0, 4, 0)
		b.MaxDistance = Config.JoinSquares.BillboardMaxDistance
		b.AlwaysOnTop = true
		b.Parent = part
		local label = Instance.new("TextLabel")
		label.Name = "Count"
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(1, 0, 1, 0)
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(235, 228, 210)
		label.TextStrokeTransparency = 0.3
		label.Parent = b
		billboard = b
	end
	return (billboard :: BillboardGui):FindFirstChild("Count") :: TextLabel
end

local function refreshVisual(square: SquareState)
	square.part.Color = colorFor(square.phase)
	local label = ensureLabel(square)
	label.Text = ("%d/%d"):format(#square.occupants, Config.JoinSquares.MaxGroupSize)
end

-- ---------- broadcasts ----------

local function broadcastOccupancy(square: SquareState)
	local ids: { number } = {}
	for _, plr in square.occupants do
		table.insert(ids, plr.UserId)
	end
	Remotes.get(Remotes.Names.JoinSquareUpdate):FireAllClients(square.id, {
		count = #square.occupants,
		max = Config.JoinSquares.MaxGroupSize,
		occupantUserIds = ids,
		phase = square.phase,
	})
end

local function cancelCountdown(square: SquareState)
	local wasActive = square.countdownActive
	square.countdownActive = false
	square.countdownGen += 1 -- invalidates any in-flight countdown loop (see startCountdown)
	if wasActive then
		Remotes.get(Remotes.Names.JoinSquareCountdown):FireAllClients(square.id, nil)
	end
end

local function resetSquare(square: SquareState)
	square.occupants = {}
	square.phase = "Idle"
	cancelCountdown(square)
	broadcastOccupancy(square)
	refreshVisual(square)
end

-- ---------- resolve: Start Now, countdown hits zero, or auto-full ----------

local function resolveSquare(square: SquareState)
	if #square.occupants == 0 then
		return
	end
	cancelCountdown(square)
	square.phase = "Locking"
	broadcastOccupancy(square)
	refreshVisual(square)

	local occupants = table.clone(square.occupants)

	local function revertToWaiting(message: string)
		for _, plr in occupants do
			if plr.Parent then
				Remotes.get(Remotes.Names.Toast):FireClient(plr, message, 4)
			end
		end
		square.phase = "Waiting"
		broadcastOccupancy(square)
		refreshVisual(square)
	end

	if ServerKind.isSameServerMode() then
		-- Studio, or the live emergency kill switch: reuse ShiftManager's existing flow in-place.
		local ok = Util.safeCall("joinSquareBeginInPlace:" .. square.id, function()
			local started = ctx.services.ShiftManager.beginShiftFor(occupants)
			if not started then
				error("beginShiftFor declined -- ShiftManager state was not LobbyIdle")
			end
		end)
		if ok then
			resetSquare(square)
		else
			revertToWaiting("A shift is already starting elsewhere -- try again in a moment.")
		end
		return
	end

	-- Live: real cross-server private teleport.
	local userIds: { number } = {}
	for _, plr in occupants do
		table.insert(userIds, plr.UserId)
	end
	local teleportOptions = Instance.new("TeleportOptions")
	teleportOptions.ShouldReserveServer = true
	teleportOptions:SetTeleportData({
		kind = "Shift",
		squareId = square.id,
		expectedUserIds = userIds,
	})
	local ok = Util.safeCall("joinSquareTeleport:" .. square.id, function()
		TeleportService:TeleportAsync(game.PlaceId, occupants, teleportOptions)
	end)
	if ok then
		-- Occupants are leaving this server. Reset now rather than waiting for the next poll tick
		-- / PlayerRemoving to notice, so the tile doesn't sit "full" for stragglers mid-loading-screen.
		resetSquare(square)
	else
		revertToWaiting("Couldn't start the shift -- try again.")
	end
end

-- ---------- countdown ----------

local function startCountdown(square: SquareState)
	if square.countdownActive then
		return
	end
	square.countdownActive = true
	square.countdownGen += 1
	local gen = square.countdownGen
	task.spawn(function()
		for remaining = Config.JoinSquares.CountdownSeconds, 1, -1 do
			if square.countdownGen ~= gen then
				return -- cancelled (square emptied) or resolved (Start Now / auto-full) elsewhere
			end
			Remotes.get(Remotes.Names.JoinSquareCountdown):FireAllClients(square.id, remaining)
			task.wait(1)
		end
		if square.countdownGen == gen then
			resolveSquare(square)
		end
	end)
end

-- ---------- occupancy polling (LobbyService's ready-pad idiom, generalized to N squares) ----------

local function standingOn(part: BasePart): { Player }
	local size = Vector3.new(part.Size.X, Config.JoinSquares.DetectHeightPadding, part.Size.Z)
	local center = part.Position + Vector3.new(0, size.Y / 2, 0)
	local hits = workspace:GetPartBoundsInBox(CFrame.new(center), size)
	local seen: { [Player]: boolean } = {}
	local standing: { Player } = {}
	for _, hit in hits do
		local char = hit:FindFirstAncestorOfClass("Model")
		if char then
			local player = Players:GetPlayerFromCharacter(char)
			if player and not seen[player] then
				seen[player] = true
				table.insert(standing, player)
			end
		end
	end
	return standing
end

local function sameOccupants(a: { Player }, b: { Player }): boolean
	if #a ~= #b then
		return false
	end
	for i, plr in a do
		if b[i] ~= plr then
			return false
		end
	end
	return true
end

local function refreshSquare(square: SquareState)
	local newOccupants = standingOn(square.part)
	local wasEmpty = #square.occupants == 0
	local nowEmpty = #newOccupants == 0
	local changed = not sameOccupants(square.occupants, newOccupants)

	square.occupants = newOccupants

	if wasEmpty and not nowEmpty then
		square.phase = "Waiting"
		startCountdown(square) -- starts ONLY on first entrant into an empty square, per spec
	elseif not wasEmpty and nowEmpty then
		resetSquare(square) -- last occupant left (Exit button OR walked off) -- full reset
		return
	end

	if changed then
		broadcastOccupancy(square)
		refreshVisual(square)
	end

	if not nowEmpty
		and Config.JoinSquares.AutoStartOnFull
		and square.countdownActive
		and #square.occupants >= Config.JoinSquares.MaxGroupSize
	then
		resolveSquare(square)
	end
end

local function pollLoop()
	while true do
		task.wait(Config.JoinSquares.PollIntervalSeconds)
		for _, square in squares do
			Util.safeCall("joinSquarePoll:" .. square.id, refreshSquare, square)
		end
	end
end

-- ---------- square lifecycle ----------

local function registerSquare(inst: Instance)
	if not inst:IsA("BasePart") then
		return
	end
	if squares[inst] then
		return
	end
	local id = if inst.Name ~= "" then inst.Name else inst:GetDebugId()
	local square: SquareState = {
		id = id,
		part = inst,
		occupants = {},
		phase = "Idle",
		countdownGen = 0,
		countdownActive = false,
	}
	squares[inst] = square
	refreshVisual(square)
end

local function unregisterSquare(inst: Instance)
	local square = squares[inst :: BasePart]
	if square then
		cancelCountdown(square)
		squares[inst :: BasePart] = nil
	end
end

local function findSquareById(id: string): SquareState?
	for _, square in squares do
		if square.id == id then
			return square
		end
	end
	return nil
end

local function handleExit(player: Player, square: SquareState)
	local idx = table.find(square.occupants, player)
	if not idx then
		return
	end
	table.remove(square.occupants, idx)
	if #square.occupants == 0 then
		resetSquare(square)
	else
		broadcastOccupancy(square)
		refreshVisual(square)
	end
end

local function onJoinSquareAction(player: Player, squareId: any, action: any)
	if typeof(squareId) ~= "string" or typeof(action) ~= "string" then
		return
	end
	local square = findSquareById(squareId)
	if not square then
		return
	end
	if not table.find(square.occupants, player) then
		return -- server-authoritative: reject actions from players not actually standing here
	end
	if action == "Exit" then
		handleExit(player, square)
	elseif action == "StartNow" then
		resolveSquare(square)
	elseif action == "SkipTutorial" then
		Util.safeCall("joinSquareSkipTutorial", function()
			-- TODO(integration): see PACKET_1_LOBBY_SYSTEMS.md "READ THIS FIRST" §5 -- there is no
			-- TutorialService in this packet; the Social track's tutorial-gate design deliberately
			-- has no separate skippable flow. Resolve per the team's decision there before wiring
			-- this to a real function.
			if ctx.services.TutorialService and ctx.services.TutorialService.setSkipped then
				ctx.services.TutorialService.setSkipped(player)
			end
		end)
	end
end

-- ---------- receiving side: bootstrap a fresh reserved shift server ----------

local function bootstrapReservedServer()
	local expectedUserIds: { number }? = nil
	local started = false

	local function tryStart()
		if started or expectedUserIds == nil then
			return
		end
		local current = Players:GetPlayers()
		if #current >= #(expectedUserIds :: { number }) then
			started = true
			Util.safeCall("joinSquareBootstrapBegin", function()
				ctx.services.ShiftManager.beginShiftFor(current)
			end)
		end
	end

	local function captureTeleportData(player: Player)
		if expectedUserIds ~= nil then
			return
		end
		local ok, joinData = pcall(function()
			return player:GetJoinData()
		end)
		local data = (ok and joinData and joinData.TeleportData) :: any
		if typeof(data) == "table" and typeof(data.expectedUserIds) == "table" then
			expectedUserIds = data.expectedUserIds :: { number }
			-- R2 watchdog: start with whoever actually made it, even if the group arrives short.
			task.delay(Config.JoinSquares.ArrivalWatchdogSeconds, tryStart)
		end
	end

	for _, player in Players:GetPlayers() do
		captureTeleportData(player)
	end
	Players.PlayerAdded:Connect(function(player)
		captureTeleportData(player)
		task.defer(tryStart)
	end)
	task.defer(tryStart)
end

-- ---------- public API ----------

function JoinSquareService.init(context: any)
	ctx = context
	if not Config.Features.JoinSquares then
		return
	end

	if ServerKind.isReservedShiftServer() then
		bootstrapReservedServer()
		return -- no JoinSquare-tagged parts exist in a workshop-only server; nothing else to do
	end

	for _, inst in CollectionService:GetTagged(JOIN_SQUARE_TAG) do
		registerSquare(inst)
	end
	CollectionService:GetInstanceAddedSignal(JOIN_SQUARE_TAG):Connect(registerSquare)
	CollectionService:GetInstanceRemovedSignal(JOIN_SQUARE_TAG):Connect(unregisterSquare)

	Players.PlayerRemoving:Connect(function(player)
		for _, square in squares do
			if table.find(square.occupants, player) then
				handleExit(player, square)
			end
		end
	end)

	Remotes.get(Remotes.Names.JoinSquareAction).OnServerEvent:Connect(onJoinSquareAction)

	task.spawn(pollLoop)
end

-- Called by ShiftManager's RunEnd branch when a live reserved shift server's run ends, to hand
-- the group back to the public lobby. No-op in same-server mode -- ShiftManager's own existing
-- in-place teleport-to-lobbySpawn already covers that case.
function JoinSquareService.sendGroupHome(players: { Player })
	if #players == 0 or ServerKind.isSameServerMode() then
		return
	end
	local ok = Util.safeCall("joinSquareSendHome", function()
		TeleportService:TeleportAsync(game.PlaceId, players)
	end)
	if not ok then
		for _, plr in players do
			if plr.Parent then
				Remotes.get(Remotes.Names.Toast):FireClient(
					plr,
					"Couldn't return to the lobby automatically -- try rejoining.",
					6
				)
			end
		end
	end
end

return JoinSquareService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">LobbyService</string>
            <string name="Source"><![CDATA[--!strict
-- Lobby: head billboards (social proof), leaderboard board, ready pad polling, spawn toggling.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Classes = require(Shared:WaitForChild("Defs"):WaitForChild("Classes")) :: any

local LobbyService = {}

local ctx: any

local function attachBillboard(player: Player, char: Model)
	local head = char:WaitForChild("Head", 10)
	if not (head and head:IsA("BasePart")) then
		return
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "StatsTag"
	billboard.Adornee = head
	billboard.Size = UDim2.new(0, 170, 0, 56)
	billboard.StudsOffset = Vector3.new(0, 2.4, 0)
	billboard.MaxDistance = Config.Lobby.BillboardMaxDistance
	billboard.AlwaysOnTop = false
	billboard.Parent = head
	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Size = UDim2.new(1, 0, 0.4, 0)
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.fromRGB(235, 228, 210)
	nameLabel.TextStrokeTransparency = 0.5
	nameLabel.Text = player.DisplayName
	nameLabel.Parent = billboard
	local statsLabel = Instance.new("TextLabel")
	statsLabel.Name = "Stats"
	statsLabel.BackgroundTransparency = 1
	statsLabel.Position = UDim2.new(0, 0, 0.4, 0)
	statsLabel.Size = UDim2.new(1, 0, 0.6, 0)
	statsLabel.Font = Enum.Font.Garamond
	statsLabel.TextScaled = true
	statsLabel.TextColor3 = Color3.fromRGB(190, 170, 210)
	statsLabel.TextStrokeTransparency = 0.6
	statsLabel.Parent = billboard
	LobbyService.refreshBillboard(player)
end

function LobbyService.refreshBillboard(player: Player)
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	local billboard = head and head:FindFirstChild("StatsTag")
	local label = billboard and billboard:FindFirstChild("Stats")
	if label and label:IsA("TextLabel") then
		local stats = ctx.services.DataService.getStats(player)
		-- Reference screenshots: "Top Shift: N" plus the equipped class name underneath, in place
		-- of a second numeric stat.
		local equippedId = ctx.services.ClassService.getEquippedId(player)
		local className = (Classes.byId[equippedId] and Classes.byId[equippedId].name) or "Apprentice"
		label.Text = ("Top Shift: %d\n%s"):format(stats.bestShift, className)
	end
end

-- Reference screenshots show TWO separate boards flanking the Shop, not one combined board:
-- "Highest Shift" (bestShift) and "Patients Treated" (dollsCleared). B1's facing fix is baked in
-- here too -- both boards sit at HUB Z=29.4 with no rotation, and every player position in the Plaza
-- is south of that (Z < 30.5, sealed by the guard wall in MapBuilder's Plaza segment), so the
-- readable SurfaceGui face must point toward -Z, which is Enum.NormalId.Front for an unrotated part.
local function buildBoard(board: BasePart, title: string, rows: { { name: string, value: number } })
	local existing = board:FindFirstChild("BoardGui")
	local gui: SurfaceGui
	if existing and existing:IsA("SurfaceGui") then
		gui = existing
	else
		gui = Instance.new("SurfaceGui")
		gui.Name = "BoardGui"
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.Parent = board
		local layout = Instance.new("UIListLayout")
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.VerticalAlignment = Enum.VerticalAlignment.Top
		layout.Padding = UDim.new(0, 4)
		layout.Parent = gui
	end
	for _, child in gui:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local function addRow(text: string, size: number, color: Color3)
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(0.9, 0, 0, size + 6)
		label.Font = Enum.Font.Garamond
		label.TextSize = size
		label.TextColor3 = color
		label.Text = text
		label.Parent = gui
	end
	addRow(title, 36, Color3.fromRGB(226, 216, 196))
	for i = 1, math.min(#rows, 8) do
		addRow(("%d.  %s — %d"):format(i, rows[i].name, rows[i].value), 26, Color3.fromRGB(190, 170, 210))
	end
end

local function refreshLeaderboard()
	local shiftBoard = ctx.manifest.leaderboardBoard
	local patientsBoard = ctx.manifest.patientsBoard
	if not shiftBoard and not patientsBoard then
		return
	end
	local shiftRows: { { name: string, value: number } } = {}
	local dollRows: { { name: string, value: number } } = {}
	for _, player in Players:GetPlayers() do
		local stats = ctx.services.DataService.getStats(player)
		table.insert(shiftRows, { name = player.DisplayName, value = stats.bestShift })
		table.insert(dollRows, { name = player.DisplayName, value = stats.dollsCleared })
	end
	table.sort(shiftRows, function(a, b)
		return a.value > b.value
	end)
	table.sort(dollRows, function(a, b)
		return a.value > b.value
	end)
	if shiftBoard then
		buildBoard(shiftBoard, "HIGHEST SHIFT", shiftRows)
	end
	if patientsBoard then
		buildBoard(patientsBoard, "PATIENTS TREATED", dollRows)
	end
end

function LobbyService.init(context: any)
	ctx = context

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function(char)
			task.defer(attachBillboard, player, char)
		end)
		task.defer(refreshLeaderboard)
	end)
	for _, player in Players:GetPlayers() do
		player.CharacterAdded:Connect(function(char)
			task.defer(attachBillboard, player, char)
		end)
		if player.Character then
			task.defer(attachBillboard, player, player.Character)
		end
	end
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshLeaderboard)
	end)

	ctx.services.DataService.onStatsChanged(function(player: Player)
		LobbyService.refreshBillboard(player)
		refreshLeaderboard()
	end)

	-- ready pad polling at 2 Hz
	task.spawn(function()
		while true do
			task.wait(0.5)
			local pad = ctx.manifest.readyPad
			if not pad then
				continue
			end
			local standing: { Player } = {}
			local parts = workspace:GetPartBoundsInBox(
				CFrame.new(pad.Position + Vector3.new(0, 3, 0)),
				Vector3.new(12, 7, 12)
			)
			local seen: { [Player]: boolean } = {}
			for _, part in parts do
				local char = part:FindFirstAncestorOfClass("Model")
				if char then
					local player = Players:GetPlayerFromCharacter(char)
					if player and not seen[player] then
						seen[player] = true
						table.insert(standing, player)
					end
				end
			end
			Util.safeCall("requestStart", function()
				ctx.services.ShiftManager.requestStart(standing)
			end)
		end
	end)
end

function LobbyService.setShiftSpawnActive(active: boolean)
	local manifest = ctx.manifest
	if manifest.workshopSpawn then
		manifest.workshopSpawn.Enabled = active
	end
	if manifest.lobbySpawn then
		manifest.lobbySpawn.Enabled = not active
	end
end

return LobbyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">MapBuilder</string>
            <string name="Source"><![CDATA[--!strict
-- Builds the entire world from parts at server start (edit mode shows an empty baseplate — expected).
-- Per-room pcall segments: one broken room can't blank the world (plan review fix).
--
-- REDESIGNED per docs/packets/PACKET_1_MAP_DESIGN.md §4 ("Hollow Square" synthesis): a dead Victorian
-- town square (Hub) around a broken fountain, facing the Dollmaker's shop, with a plus-shaped Workshop
-- reached only by ShiftManager's existing ShiftIntro teleport (no walked corridor). Two structural
-- decisions eliminate the exact bug class the first playtest found (A1 sealed room / A2 void gaps),
-- BY CONSTRUCTION rather than by careful gap-matching:
--   1. The Workshop is two overlapping full-footprint floor/ceiling slabs with walls ONLY on the
--      outer perimeter of the plus-shape -- there are no interior walls anywhere to misalign a gap in.
--   2. The Hub's Shop/Classes/Apothecary buildings are solid, unopened facades (no door/window cut
--      through a wall at all) with mounted decorative props and a ProximityPrompt -- players never
--      walk into them, so there is no interior to seal off or leave a hole in.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local ServerKind = require(Shared:WaitForChild("ServerKind")) :: any

local MapBuilder = {}

local WOOD = Color3.fromRGB(62, 44, 32)
local WOOD_DARK = Color3.fromRGB(41, 29, 22)
local WALL = Color3.fromRGB(74, 62, 56)
local FLOOR = Color3.fromRGB(52, 40, 34)
local ACCENT = Color3.fromRGB(120, 96, 60)
local STONE = Color3.fromRGB(88, 86, 92)
local BOARD_WOOD = Color3.fromRGB(58, 42, 34)

local root: Folder

local function part(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.WoodPlanks
	p.Color = WOOD
	for k, v in props do
		if k == "Tag" then
			CollectionService:AddTag(p, v)
		else
			(p :: any)[k] = v
		end
	end
	p.Parent = props.Parent or root
	return p
end

local function box(cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, name: string?): Part
	return part({
		Name = name or "Part",
		CFrame = cf,
		Size = size,
		Color = color,
		Material = material or Enum.Material.WoodPlanks,
	})
end

-- Invisible collision-only boundary (R2/A2-class-bug prevention: keeps players from ever walking
-- off the Hub's open-sky Plaza/Alley into the void).
local function guardWall(cf: CFrame, size: Vector3)
	part({
		Name = "HubBoundary",
		CFrame = cf,
		Size = size,
		Transparency = 1,
		CanCollide = true,
		CanQuery = false,
	})
end

local function lamp(pos: Vector3, flicker: boolean?): Part
	local base = part({
		Name = "Lamp",
		CFrame = CFrame.new(pos),
		Size = Vector3.new(0.8, 2.2, 0.8),
		Color = ACCENT,
		Material = Enum.Material.Metal,
		Tag = if flicker then "Lamp" else nil, -- HauntService's LightsOutBeat toggles every Lamp-tagged
			-- light; Hub decorative lamps deliberately DON'T carry this tag (see hubLamp() below) so a
			-- haunt firing during someone else's shift can't plunge waiting players into darkness. This
			-- helper is now Workshop-only; see hubLamp() for the Hub's lamps.
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 190, 120)
	light.Brightness = 1.4
	light.Range = 16
	light.Shadows = true
	light.Parent = base
	return base
end

-- Hub-only lamp: same visual, but NEVER tagged "Lamp" (see note above) so HauntService's
-- LightsOutBeat, which only fires during an active Workshop shift, can't affect the Hub. `flicker`
-- gives it a small continuous brightness wobble (graft #1: flicker stays confined to the Entry
-- Alley's one hero lamp; the Plaza's corner lamps stay steady for join-square legibility).
local function hubLamp(pos: Vector3, flicker: boolean?): Part
	local base = part({
		Name = "HubLamp",
		CFrame = CFrame.new(pos),
		Size = Vector3.new(0.8, 2.2, 0.8),
		Color = ACCENT,
		Material = Enum.Material.Metal,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 190, 120)
	light.Brightness = 1.4
	light.Range = 18
	light.Shadows = true
	light.Parent = base
	if flicker then
		task.spawn(function()
			while base.Parent do
				light.Brightness = 0.5 + math.random() * 1.1
				task.wait(0.15 + math.random() * 0.35)
			end
		end)
	end
	return base
end

local function surfaceText(parent: Part, face: Enum.NormalId, lines: { { text: string, size: number, color: Color3? } })
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.Parent = parent
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.Padding = UDim.new(0, 8)
	layout.Parent = gui
	for _, line in lines do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(0.92, 0, 0, line.size + 8)
		label.Font = Enum.Font.Garamond
		label.TextSize = line.size
		label.TextWrapped = true
		label.TextColor3 = line.color or Color3.fromRGB(226, 216, 196)
		label.Text = line.text
		label.Parent = gui
	end
	return gui
end

local function prompt(parentPart: Part, action: string, object: string, holdSeconds: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.RequiresLineOfSight = false
	p.MaxActivationDistance = Config.Care.PromptDistance
	p.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	p.HoldDuration = holdSeconds or 0
	p.Parent = parentPart
	return p
end

-- A lit window: a glass pane + interior PointLight + doll-silhouette props behind the glass
-- (graft #2 from the map-design judge pass). Mounted ON the wall's outer surface -- never cut
-- through it, so it can't reproduce the A1/A2 gap-bug class.
local function litWindow(cf: CFrame, silhouetteCount: number?)
	local pane = part({
		Name = "WindowPane",
		CFrame = cf,
		Size = Vector3.new(5, 5, 0.2),
		Color = Color3.fromRGB(150, 170, 220),
		Material = Enum.Material.Glass,
		Transparency = 0.35,
		CanCollide = false,
		Tag = "WindowPane",
	})
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 200, 140)
	glow.Brightness = 1.2
	glow.Range = 10
	glow.Parent = pane
	for i = 1, (silhouetteCount or 2) do
		box(
			cf * CFrame.new(-1.4 + (i - 1) * 1.6, -0.6, 0.3),
			Vector3.new(0.8, 1.8, 0.4),
			Color3.fromRGB(20, 16, 22),
			Enum.Material.SmoothPlastic,
			"DollSilhouette"
		)
	end
	return pane
end

-- Two overlapping full-footprint slabs (a plus-shape floor/ceiling) with NO interior walls -- the
-- direct A1/A2 fix. `arms` is a list of {center, footprint} boxes; every arm must be listed BEFORE
-- any perimeter wall is built, and any two arms that should connect must overlap by several studs
-- (not just touch edges) so there's never a seam a player can fall through.
local function plusSlab(arms: { { center: Vector3, footprint: Vector3 } }, height: number)
	for _, arm in arms do
		box(CFrame.new(arm.center) * CFrame.new(0, -0.5, 0), arm.footprint, FLOOR, Enum.Material.Wood, "Floor")
		box(CFrame.new(arm.center) * CFrame.new(0, height + 0.5, 0), arm.footprint, WOOD_DARK, Enum.Material.Wood, "Ceiling")
	end
end

-- Layout origins: Hub around world origin; Workshop far away (never walked to, only reached via
-- ShiftManager's ShiftIntro teleport) so the two zones never visually or physically overlap.
-- StreamingEnabled stays false (R8), so the distance costs nothing at runtime.
local HUB = Vector3.new(0, 0, 0)
local WS = Vector3.new(0, 0, 600)
local H_HUB = 16 -- Hub building height
local H_WS = 14 -- Workshop interior height

function MapBuilder.build(): (any, { string })
	local failures: { string } = {}
	local manifest: any = {
		benchSlots = {},
		glyphSpawns = {},
		lamps = {},
		hauntDoors = {},
		windowPanes = {},
		joinSquares = {},
	}

	root = Instance.new("Folder")
	root.Name = "PorcelainMap"
	root.Parent = workspace
	manifest.root = root

	local function segment(name: string, fn: () -> ...any)
		local ok, err = pcall(fn)
		if not ok then
			table.insert(failures, name)
			Util.warn(("MapBuilder segment '%s' FAILED: %s"):format(name, tostring(err)))
		end
	end

	-- One-Place-plus-ReserveServer topology (PACKET_1_LOBBY_SYSTEMS.md, Join Squares §2): a live
	-- reserved shift server has no players walking the Hub and a public lobby server never runs a
	-- shift in-place, so each server kind only needs to build the half of the map it will actually
	-- use. Both halves always build in Studio (ServerKind.isSameServerMode() is always true there),
	-- so this has zero effect on today's Studio playtest.
	local buildLobby = ServerKind.isSameServerMode() or ServerKind.isPublicLobbyServer()
	local buildWorkshop = ServerKind.isSameServerMode() or ServerKind.isReservedShiftServer()

	-- ============================== HUB ==============================
	if buildLobby then

	segment("EntryAlley", function()
		local center = HUB + Vector3.new(0, 0, -42)
		box(CFrame.new(center) * CFrame.new(0, -0.5, 0), Vector3.new(10, 1, 24), FLOOR, Enum.Material.Concrete, "Floor")
		-- side walls (full length -- alley is only open at its two short ends)
		box(CFrame.new(center + Vector3.new(-5, H_HUB / 2, 0)), Vector3.new(1, H_HUB, 24), WALL, Enum.Material.Brick, "Wall")
		box(CFrame.new(center + Vector3.new(5, H_HUB / 2, 0)), Vector3.new(1, H_HUB, 24), WALL, Enum.Material.Brick, "Wall")
		-- dead end (back wall) with a leaning sign
		local backWall = box(CFrame.new(center + Vector3.new(0, H_HUB / 2, -12)), Vector3.new(10, H_HUB, 1), WALL, Enum.Material.Brick, "Wall")
		local sign = box(
			backWall.CFrame * CFrame.new(0, -2, 0.6) * CFrame.Angles(0, 0, math.rad(6)),
			Vector3.new(4, 2, 0.2),
			WOOD_DARK,
			Enum.Material.WoodPlanks,
			"NoAdmittanceSign"
		)
		surfaceText(sign, Enum.NormalId.Back, { { text = "NO ADMITTANCE", size = 24 } })
		-- invisible guard walls so nobody can clip past the alley's open top
		guardWall(CFrame.new(center + Vector3.new(0, H_HUB + 4, 0)), Vector3.new(10, 4, 24))
		-- spawn, faces north (+Z) toward the Plaza
		local spawn = Instance.new("SpawnLocation")
		spawn.Anchored = true
		spawn.Neutral = true
		spawn.Enabled = true
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.Size = Vector3.new(8, 1, 8)
		spawn.CFrame = CFrame.new(HUB + Vector3.new(0, 0.5, -50))
		CollectionService:AddTag(spawn, "LobbySpawn")
		spawn.Parent = root
		manifest.lobbySpawn = spawn
		-- one flickering lamp (graft #1: flicker stays confined to the alley)
		hubLamp(center + Vector3.new(0, 1.1, 0), true)
		-- chalkboard, read on the walk in
		local chalk = part({
			Name = "Chalkboard",
			CFrame = CFrame.new(center + Vector3.new(-3.2, 7, 8)) * CFrame.Angles(0, math.rad(20), 0),
			Size = Vector3.new(9, 6, 0.4),
			Color = Color3.fromRGB(24, 30, 26),
			Material = Enum.Material.SmoothPlastic,
			Tag = "Chalkboard",
		})
		surfaceText(chalk, Enum.NormalId.Back, {
			{ text = "HOUSE RULES", size = 34, color = Color3.fromRGB(232, 226, 205) },
			{ text = "1. CARE for every doll.", size = 20 },
			{ text = "2. WATCH for the wrong one.", size = 20 },
			{ text = "3. FIND the glyphs. Match the ledger.", size = 20 },
			{ text = "4. BANISH it before the Presence takes you.", size = 20 },
			{ text = '"...and always tie the silver ribbon before a banishing. Always." — The Dollmaker', size = 15, color = Color3.fromRGB(170, 150, 190) },
		})
		manifest.chalkboard = chalk
	end)

	segment("Plaza", function()
		box(CFrame.new(HUB) * CFrame.new(0, -0.5, 0), Vector3.new(70, 1, 60), STONE, Enum.Material.Slate, "Floor")
		-- invisible guard walls around the open-sky Plaza's outer edges (A2-class fall-through prevention)
		guardWall(CFrame.new(HUB + Vector3.new(-35.5, 10, 0)), Vector3.new(1, 20, 60))
		guardWall(CFrame.new(HUB + Vector3.new(35.5, 10, 0)), Vector3.new(1, 20, 60))
		guardWall(CFrame.new(HUB + Vector3.new(0, 10, 30.5)), Vector3.new(70, 20, 1))
		-- steady corner lamps (graft #1: never flicker, so a haunt/lighting event never makes the
		-- join squares unreadable on a phone screen)
		hubLamp(HUB + Vector3.new(-28, 1.1, -24))
		hubLamp(HUB + Vector3.new(28, 1.1, -24))
		hubLamp(HUB + Vector3.new(-28, 1.1, 22))
		hubLamp(HUB + Vector3.new(28, 1.1, 22))
	end)

	segment("Fountain", function()
		local basin = part({
			Name = "FountainBasin",
			Shape = Enum.PartType.Cylinder,
			CFrame = CFrame.new(HUB + Vector3.new(0, 1, 14)) * CFrame.Angles(0, 0, math.rad(90)),
			Size = Vector3.new(2, 14, 14),
			Color = STONE,
			Material = Enum.Material.Concrete,
		})
		box(basin.CFrame * CFrame.new(2.2, 0, 0) * CFrame.Angles(0, 0, math.rad(-90)), Vector3.new(1.4, 1.4, 1.4), Color3.fromRGB(30, 26, 34), Enum.Material.SmoothPlastic, "PorcelainStatue")
	end)

	segment("JoinSquares", function()
		-- Diamond-shaped floor tiles: a rotated-square footprint, glowing Neon material. One BasePart
		-- per square, directly recolorable by JoinSquareService (idle/occupied/locking) -- see
		-- docs/packets/PACKET_1_LOBBY_SYSTEMS.md's map addendum for why a solid diamond (not a hollow
		-- outline) was chosen: it's the same visual read with far less construction risk, and it's a
		-- pure decoration upgrade later if the team wants a true hollow outline.
		local positions = {
			HUB + Vector3.new(-24, 0.15, -6),
			HUB + Vector3.new(-12, 0.15, 2),
			HUB + Vector3.new(0, 0.15, 5),
			HUB + Vector3.new(12, 0.15, 2),
			HUB + Vector3.new(24, 0.15, -6),
		}
		for i, pos in positions do
			local tile = part({
				Name = "JoinSquare" .. i,
				CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(45), 0),
				Size = Vector3.new(7, 0.3, 7),
				Color = Config.JoinSquares.IdleColor,
				Material = Enum.Material.Neon,
				Transparency = 0.1,
				CanCollide = false,
				Tag = "JoinSquare",
			})
			tile:SetAttribute("SquareIndex", i)
			table.insert(manifest.joinSquares, tile)
		end
	end)

	segment("InvitePostbox", function()
		local post = box(CFrame.new(HUB + Vector3.new(4, 1.5, -26)), Vector3.new(1.4, 3, 1.4), Color3.fromRGB(120, 34, 30), Enum.Material.Metal, "InvitePostbox")
		CollectionService:AddTag(post, "InviteKiosk")
		manifest.inviteKiosk = post
		manifest.invitePrompt = prompt(post, "Send for a Friend", "Postbox")
	end)

	segment("DollmakerShop", function()
		-- A solid, closed facade -- no door cut through the wall, no interior to build or seal off.
		-- Players never walk inside; the ProximityPrompt is what "enters" the shop.
		local center = HUB + Vector3.new(0, 0, 38)
		box(CFrame.new(center) * CFrame.new(0, H_HUB / 2, 0), Vector3.new(26, H_HUB, 16), WALL, Enum.Material.Brick, "ShopBuilding")
		box(CFrame.new(center) * CFrame.new(0, H_HUB + 3, 0), Vector3.new(28, 6, 18), WOOD_DARK, Enum.Material.Wood, "RoofCap")
		local front = center + Vector3.new(0, 0, -8.1)
		litWindow(CFrame.new(front + Vector3.new(-7, 7, 0)), 3)
		litWindow(CFrame.new(front + Vector3.new(7, 7, 0)), 3)
		local sign = box(CFrame.new(front + Vector3.new(0, H_HUB + 0.5, 0)), Vector3.new(14, 3, 0.5), WOOD_DARK, Enum.Material.Wood, "ShopSign")
		surfaceText(sign, Enum.NormalId.Back, { { text = "THE DOLLMAKER'S", size = 30 } })
		local stoop = box(CFrame.new(front + Vector3.new(0, 0.3, -1.5)), Vector3.new(6, 0.6, 3), STONE, Enum.Material.Concrete, "ShopStoop")
		CollectionService:AddTag(stoop, "ShopKiosk")
		manifest.shopKiosk = stoop
		manifest.shopPrompt = prompt(stoop, "Enter the Shop", "The Dollmaker's")
	end)

	segment("ClassesShopfront", function()
		local center = HUB + Vector3.new(-28, 0, 36)
		box(CFrame.new(center) * CFrame.new(0, H_HUB / 2, 0), Vector3.new(16, H_HUB, 12), WALL, Enum.Material.Brick, "ClassesBuilding")
		box(CFrame.new(center) * CFrame.new(0, H_HUB + 3, 0), Vector3.new(18, 6, 14), WOOD_DARK, Enum.Material.Wood, "RoofCap")
		local front = center + Vector3.new(0, 0, -6.1)
		litWindow(CFrame.new(front + Vector3.new(0, 6.5, 0)), 2)
		-- crossed boarding over the window, matching the "boarded shopfront" reference look
		box(CFrame.new(front + Vector3.new(0, 6.5, 0.15)) * CFrame.Angles(0, 0, math.rad(18)), Vector3.new(6, 0.3, 0.15), BOARD_WOOD, Enum.Material.WoodPlanks, "Board")
		box(CFrame.new(front + Vector3.new(0, 6.5, 0.15)) * CFrame.Angles(0, 0, math.rad(-18)), Vector3.new(6, 0.3, 0.15), BOARD_WOOD, Enum.Material.WoodPlanks, "Board")
		local sign = box(CFrame.new(front + Vector3.new(0, H_HUB - 1, 0)), Vector3.new(9, 2, 0.4), WOOD_DARK, Enum.Material.Wood, "TailorSign")
		surfaceText(sign, Enum.NormalId.Back, { { text = "TAILOR", size = 22, color = Color3.fromRGB(150, 140, 130) } })
		local stoop = box(CFrame.new(front + Vector3.new(0, 0.3, -1.2)), Vector3.new(5, 0.6, 2.4), STONE, Enum.Material.Concrete, "ClassesStoop")
		CollectionService:AddTag(stoop, "ClassesKiosk")
		manifest.classesKiosk = stoop
		manifest.classesPrompt = prompt(stoop, "Browse Classes", "Tailor's Shopfront")
	end)

	segment("ApothecaryShopfront", function()
		-- Pure backdrop dressing -- balances the skyline, sells nothing, no prompt.
		local center = HUB + Vector3.new(28, 0, 36)
		box(CFrame.new(center) * CFrame.new(0, H_HUB / 2, 0), Vector3.new(16, H_HUB, 12), WALL, Enum.Material.Brick, "ApothecaryBuilding")
		box(CFrame.new(center) * CFrame.new(0, H_HUB + 3, 0), Vector3.new(18, 6, 14), WOOD_DARK, Enum.Material.Wood, "RoofCap")
		local front = center + Vector3.new(0, 0, -6.1)
		box(CFrame.new(front + Vector3.new(0, 6.5, 0)), Vector3.new(4.5, 4, 0.2), Color3.fromRGB(90, 100, 90), Enum.Material.Glass, "BoardedWindow")
		box(CFrame.new(front + Vector3.new(0, 6.5, 0.15)) * CFrame.Angles(0, 0, math.rad(18)), Vector3.new(5, 0.3, 0.15), BOARD_WOOD, Enum.Material.WoodPlanks, "Board")
		box(CFrame.new(front + Vector3.new(0, 6.5, 0.15)) * CFrame.Angles(0, 0, math.rad(-18)), Vector3.new(5, 0.3, 0.15), BOARD_WOOD, Enum.Material.WoodPlanks, "Board")
	end)

	segment("JournalNoticeboard", function()
		local post = box(CFrame.new(HUB + Vector3.new(18, 3, 6)), Vector3.new(0.4, 6, 0.4), WOOD_DARK, Enum.Material.Wood, "NoticeboardPost")
		local board = box(CFrame.new(HUB + Vector3.new(18, 5, 6)), Vector3.new(4.5, 3.5, 0.3), Color3.fromRGB(150, 120, 90), Enum.Material.Fabric, "JournalBoard")
		CollectionService:AddTag(board, "JournalKiosk")
		manifest.journalKiosk = board
		surfaceText(board, Enum.NormalId.Front, { { text = "THE DOLLMAKER'S", size = 18 }, { text = "JOURNAL", size = 26 } })
		manifest.journalPrompt = prompt(board, "Read the Journal", "Noticeboard")
		local _ = post
	end)

	segment("LeaderboardBoards", function()
		-- TWO separate boards per the reference screenshots: best-shift and dolls-cleared, flanking
		-- the Shop.
		local shiftBoard = box(
			CFrame.new(HUB + Vector3.new(-16, 6.5, 29.4)),
			Vector3.new(9, 7, 0.4),
			WOOD_DARK,
			Enum.Material.Wood,
			"LeaderboardBoard"
		)
		CollectionService:AddTag(shiftBoard, "LeaderboardBoard")
		manifest.leaderboardBoard = shiftBoard
		local patientsBoard = box(
			CFrame.new(HUB + Vector3.new(16, 6.5, 29.4)),
			Vector3.new(9, 7, 0.4),
			WOOD_DARK,
			Enum.Material.Wood,
			"PatientsBoard"
		)
		CollectionService:AddTag(patientsBoard, "PatientsBoard")
		manifest.patientsBoard = patientsBoard
	end)

	-- Kept for compatibility with ShiftManager.setDoorLocked (it nil-safely no-ops if the Slab child
	-- is absent, per docs/packets/PACKET_1_LOBBY_SYSTEMS.md Track C: repurposed as a static
	-- "Shift N in progress" plaque, never a physical CanCollide slab -- entry to a shift is gated by
	-- the join-square countdown now, not a walked-and-locked door.
	segment("WorkshopStatusPlaque", function()
		local doorModel = Instance.new("Model")
		doorModel.Name = "WorkshopDoor"
		CollectionService:AddTag(doorModel, "WorkshopDoor")
		doorModel.Parent = root
		local sign = box(CFrame.new(WS + Vector3.new(0, H_WS + 1, 8.4)), Vector3.new(6, 2, 0.3), Color3.fromRGB(30, 24, 28), nil, "Sign")
		sign.Parent = doorModel
		surfaceText(sign, Enum.NormalId.Back, { { text = "", size = 30 } })
		manifest.workshopDoor = doorModel
		manifest.workshopDoorSign = sign
	end)
	end -- buildLobby

	-- ============================== WORKSHOP ==============================
	if buildWorkshop then
	-- One plus-shaped footprint: two overlapping slabs (built together, before any wall), then
	-- perimeter walls on the OUTER boundary only. No interior wall is ever placed, which is what
	-- makes the A1 (sealed Banish room) and A2 (void gap) bug class structurally impossible here,
	-- not just carefully avoided.

	segment("WorkshopShell", function()
		plusSlab({
			{ center = WS, footprint = Vector3.new(68, 1, 18) }, -- horizontal arm: Bench Wing + Foyer + Banish Wing
			{ center = WS + Vector3.new(0, 0, -18), footprint = Vector3.new(16, 1, 36) }, -- vertical arm: Ledger Nook, overlaps the ENTIRE Foyer band (Z -9..9), an 18-stud overlap not an edge-touch
		}, H_WS)

		-- Outer boundary walls, traced clockwise from the horizontal arm's SE corner. Every segment
		-- below is a plain solid wall -- there is no gap anywhere in this list, because there is
		-- nowhere in this design a player is meant to walk OUT of the plus-shape.
		local wallT = 1
		local h2 = H_WS / 2
		-- south wall (full width, X -34..34 at Z=9)
		box(CFrame.new(WS + Vector3.new(0, h2, 9)), Vector3.new(68, H_WS, wallT), WALL, Enum.Material.Wood, "Wall")
		-- Banish Wing east wall (X=34, Z -9..9)
		box(CFrame.new(WS + Vector3.new(34, h2, 0)), Vector3.new(wallT, H_WS, 18), WALL, Enum.Material.Wood, "Wall")
		-- Banish Wing north wall (Z=-9, X 8..34)
		box(CFrame.new(WS + Vector3.new(21, h2, -9)), Vector3.new(26, H_WS, wallT), WALL, Enum.Material.Wood, "Wall")
		-- Ledger Nook east wall (X=8, Z -27..-9)
		box(CFrame.new(WS + Vector3.new(8, h2, -18)), Vector3.new(wallT, H_WS, 18), WALL, Enum.Material.Wood, "Wall")
		-- Ledger Nook north wall (Z=-27, X -8..8, the "top" of the whole plus-shape)
		box(CFrame.new(WS + Vector3.new(0, h2, -27)), Vector3.new(16, H_WS, wallT), WALL, Enum.Material.Wood, "Wall")
		-- Ledger Nook west wall (X=-8, Z -27..-9)
		box(CFrame.new(WS + Vector3.new(-8, h2, -18)), Vector3.new(wallT, H_WS, 18), WALL, Enum.Material.Wood, "Wall")
		-- Bench Wing north wall (Z=-9, X -34..-8)
		box(CFrame.new(WS + Vector3.new(-21, h2, -9)), Vector3.new(26, H_WS, wallT), WALL, Enum.Material.Wood, "Wall")
		-- Bench Wing west wall (X=-34, Z -9..9)
		box(CFrame.new(WS + Vector3.new(-34, h2, 0)), Vector3.new(wallT, H_WS, 18), WALL, Enum.Material.Wood, "Wall")

		-- teleport landing point, default Enabled=true (a live reserved shift server has no
		-- lobbySpawn to protect against, and TeleportAsync arrivals need somewhere enabled the
		-- instant the server boots -- LobbyService.setShiftSpawnActive still toggles this in Studio's
		-- single-server mode exactly as before).
		local wspawn = Instance.new("SpawnLocation")
		wspawn.Anchored = true
		wspawn.Neutral = true
		wspawn.Enabled = true
		wspawn.Transparency = 1
		wspawn.CanCollide = false
		wspawn.Size = Vector3.new(6, 1, 6)
		wspawn.CFrame = CFrame.new(WS + Vector3.new(0, 0.5, 0))
		CollectionService:AddTag(wspawn, "WorkshopSpawn")
		wspawn.Parent = root
		manifest.workshopSpawn = wspawn
	end)

	segment("BenchWing", function()
		local c = WS + Vector3.new(-21, 0, 0)
		lamp(c + Vector3.new(4, 1.1, -6))
		lamp(c + Vector3.new(4, 1.1, 6))
		local bench = box(CFrame.new(c + Vector3.new(-10, 2, 0)), Vector3.new(4, 4, 16), WOOD, Enum.Material.Wood, "Workbench")
		CollectionService:AddTag(bench, "Workbench")
		manifest.workbench = bench
		for i = 1, 5 do
			local z = -8 + (i - 1) * 4
			local slot = part({
				Name = "BenchSlot" .. i,
				CFrame = CFrame.new(c + Vector3.new(-10, 4.6, z)),
				Size = Vector3.new(1, 1, 1),
				Transparency = 1,
				CanCollide = false,
				CanQuery = false,
				Tag = "BenchSlot",
			})
			table.insert(manifest.benchSlots, slot)
		end
		local spool = part({
			Name = "RibbonSpool",
			-- dz=7.2 (not 8.5): south wall's inner face is at Z=8.5, so 8.5 would clip the spool
			-- 0.8 studs into it; 7.2 keeps it seated on the bench top with a clean 0.5-stud gap.
			CFrame = CFrame.new(c + Vector3.new(-10, 4.8, 7.2)),
			Size = Vector3.new(1.6, 1.6, 1.6),
			Color = Color3.fromRGB(200, 205, 215),
			Material = Enum.Material.Metal,
			Tag = "RibbonSpool",
		})
		manifest.ribbonSpool = spool
		manifest.ribbonPrompt = prompt(spool, "Take Silver Ribbon", "Ribbon Spool")
		-- shelf decor (former "storage alcove"), along the north wall segment of this wing. Local X
		-- range for this wing is roughly -13..13 (west wall at -13, workbench occupies -13..-9, the
		-- closet-nook door hinge sits at -4) -- these three shelves at local X 1/5.5/10 stay clear of
		-- both and well inside the east wall at +13.
		for i = 1, 3 do
			-- dz=-7.5 (not -8.3): north wall's inner face is at Z=-8.5, so -8.3 would clip the
			-- 0.6-half-depth shelf 0.4 studs into it; -7.5 keeps a clean 0.4-stud gap.
			local shelf = box(CFrame.new(c + Vector3.new(1 + (i - 1) * 4.5, 5, -7.5)), Vector3.new(4, 0.6, 1.2), WOOD_DARK, Enum.Material.Wood, "Shelf")
			for j = 1, 3 do
				box(
					shelf.CFrame * CFrame.new(-1.2 + (j - 1) * 1.2, 1.2, 0),
					Vector3.new(0.7, 1.8, 0.6),
					Color3.fromRGB(25, 20, 24),
					Enum.Material.SmoothPlastic,
					"DecorDoll"
				)
			end
		end
		-- window on the outer (west) wall. Offset is WS-relative (matches the west wall's WS-relative
		-- X=-34 from the boundary wall list above), NOT c-relative -- c is already offset -21 from WS.
		table.insert(manifest.windowPanes, litWindow(CFrame.new(WS + Vector3.new(-33.4, 8, 0)) * CFrame.Angles(0, math.rad(90), 0), 0))
		-- decorative closet nook (never load-bearing -- it's mounted flush on a solid wall, not an
		-- opening cut through one)
		local doorModel = Instance.new("Model")
		doorModel.Name = "HauntDoor1"
		CollectionService:AddTag(doorModel, "HauntDoor")
		doorModel.Parent = root
		local hinge = part({
			Name = "Hinge",
			CFrame = CFrame.new(c + Vector3.new(-4, 5, -8.5)),
			Size = Vector3.new(0.4, 10, 0.4),
			Transparency = 1,
			CanCollide = false,
			Parent = doorModel,
		})
		doorModel.PrimaryPart = hinge
		part({
			Name = "Panel",
			CFrame = hinge.CFrame * CFrame.new(0, 0, 0.3),
			Size = Vector3.new(3, 9.6, 0.5),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
			CanCollide = false,
			Parent = doorModel,
		})
		table.insert(manifest.hauntDoors, doorModel)
	end)

	segment("LedgerNook", function()
		local c = WS + Vector3.new(0, 0, -18)
		lamp(c + Vector3.new(0, 1.1, -3))
		local desk = box(CFrame.new(c + Vector3.new(0, 2, -6)), Vector3.new(8, 4, 4), WOOD, Enum.Material.Wood, "LedgerDesk")
		CollectionService:AddTag(desk, "LedgerDesk")
		local book = box(desk.CFrame * CFrame.new(0, 2.3, 0) * CFrame.Angles(0, 0, math.rad(8)), Vector3.new(3, 0.6, 2.2), Color3.fromRGB(90, 40, 40), Enum.Material.Fabric, "LedgerBook")
		manifest.ledgerDesk = desk
		manifest.ledgerPrompt = prompt(book, "Open Ledger", "Spirit Ledger")
		local rack = part({
			Name = "DetectorRack",
			CFrame = CFrame.new(c + Vector3.new(6, 3, -6)),
			Size = Vector3.new(2, 6, 2),
			Color = WOOD_DARK,
			Tag = "DetectorRack",
		})
		manifest.detectorRack = rack
		-- decorative closet nook on the west wall
		local doorModel = Instance.new("Model")
		doorModel.Name = "HauntDoor2"
		CollectionService:AddTag(doorModel, "HauntDoor")
		doorModel.Parent = root
		local hinge = part({
			Name = "Hinge",
			CFrame = CFrame.new(c + Vector3.new(-7.5, 5, 4)) * CFrame.Angles(0, math.rad(90), 0),
			Size = Vector3.new(0.4, 10, 0.4),
			Transparency = 1,
			CanCollide = false,
			Parent = doorModel,
		})
		doorModel.PrimaryPart = hinge
		part({
			Name = "Panel",
			CFrame = hinge.CFrame * CFrame.new(0, 0, 0.3),
			Size = Vector3.new(3, 9.6, 0.5),
			Color = WOOD_DARK,
			Material = Enum.Material.Wood,
			CanCollide = false,
			Parent = doorModel,
		})
		table.insert(manifest.hauntDoors, doorModel)
	end)

	segment("BanishWing", function()
		local c = WS + Vector3.new(21, 0, 0)
		lamp(c + Vector3.new(4, 1.1, 0))
		local boxModel = Instance.new("Model")
		boxModel.Name = "BanishBox"
		CollectionService:AddTag(boxModel, "BanishBox")
		boxModel.Parent = root
		local base = part({
			Name = "Base",
			CFrame = CFrame.new(c + Vector3.new(9, 2.2, 0)),
			Size = Vector3.new(4, 4.4, 7),
			Color = Color3.fromRGB(38, 26, 40),
			Material = Enum.Material.Wood,
			Parent = boxModel,
		})
		boxModel.PrimaryPart = base
		local lid = part({
			Name = "Lid",
			CFrame = base.CFrame * CFrame.new(-2.4, 1.4, 0) * CFrame.Angles(0, 0, math.rad(70)),
			Size = Vector3.new(4, 0.6, 7),
			Color = Color3.fromRGB(48, 32, 52),
			Material = Enum.Material.Wood,
			Parent = boxModel,
		})
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(180, 120, 255)
		glow.Brightness = 0
		glow.Range = 12
		glow.Parent = base
		manifest.banishBox = boxModel
		manifest.banishLid = lid
		manifest.banishGlow = glow
		local depositPrompt = prompt(base, "Place the doll inside", "Banish Box", 0.5)
		depositPrompt.Enabled = false
		manifest.banishPrompt = depositPrompt
		-- window on the outer (east) wall. Offset is WS-relative (matches the east wall's WS-relative
		-- X=34 from the boundary wall list above), NOT c-relative -- c is already offset +21 from WS.
		table.insert(manifest.windowPanes, litWindow(CFrame.new(WS + Vector3.new(33.4, 8, 0)) * CFrame.Angles(0, math.rad(-90), 0), 0))
	end)

	segment("GlyphSpawns", function()
		-- 3 per wing, all comfortably clear of walls/props (A3/B13 fix baked in from the start: none
		-- of these sit in a corridor behind a locked door -- there is no corridor anymore -- and none
		-- overlap the Banish Box's deposit prompt).
		local spots = {
			-- Bench Wing
			WS + Vector3.new(-30, 5, 5),
			WS + Vector3.new(-14, 2, -6),
			WS + Vector3.new(-24, 7, 6),
			-- Ledger Nook
			WS + Vector3.new(-4, 2, -14),
			WS + Vector3.new(5, 6, -22),
			WS + Vector3.new(0, 2, -25),
			-- Banish Wing
			WS + Vector3.new(28, 2, -6),
			WS + Vector3.new(14, 6, 5),
			WS + Vector3.new(30, 7, 2),
		}
		for i, pos in spots do
			local marker = part({
				Name = "GlyphSpawn" .. i,
				CFrame = CFrame.new(pos),
				Size = Vector3.new(0.5, 0.5, 0.5),
				Transparency = 1,
				CanCollide = false,
				CanQuery = false,
				Tag = "GlyphSpawn",
			})
			table.insert(manifest.glyphSpawns, marker)
		end
	end)
	end -- buildWorkshop

	segment("Atmosphere", function()
		Lighting.FogEnd = 140
		Lighting.FogStart = 30
		Lighting.FogColor = Color3.fromRGB(18, 14, 22)
		Lighting.ClockTime = 1.5
		local atmo = Instance.new("Atmosphere")
		atmo.Density = 0.35
		atmo.Color = Color3.fromRGB(120, 110, 130)
		atmo.Parent = Lighting
		-- collect Workshop lamps into the manifest (Hub lamps are deliberately untagged -- see
		-- hubLamp() -- so HauntService's LightsOutBeat can never affect players still in the Hub)
		for _, inst in CollectionService:GetTagged("Lamp") do
			table.insert(manifest.lamps, inst)
		end
	end)

	Util.log(("MapBuilder: built with %d failed segment(s)"):format(#failures))
	return manifest, failures
end

function MapBuilder.init(_ctx: any) end

return MapBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">PresenceService</string>
            <string name="Source"><![CDATA[--!strict
-- The Presence meter: wraps Logic/PresenceMath in a heartbeat loop; broadcasts tier changes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local PresenceMath = require(Shared:WaitForChild("Logic"):WaitForChild("PresenceMath")) :: any

local PresenceService = {}

local ctx: any
local state: any = nil
local rateMultiplier = 1
local running = false
local maxedFired = false
local lastTier = -1
local maxedCallbacks: { () -> () } = {}
local connection: RBXScriptConnection? = nil

local mathCfg = {
	Max = Config.Presence.Max,
	BaseFillPerSecond = Config.Presence.BaseFillPerSecond,
	LastDollAccelMultiplier = Config.Presence.LastDollAccelMultiplier,
	RushWindowSeconds = Config.Presence.RushSurge.WindowSeconds,
	RushStepsInWindow = Config.Presence.RushSurge.StepsInWindow,
	RushSurgeAmount = Config.Presence.RushSurge.SurgeAmount,
	RushDecayPerSecond = Config.Presence.RushSurge.DecayPerSecond,
	Tiers = Config.Presence.Tiers,
}

local function pushTier()
	local tier = if state then PresenceMath.tier(state, mathCfg) else 0
	if tier ~= lastTier then
		lastTier = tier
		Remotes.get(Remotes.Names.PresenceTier):FireAllClients(tier)
		Util.safeCall("hauntSetTier", function()
			ctx.services.HauntService.setTier(tier)
		end)
	end
end

function PresenceService.init(context: any)
	ctx = context
end

function PresenceService.startShift(multiplier: number)
	rateMultiplier = multiplier
	state = PresenceMath.new()
	maxedFired = false
	running = true
	lastTier = -1
	pushTier()
	if connection then
		connection:Disconnect()
	end
	local acc = 0
	connection = RunService.Heartbeat:Connect(function(dt: number)
		if not running or not state then
			return
		end
		acc += dt
		if acc < 0.1 then
			return
		end
		PresenceMath.step(state, mathCfg, acc, rateMultiplier)
		acc = 0
		pushTier()
		if not maxedFired and PresenceMath.isMaxed(state, mathCfg) then
			maxedFired = true
			for _, cb in maxedCallbacks do
				Util.safeCall("presenceMaxed", cb)
			end
		end
	end)
end

function PresenceService.stop()
	running = false
	if connection then
		connection:Disconnect()
		connection = nil
	end
	state = nil
	lastTier = -1
	Remotes.get(Remotes.Names.PresenceTier):FireAllClients(0)
end

function PresenceService.surge(amount: number)
	if state then
		PresenceMath.addSurge(state, amount)
	end
end

function PresenceService.notifyStepCompleted()
	if state then
		PresenceMath.onStepCompleted(state, mathCfg, os.clock())
	end
end

function PresenceService.setAllDollsDone(done: boolean)
	if state then
		state.allDollsDone = done
	end
end

function PresenceService.getTier(): number
	return if state then PresenceMath.tier(state, mathCfg) else 0
end

function PresenceService.getValue(): number
	return if state then state.value else 0
end

function PresenceService.setValue(v: number)
	if state then
		state.value = math.clamp(v, 0, mathCfg.Max)
		pushTier()
	end
end

function PresenceService.onMaxed(fn: () -> ())
	table.insert(maxedCallbacks, fn)
end

return PresenceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--!strict
-- Journal / quests: tracks progress toward Defs/Quests.luau and pays out coin rewards. Progress
-- is derived at read-time from DataService's stats via Logic/QuestProgress -- QuestService holds
-- no separate "quest progress" cache, it's a thin authority layer over DataService.
--
-- Also owns: the hidden lobby easter-egg triggers, and (behind Config.Features.TutorialGate)
-- setting tutorialDone the moment a player's first shift is won.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Quests = require(Shared:WaitForChild("Defs"):WaitForChild("Quests")) :: any
local QuestProgress = require(Shared:WaitForChild("Logic"):WaitForChild("QuestProgress")) :: any

local QuestService = {}

local ctx: any
local stillnessDwell: { [Player]: number } = {}

local function broadcastStats(player: Player)
	local stats = ctx.services.DataService.getStats(player)
	Remotes.get(Remotes.Names.PlayerStats):FireClient(player, stats)
end

-- ---------- claim ----------

function QuestService.claim(player: Player, questId: string): boolean
	local quest = Quests.byId[questId]
	if not quest then
		return false
	end
	local DataService = ctx.services.DataService
	local stats = DataService.getStats(player)
	if stats.claimedQuestIds[questId] then
		Remotes.get(Remotes.Names.Toast):FireClient(player, "Already claimed.", 3)
		return false
	end
	if not QuestProgress.isComplete(stats, quest) then
		return false -- client shouldn't have shown Claim yet; ignore silently
	end
	if not DataService.markQuestClaimed(player, questId) then
		return false -- race: another claim beat us to it
	end
	DataService.addCoins(player, quest.coinReward)
	Remotes.get(Remotes.Names.Toast):FireClient(
		player,
		("Journal complete: %s (+%d coins)"):format(quest.title, quest.coinReward),
		4
	)
	broadcastStats(player)
	return true
end

-- ---------- easter eggs ----------
-- Built by THIS service, independently of MapBuilder.luau, and parented under ctx.manifest.root.
-- Safe to do because MapBuilder.build() always runs BEFORE any service's init() (server
-- bootstrap order per docs/INTERFACES.md), so ctx.manifest is fully populated here.

local function makeEggPrompt(part: BasePart, actionText: string, objectText: string, onTrigger: (Player) -> ())
	CollectionService:AddTag(part, "QuestTrigger")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.RequiresLineOfSight = false
	prompt.MaxActivationDistance = Config.Care.PromptDistance
	prompt.Exclusivity = Enum.ProximityPromptExclusivity.OnePerButton
	prompt.Parent = part
	prompt.Triggered:Connect(function(player: Player)
		Util.safeCall("eggTrigger", onTrigger, player)
	end)
end

local function grantEggFlag(player: Player, questId: string, flavorLine: string)
	local DataService = ctx.services.DataService
	local stats = DataService.getStats(player)
	if stats.questFlags[questId] then
		return -- already found; no repeat toast
	end
	DataService.setQuestFlag(player, questId)
	Remotes.get(Remotes.Names.Toast):FireClient(player, flavorLine, 5)
	broadcastStats(player)
end

local function wireEasterEggs()
	local manifest = ctx.manifest
	local anchor = manifest.chalkboard or manifest.lobbySpawn
	if not anchor then
		return
	end

	-- Egg 1: a floorboard near the chalkboard, deliberately unremarkable-looking
	Util.safeCall("eggFloorboard", function()
		local board = Instance.new("Part")
		board.Name = "LooseFloorboard"
		board.Anchored = true
		board.CanCollide = false
		board.Material = Enum.Material.WoodPlanks
		board.Color = Color3.fromRGB(70, 55, 45)
		board.Size = Vector3.new(2, 0.15, 1)
		board.CFrame = anchor.CFrame * CFrame.new(-4, -0.9, 2.5) -- DEFAULT offset; retune once the real lobby geometry exists
		board.Parent = manifest.root
		makeEggPrompt(board, "Pry It Up", "Loose Floorboard", function(player: Player)
			grantEggFlag(player, "EggFloorboard", "Something glints under the floorboard. You tuck it away.")
		end)
	end)

	-- Egg 2: a folded note near the ribbon spool (thematic tie-in to the ribbon's own hidden-6th-step dread)
	Util.safeCall("eggNote", function()
		local spot = manifest.ribbonSpool or manifest.ledgerDesk or anchor
		local note = Instance.new("Part")
		note.Name = "HiddenNote"
		note.Anchored = true
		note.CanCollide = false
		note.Material = Enum.Material.SmoothPlastic
		note.Color = Color3.fromRGB(224, 214, 180)
		note.Size = Vector3.new(0.6, 0.05, 0.8)
		note.CFrame = spot.CFrame * CFrame.new(1.2, 0.05, -0.3) * CFrame.Angles(0, math.rad(15), 0) -- DEFAULT offset
		note.Parent = manifest.root
		makeEggPrompt(note, "Read the Note", "Folded Paper", function(player: Player)
			grantEggFlag(player, "EggNote", "\"Count the stitches before you count the hours. — The Dollmaker\"")
		end)
	end)

	-- Egg 3: stand still in an odd, unmarked corner of the lobby for a while
	Util.safeCall("eggStillnessSetup", function()
		local spotPart = Instance.new("Part")
		spotPart.Name = "StillnessSpot"
		spotPart.Anchored = true
		spotPart.CanCollide = false
		spotPart.CanQuery = false
		spotPart.Transparency = 1
		spotPart.Size = Vector3.new(4, 1, 4)
		spotPart.CFrame = anchor.CFrame * CFrame.new(6, 0, -5) -- DEFAULT offset
		spotPart.Parent = manifest.root
		CollectionService:AddTag(spotPart, "QuestTrigger")

		task.spawn(function()
			while true do
				task.wait(1 / Config.Quests.StillnessPollHz)
				local standing: { [Player]: boolean } = {}
				local parts = workspace:GetPartBoundsInBox(
					CFrame.new(spotPart.Position + Vector3.new(0, 2.5, 0)),
					Vector3.new(6, 6, 6)
				)
				for _, part in parts do
					local char = part:FindFirstAncestorOfClass("Model")
					local player = char and Players:GetPlayerFromCharacter(char)
					if player then
						standing[player] = true
					end
				end
				for _, player in Players:GetPlayers() do
					if standing[player] then
						local dwell = (stillnessDwell[player] or 0) + (1 / Config.Quests.StillnessPollHz)
						stillnessDwell[player] = dwell
						if dwell >= Config.Quests.StillnessSeconds then
							grantEggFlag(player, "EggStillness", "You stood still long enough for something to notice you back.")
							stillnessDwell[player] = 0
						end
					else
						stillnessDwell[player] = 0
					end
				end
			end
		end)
	end)
end

-- ---------- init ----------

function QuestService.init(context: any)
	ctx = context

	ctx.services.DataService.onStatsChanged(function(player: Player, _stats: any)
		broadcastStats(player)
	end)
	Players.PlayerAdded:Connect(function(player)
		task.delay(2, function()
			if player.Parent then
				broadcastStats(player)
			end
		end)
		stillnessDwell[player] = 0
	end)
	Players.PlayerRemoving:Connect(function(player)
		stillnessDwell[player] = nil
	end)

	if Config.Features.TutorialGate then
		Util.safeCall("wireShiftClearedHook", function()
			ctx.services.ShiftManager.onShiftCleared(function(participants: { Player }, _clearedShift: number)
				for _, player in participants do
					if player.Parent then
						ctx.services.DataService.setTutorialDone(player)
					end
				end
			end)
		end)
	end

	if Config.Features.Quests then
		Util.safeCall("wireRibbonHook", function()
			ctx.services.DollService.onRibbonTied(function(player: Player, _dollId: string)
				ctx.services.DataService.addRibbonTied(player, 1)
			end)
		end)

		Remotes.get(Remotes.Names.ClaimQuest).OnServerEvent:Connect(function(player: Player, questId: any)
			if typeof(questId) ~= "string" then
				return
			end
			QuestService.claim(player, questId)
		end)

		wireEasterEggs()
	end
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">ShiftManager</string>
            <string name="Source"><![CDATA[--!strict
-- The state machine. Owns states, participants, shift number, strikes, spirit, correctness, recap.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Spirits = require(Shared:WaitForChild("Defs"):WaitForChild("Spirits")) :: any
local Glyphs = require(Shared:WaitForChild("Defs"):WaitForChild("Glyphs")) :: any
local DollNames = require(Shared:WaitForChild("Defs"):WaitForChild("DollNames")) :: any
local GlyphMatch = require(Shared:WaitForChild("Logic"):WaitForChild("GlyphMatch")) :: any
local Escalation = require(Shared:WaitForChild("Logic"):WaitForChild("Escalation")) :: any
local Draw = require(Shared:WaitForChild("Logic"):WaitForChild("Draw")) :: any
local ServerKind = require(Shared:WaitForChild("ServerKind")) :: any

local ShiftManager = {}

local ctx: any
local state = "LobbyIdle"
local stateGen = 0 -- bumped on every transition; kills stale watchdogs/timers
local participants: { Player } = {}
local shiftNumber = 1
local strikes = 0
local spirit: any = nil
local shiftParams: any = nil
local markedDollName: string? = nil -- A4/B7: mark-time name snapshot; recap must never depend on
                                     -- the doll's server record still existing at RunEnd
local lastBanishOutcome: string? = nil -- B11: nil | "wrongDoll" | "incomplete" -- drives the
                                        -- post-wrong-banish objective string
local runEndReason: string = "presence" -- "presence" | "watchdog" -- B9: RunEnd must say which one it was
local runStats = { dollsCleared = 0, perfect = 0, strikesThisShift = 0 }
local countdownActive = false
local coinAwardedDolls: { [string]: boolean } = {} -- Economy: reset each ShiftIntro; guards against double-award per doll
-- Social/Journal hook: fired from onBanishResolved's `correct` branch (Phase 8 merge) the instant a
-- shift clears -- NOT at RunEnd/recordRun, so a player who wins shift 1 then quits still gets credit.
local shiftClearedCallbacks: { ({ Player }, number) -> () } = {}

local escalationCfg = {
	BaseDollCount = Config.Shift.BaseDollCount,
	SoloDollCap = Config.Shift.SoloDollCap,
	MaxDollCount = Config.Shift.MaxDollCount,
	DollCountShiftMilestones = Config.Shift.DollCountShiftMilestones,
	BaseFakeTellChance = Config.Tells.FakeTellChancePerWindow,
	BaseTellIntervalMin = Config.Tells.BaseIntervalSeconds.min,
	BaseTellIntervalMax = Config.Tells.BaseIntervalSeconds.max,
	GlyphsPerShift = Config.Glyphs.PerShift,
}

-- ---------- helpers ----------

local function currentObjective(): string
	if state == "LobbyIdle" then
		return "Stand on the glowing pad to start the night shift."
	elseif state == "ShiftIntro" then
		return "The dolls are arriving…"
	elseif state ~= "ShiftActive" then
		return ""
	end
	local DollService = ctx.services.DollService
	local GlyphService = ctx.services.GlyphService
	local remaining = 0
	for _, id in DollService.getDollIds() do
		if DollService.nextStepFor(id) ~= nil then
			remaining += 1
		end
	end
	if remaining > 0 then
		return ("Care for the dolls — %d still need%s work."):format(remaining, if remaining == 1 then "s" else "")
	end
	local found = #GlyphService.getFound()
	local total = if spirit then #spirit.code else 3
	if found < total then
		return ("Find the glyphs — %d of %d found."):format(found, total)
	end
	local slots = GlyphService.getSlots()
	if not (spirit and GlyphMatch.matches(spirit.code, slots)) then
		return "Match the spirit in the ledger."
	end
	-- B11 fix: the post-wrong-banish message must NOT tell players to do the exact thing they were
	-- just penalized for. `lastBanishOutcome` is set in onBanishResolved and cleared at the start of
	-- each shift, so these branches only fire after an actual wrong attempt THIS shift. The original
	-- pre-attempt copy below is intentionally a little misleading by design and is untouched.
	if lastBanishOutcome == "wrongDoll" then
		return "That wasn't it. Find the REAL one."
	elseif lastBanishOutcome == "incomplete" then
		return "You had the right one — something's still missing. Try again."
	end
	return "Bring the WRONG doll to the Banish Box."
end

local function broadcastState()
	Remotes.get(Remotes.Names.StateChanged):FireAllClients(state, {
		shift = shiftNumber,
		strikes = strikes,
		objective = currentObjective(),
	})
end

local function setDoorLocked(locked: boolean)
	local door = ctx.manifest.workshopDoor
	local slab = door and door:FindFirstChild("Slab")
	if slab and slab:IsA("BasePart") then
		slab.CanCollide = locked
		slab.Transparency = if locked then 0 else 0.85
	end
	local sign = ctx.manifest.workshopDoorSign
	local gui = sign and sign:FindFirstChildOfClass("SurfaceGui")
	local label = gui and gui:FindFirstChildOfClass("TextLabel")
	if label then
		label.Text = if locked then ("Shift %d in progress…"):format(shiftNumber) else "The workshop is open."
	end
end

local function teleportTo(spawnPart: BasePart?, players: { Player })
	if not spawnPart then
		return
	end
	for i, player in players do
		local char = player.Character
		if char then
			local angle = (i - 1) * (math.pi * 2 / math.max(#players, 1))
			char:PivotTo(spawnPart.CFrame * CFrame.new(math.cos(angle) * 3, 3, math.sin(angle) * 3))
		end
	end
end

local function pruneParticipants()
	for i = #participants, 1, -1 do
		if participants[i].Parent == nil then
			table.remove(participants, i)
		end
	end
end

local transition -- forward decl

local function armWatchdog(forState: string, gen: number)
	local seconds = Config.Shift.Watchdog[forState]
	if not seconds then
		return
	end
	task.delay(seconds, function()
		if state == forState and stateGen == gen then
			Util.warn(("WATCHDOG: state '%s' exceeded %ds — forcing transition"):format(forState, seconds))
			if forState == "ShiftActive" then
				-- B9: a ShiftActive timeout is NOT a possession scare -- never reuse that framing.
				runEndReason = "watchdog"
				transition("RunEnd")
			elseif forState == "ShiftIntro" then
				Remotes.get(Remotes.Names.Toast):FireAllClients(("watchdog: forcing past %s"):format(forState), 4)
				transition("ShiftActive")
			elseif forState == "ShiftResult" then
				Remotes.get(Remotes.Names.Toast):FireAllClients(("watchdog: forcing past %s"):format(forState), 4)
				transition("ShiftIntro")
			elseif forState == "RunEnd" then
				Remotes.get(Remotes.Names.Toast):FireAllClients(("watchdog: forcing past %s"):format(forState), 4)
				transition("LobbyIdle")
			end
		end
	end)
end

local function stopShiftSystems()
	Util.safeCall("stopTells", ctx.services.TellService.stopShift)
	Util.safeCall("stopHaunts", ctx.services.HauntService.stopShift)
	Util.safeCall("stopPresence", ctx.services.PresenceService.stop)
end

local function cleanupRun()
	stopShiftSystems()
	Util.safeCall("banishReset", ctx.services.BanishService.reset)
	Util.safeCall("clearDolls", ctx.services.DollService.clearShift)
	Util.safeCall("stopGlyphs", ctx.services.GlyphService.stopShift)
	Util.safeCall("spawnToggle", function()
		ctx.services.LobbyService.setShiftSpawnActive(false)
	end)
end

-- ---------- states ----------

transition = function(newState: string)
	stateGen += 1
	local gen = stateGen
	state = newState

	if newState == "LobbyIdle" then
		-- B4 fix: reset run-scoped state (esp. `strikes`) BEFORE broadcastState() runs below, so
		-- the StateChanged payload that announces LobbyIdle already carries strikes = 0 instead of
		-- the just-ended run's strike count.
		shiftNumber = 1
		strikes = 0
		spirit = nil
		markedDollName = nil -- A4/B7: clear the mark-time snapshot between runs
		lastBanishOutcome = nil -- B11: clear the post-banish objective override between runs
		runStats = { dollsCleared = 0, perfect = 0, strikesThisShift = 0 }
		participants = {}
		setDoorLocked(false)
		cleanupRun()
	end

	broadcastState()
	armWatchdog(newState, gen)

	if newState == "ShiftIntro" then
		pruneParticipants()
		if #participants == 0 then
			transition("LobbyIdle")
			return
		end
		setDoorLocked(true)
		Util.safeCall("spawnToggle", function()
			ctx.services.LobbyService.setShiftSpawnActive(true)
		end)
		runStats.strikesThisShift = 0
		coinAwardedDolls = {} -- Economy: fresh per-doll coin-award guard for this shift
		lastBanishOutcome = nil -- B11: fresh shift, fresh objective wording
		spirit = Draw.one(ctx.rng, Spirits.list)
		shiftParams = Escalation.forShift(escalationCfg, shiftNumber, #participants)
		shiftParams.classBuffs = ctx.services.ClassService.applyBuffs(shiftParams, participants) -- Economy
		local names = Draw.sample(ctx.rng, DollNames, shiftParams.dollCount)
		local markedIndex = ctx.rng:NextInteger(1, shiftParams.dollCount)
		local dollInfos = ctx.services.DollService.spawnShift(shiftParams, names, markedIndex, ctx.rng)
		-- A4/B7 fix: snapshot the marked doll's display name NOW, at mark-time, into ShiftManager's
		-- own state. Recap must never depend on the doll's DollService record still existing later.
		markedDollName = (dollInfos[markedIndex] and dollInfos[markedIndex].name) or "…someone"
		ctx.services.GlyphService.startShift(spirit.code, ctx.rng)
		teleportTo(ctx.manifest.workshopSpawn, participants)
		Remotes.get(Remotes.Names.ShiftData):FireAllClients({
			shift = shiftNumber,
			dolls = dollInfos,
			glyphTotal = #spirit.code,
		})
		task.delay(Config.Shift.IntroSeconds, function()
			if state == "ShiftIntro" and stateGen == gen then
				transition("ShiftActive")
			end
		end)
	elseif newState == "ShiftActive" then
		ctx.services.PresenceService.startShift(shiftParams.presenceRateMultiplier)
		ctx.services.TellService.startShift(shiftParams, ctx.rng)
		ctx.services.HauntService.startShift(ctx.rng)
	elseif newState == "ShiftResult" then
		stopShiftSystems()
		task.delay(Config.Shift.ResultSeconds, function()
			if state == "ShiftResult" and stateGen == gen then
				-- merge lobby players standing on the pad into the next shift (plan review: joiner topology)
				transition("ShiftIntro")
			end
		end)
	elseif newState == "RunEnd" then
		stopShiftSystems()
		local reason = runEndReason
		if reason == "watchdog" then
			-- B9: a shift timeout is NOT a possession scare. No scream, no shadow face, no
			-- lights-out -- just an honest, in-world "we're closing" beat.
			Remotes.get(Remotes.Names.Toast):FireAllClients(
				"The shift ran too long... the shop is closing for the night.",
				6
			)
			Remotes.get(Remotes.Names.HauntFired):FireAllClients("ShiftTimeout", {})
		else
			-- THE scare (genuine Presence-maxed ending only)
			Remotes.get(Remotes.Names.HauntFired):FireAllClients("DollmakerReveal", {})
			for _, lamp in ctx.manifest.lamps do
				local light = lamp:FindFirstChildOfClass("PointLight")
				if light then
					light.Enabled = false
				end
			end
		end
		-- B7/A4 fix: use the name captured at mark-time (see ShiftIntro above), never a live
		-- DollService lookup -- the marked doll's record may already be gone by RunEnd.
		local traitorName = markedDollName or "…someone"
		task.delay(4, function()
			if stateGen ~= gen then
				return
			end
			for _, lamp in ctx.manifest.lamps do
				local light = lamp:FindFirstChildOfClass("PointLight")
				if light then
					light.Enabled = true
				end
			end
			pruneParticipants()
			for _, player in participants do
				local stats = ctx.services.DataService.getStats(player)
				-- B7 fix: shiftReached = "the shift number the player was on when the run ended"
				-- (matches the HUD's live `SHIFT N` banner), NOT "shifts fully survived".
				local isNewBest = shiftNumber > stats.bestShift
				ctx.services.DataService.recordRun(player, {
					shiftReached = shiftNumber,
					dollsCleared = runStats.dollsCleared,
					perfect = runStats.perfect,
				})
				Remotes.get(Remotes.Names.Recap):FireClient(player, {
					shiftReached = shiftNumber,
					dollsCleared = runStats.dollsCleared,
					perfect = runStats.perfect > 0 and strikes == 0,
					traitorName = traitorName,
					bestShift = math.max(stats.bestShift, shiftNumber),
					isNewBest = isNewBest,
					reason = reason, -- "presence" | "watchdog" -- B9: recap must not lie about the cause
				})
			end
			cleanupRun()
			-- Join Squares: a live reserved shift server has no lobbySpawn to PivotTo -- hand the
			-- group back via a real cross-server teleport instead. No-op difference in Studio /
			-- same-server mode, where teleportTo's existing in-place behavior is still correct.
			if ServerKind.isReservedShiftServer() then
				Util.safeCall("sendGroupHome", function()
					ctx.services.JoinSquareService.sendGroupHome(participants)
				end)
			else
				teleportTo(ctx.manifest.lobbySpawn, participants)
			end
			transition("LobbyIdle")
		end)
	end
end

-- ---------- public API ----------

function ShiftManager.init(context: any)
	ctx = context

	ctx.services.HauntService.setParticipantsGetter(function()
		pruneParticipants()
		return table.clone(participants)
	end)

	ctx.services.DollService.onStepCompleted(function(_player: Player, dollId: string, _stepId: string)
		ctx.services.PresenceService.notifyStepCompleted()
		-- Economy: award per-doll coins the moment a doll's chain finishes (once per doll per shift)
		if state == "ShiftActive" and not coinAwardedDolls[dollId] and ctx.services.DollService.nextStepFor(dollId) == nil then
			coinAwardedDolls[dollId] = true
			for _, participant in participants do
				local mult = ctx.services.ClassService.getCoinMultiplier(participant)
				ctx.services.DataService.addCoins(participant, math.floor(Config.Economy.CoinsPerDoll * mult))
			end
		end
		if state == "ShiftActive" and ctx.services.DollService.allListedCareDone() then
			ctx.services.PresenceService.setAllDollsDone(true)
			ctx.services.BanishService.setUnlocked(true)
		end
		broadcastState()
	end)

	ctx.services.PresenceService.onMaxed(function()
		if state == "ShiftActive" then
			-- B9: genuine Presence-maxed ending -- tag it explicitly (armWatchdog tags "watchdog"
			-- on the other RunEnd path) so transition("RunEnd") knows which beat/message to use.
			runEndReason = "presence"
			transition("RunEnd")
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		local idx = table.find(participants, player)
		if idx then
			table.remove(participants, idx)
		end
		if #participants == 0 and (state == "ShiftIntro" or state == "ShiftActive" or state == "ShiftResult") then
			transition("LobbyIdle")
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		-- late joiners get current state so their HUD isn't blank
		task.delay(3, function()
			if player.Parent then
				Remotes.get(Remotes.Names.StateChanged):FireClient(player, state, {
					shift = shiftNumber,
					strikes = strikes,
					objective = currentObjective(),
				})
			end
		end)
	end)

	broadcastState()
	setDoorLocked(false)
end

function ShiftManager.requestStart(standing: { Player })
	if state ~= "LobbyIdle" then
		return
	end
	if #standing == 0 then
		if countdownActive then
			countdownActive = false
			Remotes.get(Remotes.Names.ReadyCountdown):FireAllClients(nil)
		end
		return
	end
	participants = table.clone(standing)
	if countdownActive then
		return
	end
	countdownActive = true
	task.spawn(function()
		for remaining = Config.Lobby.ReadyCountdownSeconds, 1, -1 do
			if not countdownActive or state ~= "LobbyIdle" then
				return
			end
			pruneParticipants()
			if #participants == 0 then
				countdownActive = false
				Remotes.get(Remotes.Names.ReadyCountdown):FireAllClients(nil)
				return
			end
			Remotes.get(Remotes.Names.ReadyCountdown):FireAllClients(remaining)
			task.wait(1)
		end
		if countdownActive and state == "LobbyIdle" then
			countdownActive = false
			Remotes.get(Remotes.Names.ReadyCountdown):FireAllClients(nil)
			transition("ShiftIntro")
		end
	end)
end

function ShiftManager.onBanishResolved(dollId: string)
	if state ~= "ShiftActive" then
		return
	end
	local DollService = ctx.services.DollService
	local GlyphService = ctx.services.GlyphService
	local dollName = DollService.getDisplayName(dollId)
	local isMarked = DollService.isMarked(dollId)
	local slotsMatch = spirit ~= nil and GlyphMatch.matches(spirit.code, GlyphService.getSlots())
	local hasRibbon = DollService.hasRibbon(dollId)
	local correct = isMarked and slotsMatch and hasRibbon

	if correct then
		DollService.consume(dollId)
		Remotes.get(Remotes.Names.BanishResult):FireAllClients({
			correct = true,
			dollId = dollId,
			dollName = dollName,
			spiritName = spirit.name,
			strikes = strikes,
		})
		runStats.dollsCleared += shiftParams.dollCount
		if runStats.strikesThisShift == 0 then
			runStats.perfect += 1
		end
		-- Social: onShiftCleared hook (participants snapshot BEFORE shiftNumber increments)
		pruneParticipants()
		for _, cb in shiftClearedCallbacks do
			Util.safeCall("shiftClearedCallback", cb, table.clone(participants), shiftNumber)
		end
		-- Economy: perfect-shift + late-shift coin bonus (uses PRE-increment shiftNumber = the
		-- shift that was just cleared)
		local lateBonusShifts = math.min(shiftNumber - 1, Config.Economy.LateShiftBonusCapShifts)
		local flatBonus = (if runStats.strikesThisShift == 0 then Config.Economy.PerfectShiftBonus else 0)
			+ lateBonusShifts * Config.Economy.LateShiftBonusPerShift
		if flatBonus > 0 then
			for _, participant in participants do
				local mult = ctx.services.ClassService.getCoinMultiplier(participant)
				ctx.services.DataService.addCoins(participant, math.floor(flatBonus * mult))
			end
		end
		shiftNumber += 1
		transition("ShiftResult")
		return
	end

	-- A4 fix: every non-correct outcome used to be treated identically (strike + surge + consume),
	-- which meant banishing the CORRECT doll without its ribbon tied destroyed the only doll that
	-- could ever win the shift, soft-locking the run. Now: only a genuinely WRONG doll gets consumed.
	strikes += 1
	runStats.strikesThisShift += 1
	ctx.services.PresenceService.surge(Config.Presence.WrongBanishSurge)

	if isMarked then
		lastBanishOutcome = "incomplete"
		DollService.returnToBench(dollId)
		Remotes.get(Remotes.Names.BanishResult):FireAllClients({
			correct = false,
			incomplete = true,
			dollId = dollId,
			dollName = dollName,
			strikes = strikes,
		})
		Remotes.get(Remotes.Names.Toast):FireAllClients("The box would not close… something is missing.", 4)
	else
		lastBanishOutcome = "wrongDoll"
		DollService.consume(dollId)
		Remotes.get(Remotes.Names.BanishResult):FireAllClients({
			correct = false,
			dollId = dollId,
			dollName = dollName,
			strikes = strikes,
		})
	end

	if strikes >= Config.Shift.StrikeLimit + (shiftParams.classBuffs and shiftParams.classBuffs.strikeLimitBonus or 0) then
		transition("RunEnd")
	else
		-- the box relocks? No: care is still done; allow retry. Re-enable deposit.
		ctx.services.BanishService.setUnlocked(true)
		broadcastState()
	end
end

function ShiftManager.getParticipants(): { Player }
	pruneParticipants()
	return table.clone(participants)
end

function ShiftManager.getState(): string
	return state
end

function ShiftManager.getShiftNumber(): number
	return shiftNumber
end

function ShiftManager.getSpirit(): any
	return spirit
end

-- B2: lightweight objective-only refresh for services whose state changes affect the objective
-- string but don't themselves warrant a full state transition (glyph collect / ledger slot).
function ShiftManager.refreshObjective()
	if state == "ShiftActive" then
		broadcastState()
	end
end

function ShiftManager.onShiftCleared(fn: ({ Player }, number) -> ())
	table.insert(shiftClearedCallbacks, fn)
end

-- Join Squares: literally the same participants=...; transition("ShiftIntro") pair requestStart's
-- own countdown already runs at zero -- ShiftIntro -> ShiftActive -> ShiftResult -> RunEnd then
-- proceeds unmodified. Additive: does not touch requestStart or any existing function.
function ShiftManager.beginShiftFor(occupants: { Player }): boolean
	if state ~= "LobbyIdle" then
		return false
	end
	if #occupants == 0 then
		return false
	end
	participants = table.clone(occupants)
	transition("ShiftIntro")
	return true
end

-- ---------- debug hooks (R7) ----------

function ShiftManager.debugForceState()
	if state == "LobbyIdle" then
		local players = Players:GetPlayers()
		participants = table.clone(players)
		transition("ShiftIntro")
	elseif state == "ShiftIntro" then
		transition("ShiftActive")
	elseif state == "ShiftActive" then
		transition("ShiftResult")
	elseif state == "ShiftResult" then
		transition("ShiftIntro")
	elseif state == "RunEnd" then
		transition("LobbyIdle")
	end
end

function ShiftManager.debugSetShift(n: number)
	shiftNumber = math.clamp(math.floor(n), 1, 99)
	broadcastState()
end

function ShiftManager.debugReveal(): (string?, any)
	local markedId = ctx.services.DollService.getMarkedId()
	local markedName = if markedId then ctx.services.DollService.getDisplayName(markedId) else nil
	local code = nil
	if spirit then
		local names = {}
		for _, glyphId in spirit.code do
			table.insert(names, Glyphs.byId[glyphId].name)
		end
		code = { name = spirit.name, code = table.concat(names, " → ") }
	end
	return markedName, code
end

function ShiftManager.debugStrike(delta: number)
	strikes = math.max(0, strikes + delta)
	broadcastState()
end

function ShiftManager.debugEndRun()
	if state == "ShiftActive" or state == "ShiftIntro" then
		transition("RunEnd")
	end
end

local _ = TweenService -- reserved for staged beats; keep import future-proof

return ShiftManager
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">TellService</string>
            <string name="Source"><![CDATA[--!strict
-- Tells: real tells on the marked doll, fake tells framing innocents. Generation-countered loops.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Tells = require(Shared:WaitForChild("Defs"):WaitForChild("Tells")) :: any
local Draw = require(Shared:WaitForChild("Logic"):WaitForChild("Draw")) :: any

local TellService = {}

local ctx: any
local generation = 0
local stitchDoneThisShift = false

function TellService.init(context: any)
	ctx = context
end

local function pickTell(rng: any, forMarked: boolean, dollModel: Model?): string?
	local candidates = {}
	local WatchService = ctx.services.WatchService
	local watched = dollModel ~= nil and WatchService.isWatched(dollModel)
	for _, def in Tells.list do
		local ok = true
		if def.unwatchedOnly and watched then
			ok = false
		end
		if not forMarked and not def.fakeable then
			ok = false
		end
		if def.id == "StitchMark" then
			if not forMarked or stitchDoneThisShift or ctx.services.PresenceService.getTier() < 2 then
				ok = false
			end
		end
		if ok then
			table.insert(candidates, { id = def.id, weight = def.weight })
		end
	end
	return Draw.weighted(rng, candidates)
end

function TellService.startShift(shiftParams: any, rng: any)
	generation += 1
	stitchDoneThisShift = false
	local myGen = generation
	task.spawn(function()
		while generation == myGen do
			local interval = shiftParams.tellIntervalMin + rng:NextNumber() * (shiftParams.tellIntervalMax - shiftParams.tellIntervalMin)
			task.wait(interval)
			if generation ~= myGen then
				break
			end
			local DollService = ctx.services.DollService
			-- REAL tell on the marked doll
			local markedId = DollService.getMarkedId()
			if markedId then
				local model = DollService.getModel(markedId)
				local tellId = pickTell(rng, true, model)
				if tellId then
					if tellId == "StitchMark" then
						stitchDoneThisShift = true
					end
					Util.safeCall("realTell", function()
						DollService.performTell(markedId, tellId)
					end)
				end
			end
			-- FAKE tell on an innocent (framing)
			if Config.Features.FakeTells and rng:NextNumber() < shiftParams.fakeTellChance then
				local innocents = {}
				for _, id in DollService.getDollIds() do
					if not DollService.isMarked(id) then
						table.insert(innocents, id)
					end
				end
				local victim = Draw.one(rng, innocents)
				if victim then
					-- slight delay so fake and real tells don't visibly pair up
					task.delay(2 + rng:NextNumber() * 6, function()
						if generation ~= myGen then
							return
						end
						local model = ctx.services.DollService.getModel(victim)
						local tellId = pickTell(rng, false, model)
						if tellId then
							Util.safeCall("fakeTell", function()
								ctx.services.DollService.performTell(victim, tellId)
							end)
						end
					end)
				end
			end
		end
	end)
end

function TellService.stopShift()
	generation += 1
end

return TellService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">WatchService</string>
            <string name="Source"><![CDATA[--!strict
-- Watched-check: clients stream camera CFrames; server does authoritative cone + occlusion tests.
-- Fallback to character facing when a client has no fresh report (plan review fix).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any

local WatchService = {}

local reports: { [Player]: { cframe: CFrame, at: number } } = {}
local ctx: any

function WatchService.init(context: any)
	ctx = context
	Remotes.get(Remotes.Names.CameraReport).OnServerEvent:Connect(function(player: Player, cf: any)
		if typeof(cf) ~= "CFrame" then
			return
		end
		local char = player.Character
		local head = char and char:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			if (cf.Position - head.Position).Magnitude > 25 then
				return -- stale/spoofed
			end
		end
		reports[player] = { cframe = cf, at = os.clock() }
	end)
	Players.PlayerRemoving:Connect(function(player)
		reports[player] = nil
	end)
end

local function viewCFrameFor(player: Player): CFrame?
	local rep = reports[player]
	if rep and os.clock() - rep.at < 1 then
		return rep.cframe
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		return hrp.CFrame
	end
	return nil
end

local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude

local function seesPoint(viewCf: CFrame, point: Vector3, excludes: { Instance }): boolean
	local offset = point - viewCf.Position
	local dist = offset.Magnitude
	if dist > Config.Tells.WatchMaxDistance then
		return false
	end
	if dist < 1 then
		return true
	end
	local cosAngle = viewCf.LookVector:Dot(offset.Unit)
	if cosAngle < math.cos(math.rad(Config.Tells.WatchFovDegrees / 2)) then
		return false
	end
	raycastParams.FilterDescendantsInstances = excludes
	local hit = workspace:Raycast(viewCf.Position, offset, raycastParams)
	return hit == nil
end

function WatchService.isWatched(model: Model): boolean
	local target = model:FindFirstChild("Head") or model.PrimaryPart
	if not (target and target:IsA("BasePart")) then
		return false
	end
	local excludes: { Instance } = { model }
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(excludes, player.Character)
		end
	end
	for _, player in Players:GetPlayers() do
		local viewCf = viewCFrameFor(player)
		if viewCf and seesPoint(viewCf, target.Position, excludes) then
			return true
		end
	end
	return false
end

function WatchService.watchedMap(): { [string]: boolean }
	local out: { [string]: boolean } = {}
	local DollService = ctx.services.DollService
	for _, dollId in DollService.getDollIds() do
		local model = DollService.getModel(dollId)
		out[dollId] = model ~= nil and WatchService.isWatched(model)
	end
	return out
end

return WatchService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="44">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="45">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">14</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="46">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="47">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--!strict
-- Client bootstrap: init every controller, each pcall'd so one failure can't kill the client.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any

local Controllers = script:WaitForChild("Controllers")

local ORDER = {
	"Toast",
	"Hud",
	"MinigameController",
	"NamingUI",
	"LedgerUI",
	"BanishConfirmUI",
	"RecapUI",
	"Shop",
	"Classes",
	"Journal",
	"InviteButton",
	"JoinSquareUI",
	"LobbyHud",
	"PresenceClient",
	"HauntClient",
	"DetectorClient",
	"CameraReporter",
	"PanicEmote",
	"DebugOverlay",
	"ErrorPanel",
}

for _, name in ORDER do
	local module = Controllers:WaitForChild(name, 10)
	if module and module:IsA("ModuleScript") then
		local ok, err = pcall(function()
			(require(module) :: any).init()
		end)
		if not ok then
			Util.warn(("Controller '%s' FAILED to init: %s"):format(name, tostring(err)))
		end
	else
		Util.warn(("Controller '%s' missing"):format(name))
	end
end

Util.log(("client up — v%s (%s)"):format(Config.Version, Config.BuildStamp))
]]></string>
        </Properties>
        <Item class="Folder" referent="48">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">BanishConfirmUI</string>
              <string name="Source"><![CDATA[--!strict
-- The group-confirm modal: "Banish <NAME>?" with live countdown.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local BanishConfirmUI = {}

local gui: ScreenGui? = nil
local modal: Frame? = nil
local titleLabel: TextLabel? = nil
local countdownLabel: TextLabel? = nil
local confirmed = false

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainBanishConfirm", 14)
	g.Enabled = false
	g.Parent = playerGui
	gui = g

	local m = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.42, 0),
		Size = UDim2.new(0, 440, 0, 230),
		BackgroundTransparency = 0.04,
	})
	modal = m
	titleLabel = Theme.label(m, {
		Position = UDim2.new(0, 16, 0, 16),
		Size = UDim2.new(1, -32, 0, 70),
		Font = Theme.TitleFont,
		TextSize = 30,
		Text = "",
	})
	countdownLabel = Theme.label(m, {
		Position = UDim2.new(0, 16, 0, 88),
		Size = UDim2.new(1, -32, 0, 24),
		TextSize = 16,
		TextColor3 = Theme.Muted,
		Text = "",
	})
	local confirm = Theme.button(m, {
		Position = UDim2.new(0, 24, 1, -84),
		Size = UDim2.new(0.5, -36, 0, 64),
		TextSize = 24,
		Text = "BANISH",
	})
	local refuse = Theme.button(m, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -24, 1, -84),
		Size = UDim2.new(0.5, -36, 0, 64),
		TextSize = 24,
		Text = "WAIT, NO",
	})
	confirm.Activated:Connect(function()
		if not confirmed then
			confirmed = true
			SoundKit.play("UiConfirm")
			Remotes.get(Remotes.Names.ConfirmBanish):FireServer(true)
			confirm.Text = "WAITING…"
		end
	end)
	refuse.Activated:Connect(function()
		SoundKit.play("UiClick")
		Remotes.get(Remotes.Names.ConfirmBanish):FireServer(false)
	end)
end

function BanishConfirmUI.init()
	build()

	Remotes.get(Remotes.Names.BanishPrompt).OnClientEvent:Connect(function(dollId: any, dollName: any, extra: any)
		local g = gui
		if not g then
			return
		end
		if typeof(extra) == "table" and extra.cancelled then
			g.Enabled = false
			confirmed = false
			return
		end
		if typeof(dollId) == "string" and typeof(dollName) == "string" then
			if not g.Enabled then
				confirmed = false
				local confirmButton = modal and modal:FindFirstChildOfClass("TextButton")
				if confirmButton then
					confirmButton.Text = "BANISH"
				end
			end
			g.Enabled = true
			if titleLabel then
				titleLabel.Text = ("Banish %s?"):format(dollName)
			end
		end
		if typeof(extra) == "table" and typeof(extra.countdown) == "number" and countdownLabel then
			countdownLabel.Text = ("Banishing in %d… (refuse to stop it)"):format(extra.countdown)
		end
	end)

	Remotes.get(Remotes.Names.BanishResult).OnClientEvent:Connect(function()
		local g = gui
		if g then
			g.Enabled = false
		end
		confirmed = false
	end)

	-- B3 fix: belt-and-suspenders close. State transitions are the more fundamental signal.
	Remotes.get(Remotes.Names.StateChanged).OnClientEvent:Connect(function(state: any)
		if state == "RunEnd" or state == "LobbyIdle" then
			local g = gui
			if g then
				g.Enabled = false
			end
			confirmed = false
		end
	end)
end

return BanishConfirmUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">CameraReporter</string>
              <string name="Source"><![CDATA[--!strict
-- Streams the local camera CFrame so the server can run the watched-check (Weeping Angels rule).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any

local CameraReporter = {}

function CameraReporter.init()
	local remote = Remotes.get(Remotes.Names.CameraReport)
	local interval = 1 / Config.Tells.WatchReportHz
	local acc = 0
	RunService.RenderStepped:Connect(function(dt: number)
		acc += dt
		if acc < interval then
			return
		end
		acc = 0
		local camera = workspace.CurrentCamera
		if camera then
			remote:FireServer(camera.CFrame)
		end
	end)
end

return CameraReporter
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Classes</string>
              <string name="Source"><![CDATA[--!strict
-- Dedicated Classes screen: browse the full roster (owned + locked), preview the selected one, and
-- equip an owned class. Separate from Shop.luau (which handles BUYING) per the team's own reference
-- screenshots -- Animal Hospital's "Classes" screen is a distinct list-with-lock-icons + equip flow,
-- not folded into the shop. Reuses Shop.luau's exact remotes (CoinsUpdate, ClassesData) -- no new
-- remotes needed.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Classes = require(Shared:WaitForChild("Defs"):WaitForChild("Classes")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local ClassesUI = {}

local gui: ScreenGui? = nil
local listFrame: ScrollingFrame? = nil
local descLabel: TextLabel? = nil
local equipButton: TextButton? = nil
local nameLabel: TextLabel? = nil

local owned: { [string]: boolean } = {}
local equipped = Classes.starterId
local selectedId = Classes.starterId

local function isOwnedLocally(classId: string): boolean
	local def = Classes.byId[classId]
	if not def then
		return false
	end
	return def.price <= 0 or owned[classId] == true
end

local function refreshDetail()
	local def = Classes.byId[selectedId]
	if not def then
		return
	end
	if nameLabel then
		nameLabel.Text = def.name
	end
	if descLabel then
		descLabel.Text = def.description
	end
	local ownedNow = isOwnedLocally(selectedId)
	local equippedNow = equipped == selectedId
	if equipButton then
		equipButton.Text = if equippedNow then "EQUIPPED" elseif ownedNow then "EQUIP" else "BUY IN SHOP"
		equipButton.Active = ownedNow and not equippedNow
		equipButton.BackgroundColor3 = if ownedNow and not equippedNow then Theme.Gold else Theme.BgSoft
		equipButton.TextColor3 = if ownedNow and not equippedNow then Color3.fromRGB(30, 24, 20) else Theme.Muted
	end
end

local function refreshList()
	local list = listFrame
	if not list then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	for _, def in Classes.list do
		local ownedNow = isOwnedLocally(def.id)
		local equippedNow = equipped == def.id
		local selectedNow = selectedId == def.id
		local row = Theme.button(list, {
			Size = UDim2.new(1, 0, 0, 56), -- mobile touch target
			TextSize = 18,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = if ownedNow then ("  " .. def.name) else ("  🔒 " .. def.name),
		})
		row.BackgroundColor3 = if equippedNow then Theme.Gold elseif selectedNow then Theme.Accent else Theme.BgSoft
		row.TextColor3 = if equippedNow then Color3.fromRGB(30, 24, 20) else Theme.Muted
		row.Activated:Connect(function()
			selectedId = def.id
			SoundKit.play("UiClick")
			refreshList()
			refreshDetail()
		end)
	end
end

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainClasses", 13)
	g.Enabled = false
	g.Parent = playerGui
	gui = g

	local panel = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0.94, 0, 0.86, 0),
		BackgroundTransparency = 0.02,
	})
	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = Vector2.new(320, 380)
	constraint.MaxSize = Vector2.new(680, 520)
	constraint.Parent = panel

	Theme.label(panel, {
		Position = UDim2.new(0, 0, 0, 10),
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.TitleFont,
		TextSize = 26,
		Text = "— Choose Your Class —",
	})

	local close = Theme.button(panel, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.new(0, 56, 0, 44),
		TextSize = 20,
		Text = "✕",
	})
	close.Activated:Connect(function()
		ClassesUI.close()
	end)

	-- left: scrollable class list (locked entries show a padlock, matches the team's reference screenshots)
	local list = Instance.new("ScrollingFrame")
	list.BackgroundTransparency = 1
	list.Position = UDim2.new(0, 14, 0, 56)
	list.Size = UDim2.new(0.42, -20, 1, -70)
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = 6
	list.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.Parent = list
	listFrame = list

	-- right: selected-class detail + Equip button
	local detail = Theme.panel(panel, {
		Position = UDim2.new(0.44, 0, 0, 56),
		Size = UDim2.new(0.56, -14, 1, -70),
		BackgroundTransparency = 0.15,
	})
	nameLabel = Theme.label(detail, {
		Position = UDim2.new(0, 14, 0, 14),
		Size = UDim2.new(1, -28, 0, 30),
		Font = Theme.TitleFont,
		TextSize = 24,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "",
	})
	descLabel = Theme.label(detail, {
		Position = UDim2.new(0, 14, 0, 50),
		Size = UDim2.new(1, -28, 1, -130),
		TextSize = 16,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Text = "",
	})
	local equip = Theme.button(detail, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(0, 200, 0, 64), -- mobile-first: >=64px touch target
		TextSize = 18,
		Text = "EQUIP",
	})
	equip.Activated:Connect(function()
		if not isOwnedLocally(selectedId) or equipped == selectedId then
			return
		end
		SoundKit.play("UiClick")
		Remotes.get(Remotes.Names.EquipClass):FireServer(selectedId)
	end)
	equipButton = equip

	refreshList()
	refreshDetail()
end

function ClassesUI.open()
	if gui then
		gui.Enabled = true
		SoundKit.play("UiConfirm")
		refreshList()
		refreshDetail()
	end
end

function ClassesUI.close()
	if gui then
		gui.Enabled = false
	end
end

function ClassesUI.init()
	build()

	local openBindable: BindableEvent
	local existing = ReplicatedStorage:FindFirstChild("PorcelainOpenPanel")
	if existing and existing:IsA("BindableEvent") then
		openBindable = existing
	else
		openBindable = Instance.new("BindableEvent")
		openBindable.Name = "PorcelainOpenPanel"
		openBindable.Parent = ReplicatedStorage
	end
	openBindable.Event:Connect(function(panelName: string?)
		if panelName == "Classes" then
			ClassesUI.open()
		end
	end)

	Remotes.get(Remotes.Names.ClassesData).OnClientEvent:Connect(function(data: any)
		if typeof(data) ~= "table" then
			return
		end
		if typeof(data.owned) == "table" then
			owned = data.owned
		end
		if typeof(data.equipped) == "string" then
			equipped = data.equipped
			selectedId = equipped
		end
		refreshList()
		refreshDetail()
	end)

	Remotes.get(Remotes.Names.StateChanged).OnClientEvent:Connect(function(state: any)
		if state ~= "LobbyIdle" then
			ClassesUI.close()
		end
	end)
end

return ClassesUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">DebugOverlay</string>
              <string name="Source"><![CDATA[--!strict
-- Debug overlay (R7): presence, tier, state, watched map, marked doll. DebugMode only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local DebugOverlay = {}

function DebugOverlay.init()
	if not Config.DebugMode then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Theme.screenGui("PorcelainDebug", 25)
	gui.Parent = playerGui
	local panel = Theme.panel(gui, {
		Position = UDim2.new(0, 8, 0.35, 0),
		Size = UDim2.new(0, 240, 0, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.35,
	})
	local text = Theme.label(panel, {
		Position = UDim2.new(0, 8, 0, 6),
		Size = UDim2.new(1, -16, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Enum.Font.Code,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "debug: waiting…",
	})
	local pad = Instance.new("UIPadding")
	pad.PaddingBottom = UDim.new(0, 8)
	pad.Parent = panel

	Remotes.get(Remotes.Names.DebugInfo).OnClientEvent:Connect(function(payload: any)
		if typeof(payload) ~= "table" then
			return
		end
		local lines = {
			("state: %s   shift: %s"):format(tostring(payload.state), tostring(payload.shift)),
			("presence: %s  tier: %s"):format(tostring(payload.presence), tostring(payload.tier)),
			("marked: %s"):format(tostring(payload.marked)),
			"watched:",
		}
		if typeof(payload.watched) == "table" then
			for dollId, watched in payload.watched do
				table.insert(lines, ("  %s %s"):format(if watched then "👁" else "·", tostring(dollId)))
			end
		end
		text.Text = table.concat(lines, "\n")
	end)
end

return DebugOverlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">DetectorClient</string>
              <string name="Source"><![CDATA[--!strict
-- Spirit Compass feel: passive rattle rate + glow by distance to the nearest uncollected glyph.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any

local DetectorClient = {}

local equipped: Tool? = nil
local lastTick = 0

local function watchCharacter(char: Model)
	char.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child.Name == "Spirit Compass" then
			equipped = child
		end
	end)
	char.ChildRemoved:Connect(function(child)
		if child == equipped then
			equipped = nil
		end
	end)
	local existing = char:FindFirstChild("Spirit Compass")
	if existing and existing:IsA("Tool") then
		equipped = existing
	end
end

function DetectorClient.init()
	if not Config.Features.Detector then
		return
	end
	local player = Players.LocalPlayer
	if player.Character then
		watchCharacter(player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)

	RunService.Heartbeat:Connect(function()
		local tool = equipped
		if not tool then
			return
		end
		local handle = tool:FindFirstChild("Handle")
		local targets = tool:FindFirstChild("GlyphTargets")
		if not (handle and handle:IsA("BasePart") and targets) then
			return
		end
		local best = math.huge
		for _, value in targets:GetChildren() do
			if value:IsA("Vector3Value") then
				local d = (value.Value - handle.Position).Magnitude
				best = math.min(best, d)
			end
		end
		local light = handle:FindFirstChild("GlowLight")
		if best == math.huge or best > Config.Glyphs.DetectorMaxRange then
			if light and light:IsA("PointLight") then
				light.Brightness = 0
			end
			return
		end
		local closeness = 1 - best / Config.Glyphs.DetectorMaxRange -- 0..1
		if light and light:IsA("PointLight") then
			light.Brightness = 0.2 + closeness * 3
		end
		-- tick rate 0.2..5 Hz by proximity
		local rate = 0.2 + closeness * 4.8
		local now = os.clock()
		if now - lastTick >= 1 / rate then
			lastTick = now
			SoundKit.play("DetectorTick")
		end
	end)
end

return DetectorClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">ErrorPanel</string>
              <string name="Source"><![CDATA[--!strict
-- Error panel (R7): last 10 client errors, screenshot-friendly, toggled by a small bug button.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ScriptContext = game:GetService("ScriptContext")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local ErrorPanel = {}

local errors: { string } = {}

function ErrorPanel.init()
	if not Config.DebugMode then
		return
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Theme.screenGui("PorcelainErrors", 26)
	gui.Parent = playerGui

	local panel = Theme.panel(gui, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -90),
		Size = UDim2.new(0, 420, 0, 200),
		BackgroundTransparency = 0.15,
		Visible = false,
	})
	local text = Theme.label(panel, {
		Position = UDim2.new(0, 8, 0, 26),
		Size = UDim2.new(1, -16, 1, -34),
		Font = Enum.Font.Code,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Theme.Danger,
		Text = "no client errors 🎉  (server errors: check Studio Output)",
	})
	Theme.label(panel, {
		Position = UDim2.new(0, 8, 0, 4),
		Size = UDim2.new(1, -16, 0, 20),
		TextSize = 13,
		TextColor3 = Theme.Muted,
		Text = "last 10 client errors — screenshot this for bug reports",
	})

	local toggle = Theme.button(gui, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 8, 1, -14),
		Size = UDim2.new(0, 64, 0, 64),
		TextSize = 26,
		Text = "🐞",
	})
	toggle.Activated:Connect(function()
		panel.Visible = not panel.Visible
	end)

	ScriptContext.Error:Connect(function(message: string, _trace: string, _source: Instance?)
		table.insert(errors, 1, ("[%s] %s"):format(os.date("%H:%M:%S"), message))
		while #errors > 10 do
			table.remove(errors)
		end
		text.Text = table.concat(errors, "\n")
	end)
end

return ErrorPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">HauntClient</string>
              <string name="Source"><![CDATA[--!strict
-- Client-scope haunts: WhisperPass, the Taken stub, the DollmakerReveal run-end scare, and the
-- B9 ShiftTimeout closing beat (calm, deliberately NOT a scare).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local HauntClient = {}

local gui: ScreenGui? = nil

local function cameraShake(intensity: number, duration: number)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	task.spawn(function()
		local t0 = os.clock()
		while os.clock() - t0 < duration do
			local offset = CFrame.new(
				(math.random() - 0.5) * intensity,
				(math.random() - 0.5) * intensity,
				0
			)
			camera.CFrame = camera.CFrame * offset
			task.wait(0.03)
		end
	end)
end

local function whisperPass()
	SoundKit.play("WhisperPass")
	cameraShake(0.08, 0.6)
	local g = gui
	if not g then
		return
	end
	local vignette = Instance.new("Frame")
	vignette.BackgroundColor3 = Color3.new(0, 0, 0)
	vignette.BackgroundTransparency = 1
	vignette.BorderSizePixel = 0
	vignette.Size = UDim2.new(1, 0, 1, 0)
	vignette.Parent = g
	TweenService:Create(vignette, TweenInfo.new(0.3), { BackgroundTransparency = 0.55 }):Play()
	task.delay(0.8, function()
		TweenService:Create(vignette, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
		task.delay(1.1, function()
			vignette:Destroy()
		end)
	end)
end

local function takenStub()
	local g = gui
	if not g then
		return
	end
	local dark = Instance.new("Frame")
	dark.BackgroundColor3 = Color3.new(0, 0, 0)
	dark.BackgroundTransparency = 0.2
	dark.BorderSizePixel = 0
	dark.Size = UDim2.new(1, 0, 1, 0)
	dark.Parent = g
	local label = Theme.label(dark, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0.8, 0, 0, 60),
		Font = Theme.TitleFont,
		TextSize = 32,
		Text = "wake up… (tap 5 times)",
	})
	local taps = 0
	local button = Instance.new("TextButton")
	button.BackgroundTransparency = 1
	button.Size = UDim2.new(1, 0, 1, 0)
	button.Text = ""
	button.Parent = dark
	button.Activated:Connect(function()
		taps += 1
		label.Text = ("wake up… (%d more)"):format(math.max(0, 5 - taps))
		if taps >= 5 then
			dark:Destroy()
		end
	end)
	task.delay(20, function() -- hard auto-clear (R2)
		if dark.Parent then
			dark:Destroy()
		end
	end)
end

local function dollmakerReveal()
	local g = gui
	if not g then
		return
	end
	local dark = Instance.new("Frame")
	dark.BackgroundColor3 = Color3.new(0, 0, 0)
	dark.BackgroundTransparency = 0
	dark.BorderSizePixel = 0
	dark.Size = UDim2.new(1, 0, 1, 0)
	dark.ZIndex = 5
	dark.Parent = g
	task.delay(0.5, function()
		SoundKit.play("DollmakerScream")
		cameraShake(0.35, 1.2)
		-- the towering shadow face, assembled from frames
		local face = Instance.new("Frame")
		face.AnchorPoint = Vector2.new(0.5, 0.5)
		face.Position = UDim2.new(0.5, 0, 1.4, 0)
		face.Size = UDim2.new(0, 500, 0, 620)
		face.BackgroundTransparency = 1
		face.ZIndex = 6
		face.Parent = dark
		local function facePart(pos: UDim2, size: UDim2, color: Color3, rotation: number?)
			local frame = Instance.new("Frame")
			frame.AnchorPoint = Vector2.new(0.5, 0.5)
			frame.Position = pos
			frame.Size = size
			frame.Rotation = rotation or 0
			frame.BackgroundColor3 = color
			frame.BorderSizePixel = 0
			frame.ZIndex = 6
			frame.Parent = face
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0.5, 0)
			corner.Parent = frame
		end
		local shadow = Color3.fromRGB(16, 12, 18)
		local eye = Color3.fromRGB(212, 175, 96)
		facePart(UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.9, 0.95), shadow) -- head mass
		facePart(UDim2.fromScale(0.32, 0.38), UDim2.fromScale(0.16, 0.1), eye) -- left eye
		facePart(UDim2.fromScale(0.68, 0.36), UDim2.fromScale(0.13, 0.13), eye, 12) -- right eye, wrong size
		facePart(UDim2.fromScale(0.5, 0.68), UDim2.fromScale(0.5, 0.05), Color3.fromRGB(60, 40, 50), -6) -- stitched smile
		for i = 1, 6 do
			facePart(
				UDim2.fromScale(0.28 + (i - 1) * 0.09, 0.68 + (if i % 2 == 0 then 0.03 else -0.03)),
				UDim2.fromScale(0.02, 0.09),
				Color3.fromRGB(60, 40, 50),
				15
			)
		end
		TweenService:Create(face, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, 0, 0.5, 0),
		}):Play()
		task.delay(2.5, function()
			TweenService:Create(dark, TweenInfo.new(1.5), { BackgroundTransparency = 1 }):Play()
			for _, child in face:GetChildren() do
				if child:IsA("Frame") then
					TweenService:Create(child, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
				end
			end
			task.delay(1.6, function()
				dark:Destroy()
			end)
		end)
	end)
end

-- B9: the watchdog-timeout RunEnd -- a calm "closing time" beat, deliberately NOT a scare.
local function shiftTimeout()
	local g = gui
	if not g then
		return
	end
	SoundKit.play("DoorSlam") -- existing placeholder cue, thematically a closing door (id currently 0/silent)
	local dim = Instance.new("Frame")
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 1
	dim.BorderSizePixel = 0
	dim.Size = UDim2.new(1, 0, 1, 0)
	dim.ZIndex = 5
	dim.Parent = g
	local label = Theme.label(dim, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0.8, 0, 0, 80),
		Font = Theme.TitleFont,
		TextSize = 34,
		TextColor3 = Theme.Muted,
		TextTransparency = 1,
		ZIndex = 6,
		Text = "The shop is closing for the night…",
	})
	TweenService:Create(dim, TweenInfo.new(0.8), { BackgroundTransparency = 0.55 }):Play()
	TweenService:Create(label, TweenInfo.new(0.8), { TextTransparency = 0 }):Play()
	task.delay(3.5, function()
		TweenService:Create(dim, TweenInfo.new(1), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, TweenInfo.new(1), { TextTransparency = 1 }):Play()
		task.delay(1.1, function()
			dim:Destroy()
		end)
	end)
end

function HauntClient.init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainHaunts", 18)
	g.Parent = playerGui
	gui = g

	Remotes.get(Remotes.Names.HauntFired).OnClientEvent:Connect(function(hauntId: any)
		if hauntId == "WhisperPass" then
			whisperPass()
		elseif hauntId == "Taken" then
			takenStub()
		elseif hauntId == "DollmakerReveal" then
			dollmakerReveal()
		elseif hauntId == "ShiftTimeout" then
			shiftTimeout()
		end
		-- unknown ids: ignore silently
	end)
end

return HauntClient
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
-- HUD: shift banner, objective, strikes, doll checklist (5 listed steps only), countdown, version stamp.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local CareSteps = require(Shared:WaitForChild("Defs"):WaitForChild("CareSteps")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local Hud = {}

local shiftLabel: TextLabel? = nil
local objectiveLabel: TextLabel? = nil
local strikePips: { Frame } = {}
local dollList: Frame? = nil
local countdownLabel: TextLabel? = nil
local dollRows: { [string]: { row: Frame, ticks: { Frame }, nameLabel: TextLabel } } = {}

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Theme.screenGui("PorcelainHud", 5)
	gui.Parent = playerGui

	-- top center: shift + objective
	local top = Instance.new("Frame")
	top.BackgroundTransparency = 1
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, 12)
	top.Size = UDim2.new(0.6, 0, 0, 100)
	top.Parent = gui
	shiftLabel = Theme.label(top, {
		Size = UDim2.new(1, 0, 0, 52),
		Font = Theme.TitleFont,
		TextSize = 46,
		Text = "",
		TextStrokeTransparency = 0.5,
	})
	objectiveLabel = Theme.label(top, {
		Position = UDim2.new(0, 0, 0, 52),
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.BodyFont,
		TextSize = 18,
		TextColor3 = Theme.Muted,
		Text = "",
		TextStrokeTransparency = 0.6,
	})

	-- strikes under objective
	local strikeRow = Instance.new("Frame")
	strikeRow.BackgroundTransparency = 1
	strikeRow.AnchorPoint = Vector2.new(0.5, 0)
	strikeRow.Position = UDim2.new(0.5, 0, 0, 86)
	strikeRow.Size = UDim2.new(0, 120, 0, 18)
	strikeRow.Parent = top
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 8)
	layout.Parent = strikeRow
	for _ = 1, Config.Shift.StrikeLimit do
		local pip = Instance.new("Frame")
		pip.Size = UDim2.new(0, 14, 0, 14)
		pip.BackgroundColor3 = Theme.BgSoft
		pip.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = pip
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Danger
		stroke.Transparency = 0.4
		stroke.Parent = pip
		pip.Parent = strikeRow
		table.insert(strikePips, pip)
	end

	-- right side: doll checklist
	dollList = Theme.panel(gui, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.new(0, 210, 0, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0.35,
		Visible = false,
	})
	local listLayout = Instance.new("UIListLayout")
	listLayout.Padding = UDim.new(0, 6)
	listLayout.Parent = dollList
	local listPad = Instance.new("UIPadding")
	listPad.PaddingTop = UDim.new(0, 8)
	listPad.PaddingBottom = UDim.new(0, 8)
	listPad.PaddingLeft = UDim.new(0, 8)
	listPad.PaddingRight = UDim.new(0, 8)
	listPad.Parent = dollList

	-- lobby countdown overlay
	countdownLabel = Theme.label(gui, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 130),
		Size = UDim2.new(0, 400, 0, 60),
		Font = Theme.TitleFont,
		TextSize = 40,
		TextColor3 = Theme.Accent,
		Text = "",
		TextStrokeTransparency = 0.4,
	})

	-- version stamp
	Theme.label(gui, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.new(0, 300, 0, 16),
		Font = Enum.Font.Code,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Muted,
		TextTransparency = 0.4,
		Text = ("%s %s"):format(Config.Version, Config.BuildStamp),
	})
end

local function addDollRow(dollId: string, name: string)
	local list = dollList
	if not list then
		return
	end
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 40)
	row.Parent = list
	local nameLabel = Theme.label(row, {
		Size = UDim2.new(1, 0, 0, 20),
		Font = Theme.TitleFont,
		TextSize = 19,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = name,
	})
	local ticksRow = Instance.new("Frame")
	ticksRow.BackgroundTransparency = 1
	ticksRow.Position = UDim2.new(0, 0, 0, 22)
	ticksRow.Size = UDim2.new(1, 0, 0, 14)
	ticksRow.Parent = row
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.Padding = UDim.new(0, 6)
	layout.Parent = ticksRow
	local ticks = {}
	for _ in CareSteps.list do
		local tick = Instance.new("Frame")
		tick.Size = UDim2.new(0, 22, 0, 10)
		tick.BackgroundColor3 = Theme.BgSoft
		tick.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 3)
		corner.Parent = tick
		tick.Parent = ticksRow
		table.insert(ticks, tick)
	end
	dollRows[dollId] = { row = row, ticks = ticks, nameLabel = nameLabel }
end

function Hud.init()
	build()

	Remotes.get(Remotes.Names.StateChanged).OnClientEvent:Connect(function(state: any, data: any)
		if typeof(data) ~= "table" then
			return
		end
		if shiftLabel then
			shiftLabel.Text = if state == "LobbyIdle" then "THE DOLLMAKER'S" else ("SHIFT %d"):format(data.shift or 1)
		end
		if objectiveLabel then
			objectiveLabel.Text = data.objective or ""
		end
		-- B4 fix: defensively force strike pips to zero on LobbyIdle regardless of whatever
		-- `strikes` value is in this particular payload.
		local displayStrikes = if state == "LobbyIdle" then 0 else (data.strikes or 0)
		for i, pip in strikePips do
			pip.BackgroundColor3 = if i <= displayStrikes then Theme.Danger else Theme.BgSoft
		end
		if dollList and (state == "LobbyIdle" or state == "RunEnd") then
			dollList.Visible = false
			for _, entry in dollRows do
				entry.row:Destroy()
			end
			dollRows = {}
		end
	end)

	Remotes.get(Remotes.Names.ShiftData).OnClientEvent:Connect(function(data: any)
		if typeof(data) ~= "table" or typeof(data.dolls) ~= "table" then
			return
		end
		for _, entry in dollRows do
			entry.row:Destroy()
		end
		dollRows = {}
		if dollList then
			dollList.Visible = true
		end
		for _, doll in data.dolls do
			addDollRow(doll.id, doll.name)
		end
	end)

	Remotes.get(Remotes.Names.DollUpdate).OnClientEvent:Connect(function(dollId: any, update: any)
		local entry = dollRows[dollId]
		if not entry or typeof(update) ~= "table" then
			return
		end
		if update.removed == true then
			-- B8 fix: a consumed doll must stop reading as a fully-cared-for, still-in-play doll.
			entry.nameLabel.Text = ("%s — gone"):format(entry.nameLabel.Text)
			entry.nameLabel.TextColor3 = Theme.Muted
			for _, tick in entry.ticks do
				tick.BackgroundColor3 = Theme.BgSoft
			end
			return
		end
		if typeof(update.name) == "string" then
			entry.nameLabel.Text = update.name
		end
		if typeof(update.careDone) == "table" then
			local doneSet: { [string]: boolean } = {}
			for _, stepId in update.careDone do
				doneSet[stepId] = true
			end
			for i, step in CareSteps.list do
				if doneSet[step.id] and entry.ticks[i] then
					entry.ticks[i].BackgroundColor3 = Theme.Gold
				end
			end
		end
		if update.done == true then
			entry.nameLabel.TextColor3 = Theme.Gold
		end
	end)

	Remotes.get(Remotes.Names.ReadyCountdown).OnClientEvent:Connect(function(seconds: any)
		if countdownLabel then
			countdownLabel.Text = if typeof(seconds) == "number" then ("The shift begins in %d…"):format(seconds) else ""
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">InviteButton</string>
              <string name="Source"><![CDATA[--!strict
-- Invite: Roblox's native friend-invite prompt via SocialService, entirely client-side (R3
-- pcall-wrapped via Util.safeCall). Wires to any GuiButton tagged "InviteButtonTag" so whichever
-- controller builds the physical left-nav HUD button only needs to CollectionService:AddTag() it.
-- If nothing has claimed the tag, an optional fallback button ships behind
-- Config.Features.InviteFallbackButton (default false).

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Util = require(Shared:WaitForChild("Util")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any
local Toast = require(script.Parent:WaitForChild("Toast")) :: any

local InviteButton = {}

local TAG = "InviteButtonTag"

local function disableButton(button: GuiButton, message: string)
	button.Active = false
	button.AutoButtonColor = false
	if button:IsA("TextButton") then
		button.BackgroundColor3 = Theme.BgSoft
		button.TextColor3 = Theme.Muted
	end
	Toast.show(message, 4)
end

local function trySendInvite(button: GuiButton)
	local player = Players.LocalPlayer
	local canInvite = false
	local checkOk = Util.safeCall("canSendGameInvite", function()
		canInvite = SocialService:CanSendGameInviteAsync(player)
	end)
	if not checkOk or not canInvite then
		disableButton(button, "Invites aren't available right now on this device or platform.")
		return
	end
	local promptOk = Util.safeCall("promptGameInvite", function()
		SocialService:PromptGameInvite(player)
	end)
	if not promptOk then
		Toast.show("Couldn't open the invite prompt — try again in a moment.", 4)
	end
end

local function wire(inst: Instance)
	if not inst:IsA("GuiButton") then
		return
	end
	local button = inst :: GuiButton
	button.Activated:Connect(function()
		trySendInvite(button)
	end)
end

local function buildFallbackButton()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = Theme.screenGui("PorcelainInviteFallback", 8)
	gui.Parent = playerGui
	local button = Theme.button(gui, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -16),
		Size = UDim2.new(0, 150, 0, 64), -- mobile touch target
		TextSize = 18,
		Text = "Invite Friends",
	})
	CollectionService:AddTag(button, TAG) -- triggers wire() via the signal below, no double-path needed
end

function InviteButton.init()
	for _, inst in CollectionService:GetTagged(TAG) do
		wire(inst)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(wire)

	if Config.Features.InviteFallbackButton then
		buildFallbackButton()
	end
end

return InviteButton
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">JoinSquareUI</string>
              <string name="Source"><![CDATA[--!strict
-- Bottom-of-screen action bar shown while the local player stands inside a Join Square:
-- Exit / Skip Tutorial (only once unlocked) / Start Now. Mirrors BanishConfirmUI's panel-with-
-- buttons construction, bottom-anchored instead of center-anchored (mobile-first).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local JoinSquareUI = {}

local localPlayer = Players.LocalPlayer

local gui: ScreenGui? = nil
local countdownLabel: TextLabel? = nil
local skipButton: TextButton? = nil
local currentSquareId: string? = nil
local lastLocalPhase: string? = nil -- tracks the local player's own square, so the lock-in chime fires once
-- fed by the PlayerStats remote (QuestService.broadcastStats); real value, not a stub -- the
-- Social track's tutorial-gate design suppresses first-shift hints once this flips true, and this
-- button intentionally stays available even then (see "READ THIS FIRST" §5's option (a)).
local tutorialDone = false

local function build()
	local playerGui = localPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainJoinSquare", 12)
	g.Enabled = false
	g.Parent = playerGui
	gui = g

	local panel = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -18),
		Size = UDim2.new(0.94, 0, 0, 150),
		BackgroundTransparency = 0.06,
	})
	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(560, 220)
	sizeConstraint.MinSize = Vector2.new(300, 150)
	sizeConstraint.Parent = panel

	countdownLabel = Theme.label(panel, {
		Position = UDim2.new(0, 16, 0, 10),
		Size = UDim2.new(1, -32, 0, 28),
		TextSize = 18,
		TextColor3 = Theme.Accent,
		Text = "",
	})

	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Position = UDim2.new(0, 16, 0, 46)
	row.Size = UDim2.new(1, -32, 0, 84)
	row.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Padding = UDim.new(0, 10)
	layout.Parent = row

	-- Colors match the reference screenshots exactly: EXIT red, START NOW green, the middle
	-- (Skip Tutorial) button left at the theme's neutral default -- the reference shows it
	-- visibly blanked/disabled-looking whenever it's locked, which Theme.BgSoft + a disabled
	-- Active=false already achieves without a bespoke color (see tutorialDone gating below).
	local function actionButton(text: string, bg: Color3?): TextButton
		local button = Theme.button(row, {
			Size = UDim2.new(0.31, 0, 1, 0), -- relative width: scales down gracefully on narrow phones
			TextSize = 18,
			Text = text,
		})
		if bg then
			button.BackgroundColor3 = bg
		end
		return button
	end

	local exit = actionButton("EXIT", Theme.Danger) -- red, matches the reference
	local skip = actionButton("SKIP TUTORIAL")
	skip.Visible = false
	local start = actionButton("START NOW", Color3.fromRGB(70, 160, 80)) -- green, matches the reference
		-- (no confirmed Theme.* "success green" token exists yet in this codebase's Theme.luau --
		-- using an explicit literal here; if the team adds one, swap this for Theme.Success instead)

	exit.Activated:Connect(function()
		if not currentSquareId then
			return
		end
		SoundKit.play("UiClick")
		Remotes.get(Remotes.Names.JoinSquareAction):FireServer(currentSquareId, "Exit")
	end)
	start.Activated:Connect(function()
		if not currentSquareId then
			return
		end
		SoundKit.play("UiConfirm")
		Remotes.get(Remotes.Names.JoinSquareAction):FireServer(currentSquareId, "StartNow")
	end)
	skip.Activated:Connect(function()
		if not currentSquareId then
			return
		end
		SoundKit.play("UiClick")
		Remotes.get(Remotes.Names.JoinSquareAction):FireServer(currentSquareId, "SkipTutorial")
	end)

	skipButton = skip
end

local function setVisible(visible: boolean)
	local g = gui
	if not g then
		return
	end
	g.Enabled = visible
	if not visible then
		currentSquareId = nil
	end
end

function JoinSquareUI.init()
	build()

	Remotes.get(Remotes.Names.PlayerStats).OnClientEvent:Connect(function(stats: any)
		if typeof(stats) == "table" then
			tutorialDone = stats.tutorialDone == true
		end
	end)

	Remotes.get(Remotes.Names.JoinSquareUpdate).OnClientEvent:Connect(function(squareId: any, data: any)
		if typeof(squareId) ~= "string" or typeof(data) ~= "table" then
			return
		end
		local occupantIds = data.occupantUserIds
		local isLocalHere = typeof(occupantIds) == "table"
			and table.find(occupantIds, localPlayer.UserId) ~= nil
		if isLocalHere then
			currentSquareId = squareId
			setVisible(true)
			if skipButton then
				skipButton.Visible = tutorialDone
			end
			if data.phase == "Locking" and lastLocalPhase ~= "Locking" then
				SoundKit.play("SquareLockIn")
			end
			lastLocalPhase = data.phase
		elseif currentSquareId == squareId then
			-- we were in this square and just dropped out of its occupant list (Exit / walked away)
			setVisible(false)
			lastLocalPhase = nil
		end
	end)

	Remotes.get(Remotes.Names.JoinSquareCountdown).OnClientEvent:Connect(function(squareId: any, seconds: any)
		if squareId ~= currentSquareId or not countdownLabel then
			return
		end
		countdownLabel.Text = if typeof(seconds) == "number"
			then ("Shift starts in %d… (Exit to leave the group)"):format(seconds)
			else "Waiting for your group…"
	end)
end

return JoinSquareUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">Journal</string>
              <string name="Source"><![CDATA[--!strict
-- The Dollmaker's Journal: quest/checklist list with coin rewards. Opened via the left-side HUD
-- Nav bar firing ReplicatedStorage's "PorcelainOpenPanel" bindable with "Journal" (see
-- PACKET_1_LOBBY_SYSTEMS.md's integration notes), or directly via Journal.open()/.close()/.toggle()
-- (mirrors Toast's cross-controller export pattern, Toast.show).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Quests = require(Shared:WaitForChild("Defs"):WaitForChild("Quests")) :: any
local QuestProgress = require(Shared:WaitForChild("Logic"):WaitForChild("QuestProgress")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local Journal = {}

local gui: ScreenGui? = nil
local listFrame: ScrollingFrame? = nil
local latestStats: any = nil
local previousClaimed: { [string]: boolean } = {}

local HIDDEN_TITLE = "???"
local HIDDEN_DESC = "Something in the workshop is waiting to be found."

local function fillBar(parent: Instance, fraction: number)
	local track = Instance.new("Frame")
	track.BackgroundColor3 = Theme.BgSoft
	track.BorderSizePixel = 0
	track.Size = UDim2.new(1, 0, 0, 14)
	track.Parent = parent
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = track
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.BackgroundColor3 = Theme.Gold
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1)
	fill.Parent = track
	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 7)
	fillCorner.Parent = fill
end

local function buildCard(parent: Instance, quest: any, stats: any)
	local discovered = not quest.hidden or (stats.questFlags and stats.questFlags[quest.id] == true)
	local claimed = stats.claimedQuestIds and stats.claimedQuestIds[quest.id] == true
	local progress = QuestProgress.compute(stats, quest)
	local complete = progress >= quest.target

	local card = Theme.panel(parent, {
		Size = UDim2.new(1, -8, 0, 118),
		BackgroundTransparency = 0.15,
	})

	Theme.label(card, {
		Position = UDim2.new(0, 14, 0, 8),
		Size = UDim2.new(1, -28, 0, 24),
		Font = Theme.TitleFont,
		TextSize = 20,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = if discovered then quest.title else HIDDEN_TITLE,
	})

	Theme.label(card, {
		Position = UDim2.new(0, 14, 0, 32),
		Size = UDim2.new(1, -28, 0, 32),
		TextSize = 14,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		Text = if discovered then quest.description else HIDDEN_DESC,
	})

	local barHolder = Instance.new("Frame")
	barHolder.BackgroundTransparency = 1
	barHolder.Position = UDim2.new(0, 14, 0, 68)
	barHolder.Size = UDim2.new(1, -160, 0, 14)
	barHolder.Parent = card
	fillBar(barHolder, if quest.target > 0 then progress / quest.target else 0)

	Theme.label(card, {
		Position = UDim2.new(0, 14, 0, 86),
		Size = UDim2.new(1, -160, 0, 18),
		TextSize = 13,
		TextColor3 = Theme.Muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = if discovered
			then ("%d / %d  ·  +%d coins"):format(math.min(progress, quest.target), quest.target, quest.coinReward)
			else "? / ?",
	})

	local claimButton = Theme.button(card, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.new(0, 120, 0, 64), -- mobile touch target (>=64px)
		TextSize = 16,
		Text = if claimed then "Claimed" elseif complete then "Claim" else "Locked",
	})
	claimButton.AutoButtonColor = complete and not claimed
	if claimed or not complete then
		claimButton.BackgroundColor3 = Theme.BgSoft
		claimButton.TextColor3 = Theme.Muted
	end
	claimButton.Activated:Connect(function()
		if claimed or not complete then
			return
		end
		SoundKit.play("UiClick")
		Remotes.get(Remotes.Names.ClaimQuest):FireServer(quest.id)
	end)
end

local function refreshList()
	local list = listFrame
	if not list or not latestStats then
		return
	end
	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for _, quest in Quests.list do
		buildCard(list, quest, latestStats)
	end

	-- celebration beat: diff claimed sets, flash+chime any id that just newly appeared
	local newlyClaimed = false
	for id in latestStats.claimedQuestIds do
		if not previousClaimed[id] then
			newlyClaimed = true
			break
		end
	end
	if newlyClaimed then
		SoundKit.play("UiConfirm")
		if gui then
			local flash = Instance.new("Frame")
			flash.BackgroundColor3 = Theme.Gold
			flash.BackgroundTransparency = 0.55
			flash.BorderSizePixel = 0
			flash.Size = UDim2.fromScale(1, 1)
			flash.ZIndex = 50
			flash.Parent = gui
			TweenService:Create(flash, TweenInfo.new(0.6), { BackgroundTransparency = 1 }):Play()
			task.delay(0.65, function()
				flash:Destroy()
			end)
		end
	end
	previousClaimed = {}
	for id in latestStats.claimedQuestIds do
		previousClaimed[id] = true
	end
end

local function buildUI()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainJournal", 12)
	g.Enabled = false
	g.Parent = playerGui
	gui = g

	local backdrop = Instance.new("Frame")
	backdrop.BackgroundColor3 = Color3.new(0, 0, 0)
	backdrop.BackgroundTransparency = 0.4
	backdrop.Size = UDim2.fromScale(1, 1)
	backdrop.Parent = g

	local panel = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 560, 0, 560),
		BackgroundTransparency = 0.03,
	})

	Theme.label(panel, {
		Position = UDim2.new(0, 0, 0, 10),
		Size = UDim2.new(1, 0, 0, 32),
		Font = Theme.TitleFont,
		TextSize = 26,
		Text = "— The Dollmaker's Journal —",
	})

	local close = Theme.button(panel, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.new(0, 40, 0, 34),
		TextSize = 20,
		Text = "✕",
	})
	close.Activated:Connect(function()
		Journal.close()
	end)

	local list = Instance.new("ScrollingFrame")
	list.BackgroundTransparency = 1
	list.Position = UDim2.new(0, 14, 0, 52)
	list.Size = UDim2.new(1, -28, 1, -66)
	list.CanvasSize = UDim2.new(0, 0, 0, 0)
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollBarThickness = 6
	list.Parent = panel
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.Parent = list
	listFrame = list
end

function Journal.open()
	if gui then
		gui.Enabled = true
		SoundKit.play("UiClick")
	end
end

function Journal.close()
	if gui then
		gui.Enabled = false
	end
end

function Journal.toggle()
	if gui then
		if gui.Enabled then
			Journal.close()
		else
			Journal.open()
		end
	end
end

function Journal.init()
	buildUI()

	Remotes.get(Remotes.Names.PlayerStats).OnClientEvent:Connect(function(stats: any)
		if typeof(stats) ~= "table" then
			return
		end
		latestStats = stats
		refreshList()
	end)

	Remotes.get(Remotes.Names.StateChanged).OnClientEvent:Connect(function(state: any)
		if state ~= "LobbyIdle" and gui then
			gui.Enabled = false
		end
	end)

	-- panel-open interop: see PACKET_1_LOBBY_SYSTEMS.md "READ THIS FIRST" §3
	local openBindable: BindableEvent
	local existing = ReplicatedStorage:FindFirstChild("PorcelainOpenPanel")
	if existing and existing:IsA("BindableEvent") then
		openBindable = existing
	else
		openBindable = Instance.new("BindableEvent")
		openBindable.Name = "PorcelainOpenPanel"
		openBindable.Parent = ReplicatedStorage
	end
	openBindable.Event:Connect(function(panelName: string?)
		if panelName == "Journal" then
			Journal.open()
		end
	end)

	-- desktop convenience shortcut; mirrors PanicEmote's "+ E key on PC" precedent alongside its touch button
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.J then
			Journal.toggle()
		end
	end)
end

return Journal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">LedgerUI</string>
              <string name="Source"><![CDATA[--!strict
-- The Dollmaker's ledger: spirits + codes on the left, shared slots + found tray on the right.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local Glyphs = require(Shared:WaitForChild("Defs"):WaitForChild("Glyphs")) :: any
local Spirits = require(Shared:WaitForChild("Defs"):WaitForChild("Spirits")) :: any
local GlyphMatch = require(Shared:WaitForChild("Logic"):WaitForChild("GlyphMatch")) :: any
local GlyphRender = require(Shared:WaitForChild("GlyphRender")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local LedgerUI = {}

local gui: ScreenGui? = nil
local slotFrames: { Frame } = {}
local trayFrame: Frame? = nil
local matchBanner: TextLabel? = nil
local found: { string } = {}
local slots: { [number]: string? } = {}
local selectedGlyph: string? = nil
local deskPart: BasePart? = nil
local distanceConn: RBXScriptConnection? = nil

-- ---------- open / close + walk-away auto-close (B5) ----------

local function stopDistanceWatch()
	if distanceConn then
		distanceConn:Disconnect()
		distanceConn = nil
	end
end

local function closeBook()
	if gui then
		gui.Enabled = false
	end
	stopDistanceWatch()
end

local function getLedgerDesk(): BasePart?
	if deskPart and deskPart.Parent then
		return deskPart
	end
	local tagged = CollectionService:GetTagged("LedgerDesk")
	local part = tagged[1]
	if part and part:IsA("BasePart") then
		deskPart = part
		return deskPart
	end
	return nil
end

local function startDistanceWatch()
	stopDistanceWatch()
	local desk = getLedgerDesk()
	if not desk then
		-- desk not found (shouldn't happen once MapBuilder has run) -- fail open rather than
		-- trap the player with an unclosable book (R2)
		return
	end
	distanceConn = RunService.Heartbeat:Connect(function()
		local g = gui
		if not g or not g.Enabled then
			stopDistanceWatch()
			return
		end
		local char = Players.LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") then
			return
		end
		if (root.Position - desk.Position).Magnitude > Config.Ledger.AutoCloseDistance then
			closeBook()
		end
	end)
end

local function openBook()
	if not gui then
		return
	end
	gui.Enabled = true
	startDistanceWatch()
end

local function glyphButton(parent: Instance, glyphId: string, size: number, onTap: (() -> ())?): TextButton
	local button = Theme.button(parent, {
		Size = UDim2.new(0, size, 0, size),
		Text = "",
	})
	local canvas = Instance.new("Frame")
	canvas.BackgroundTransparency = 1
	canvas.Size = UDim2.new(1, -10, 1, -10)
	canvas.Position = UDim2.new(0, 5, 0, 5)
	canvas.Parent = button
	GlyphRender.render(glyphId, canvas)
	if onTap then
		button.Activated:Connect(onTap)
	end
	return button
end

local function refreshSlots()
	for i, frame in slotFrames do
		for _, child in frame:GetChildren() do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end
		local glyphId = slots[i]
		if glyphId then
			local canvas = Instance.new("Frame")
			canvas.BackgroundTransparency = 1
			canvas.Size = UDim2.new(1, -10, 1, -10)
			canvas.Position = UDim2.new(0, 5, 0, 5)
			canvas.Parent = frame
			GlyphRender.render(glyphId, canvas, Theme.Gold)
		else
			Theme.label(frame, {
				Size = UDim2.new(1, 0, 1, 0),
				Font = Theme.TitleFont,
				TextSize = 30,
				TextColor3 = Theme.Muted,
				TextTransparency = 0.5,
				Text = tostring(i),
			})
		end
	end
	-- client-side match feedback (server stays authoritative)
	if matchBanner then
		local spiritId = GlyphMatch.identify(Spirits.list, slots)
		if spiritId then
			local spirit = Spirits.byId[spiritId]
			matchBanner.Text = ("MATCHED: %s"):format(spirit.name)
			matchBanner.TextColor3 = Theme.Gold
		else
			matchBanner.Text = "no match yet…"
			matchBanner.TextColor3 = Theme.Muted
		end
	end
end

local function refreshTray()
	local tray = trayFrame
	if not tray then
		return
	end
	for _, child in tray:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	for _, glyphId in found do
		local button = glyphButton(tray, glyphId, 62, function()
			selectedGlyph = glyphId
			SoundKit.play("UiClick")
		end)
		local _ = button
	end
end

local function buildBook()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainLedger", 12)
	g.Enabled = false
	g.Parent = playerGui
	gui = g

	local b = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 760, 0, 460),
		BackgroundTransparency = 0.03,
	})

	Theme.label(b, {
		Position = UDim2.new(0, 0, 0, 8),
		Size = UDim2.new(1, 0, 0, 34),
		Font = Theme.TitleFont,
		TextSize = 28,
		Text = "— The Spirit Ledger —",
	})

	local close = Theme.button(b, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.new(0, 40, 0, 34),
		TextSize = 20,
		Text = "✕",
	})
	close.Activated:Connect(closeBook)

	-- left page: spirits
	local left = Instance.new("ScrollingFrame")
	left.BackgroundTransparency = 1
	left.Position = UDim2.new(0, 14, 0, 50)
	left.Size = UDim2.new(0.5, -20, 1, -64)
	left.CanvasSize = UDim2.new(0, 0, 0, 0)
	left.AutomaticCanvasSize = Enum.AutomaticSize.Y
	left.ScrollBarThickness = 4
	left.Parent = b
	local leftLayout = Instance.new("UIListLayout")
	leftLayout.Padding = UDim.new(0, 8)
	leftLayout.Parent = left
	for _, spirit in Spirits.list do
		local entry = Instance.new("Frame")
		entry.BackgroundTransparency = 1
		entry.Size = UDim2.new(1, -8, 0, 88)
		entry.Parent = left
		Theme.label(entry, {
			Size = UDim2.new(1, 0, 0, 22),
			Font = Theme.TitleFont,
			TextSize = 21,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = spirit.name,
		})
		local codeRow = Instance.new("Frame")
		codeRow.BackgroundTransparency = 1
		codeRow.Position = UDim2.new(0, 0, 0, 24)
		codeRow.Size = UDim2.new(1, 0, 0, 34)
		codeRow.Parent = entry
		local rowLayout = Instance.new("UIListLayout")
		rowLayout.FillDirection = Enum.FillDirection.Horizontal
		rowLayout.Padding = UDim.new(0, 8)
		rowLayout.Parent = codeRow
		for _, glyphId in spirit.code do
			local cell = Instance.new("Frame")
			cell.Size = UDim2.new(0, 32, 0, 32)
			cell.BackgroundColor3 = Theme.BgSoft
			cell.BorderSizePixel = 0
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(0, 6)
			corner.Parent = cell
			cell.Parent = codeRow
			local canvas = Instance.new("Frame")
			canvas.BackgroundTransparency = 1
			canvas.Size = UDim2.new(1, -6, 1, -6)
			canvas.Position = UDim2.new(0, 3, 0, 3)
			canvas.Parent = cell
			GlyphRender.render(glyphId, canvas)
		end
		Theme.label(entry, {
			Position = UDim2.new(0, 0, 0, 60),
			Size = UDim2.new(1, 0, 0, 26),
			TextSize = 13,
			TextColor3 = Theme.Muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Text = spirit.flavor,
		})
	end

	-- right page: slots + tray
	local right = Instance.new("Frame")
	right.BackgroundTransparency = 1
	right.Position = UDim2.new(0.5, 8, 0, 50)
	right.Size = UDim2.new(0.5, -22, 1, -64)
	right.Parent = b
	Theme.label(right, {
		Size = UDim2.new(1, 0, 0, 22),
		TextSize = 15,
		TextColor3 = Theme.Muted,
		Text = "Tap a found glyph, then tap a slot. Order matters.",
	})
	local slotRow = Instance.new("Frame")
	slotRow.BackgroundTransparency = 1
	slotRow.Position = UDim2.new(0, 0, 0, 30)
	slotRow.Size = UDim2.new(1, 0, 0, 92)
	slotRow.Parent = right
	local slotLayout = Instance.new("UIListLayout")
	slotLayout.FillDirection = Enum.FillDirection.Horizontal
	slotLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	slotLayout.Padding = UDim.new(0, 12)
	slotLayout.Parent = slotRow
	for i = 1, 3 do
		local slot = Instance.new("Frame")
		slot.Size = UDim2.new(0, 84, 0, 84)
		slot.BackgroundColor3 = Theme.BgSoft
		slot.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 10)
		corner.Parent = slot
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Accent
		stroke.Transparency = 0.5
		stroke.Parent = slot
		slot.Parent = slotRow
		table.insert(slotFrames, slot)
		local button = Instance.new("TextButton")
		button.BackgroundTransparency = 1
		button.Size = UDim2.new(1, 0, 1, 0)
		button.Text = ""
		button.ZIndex = 5
		button.Parent = slot
		button.Activated:Connect(function()
			if selectedGlyph then
				Remotes.get(Remotes.Names.SlotGlyph):FireServer(i, selectedGlyph)
				selectedGlyph = nil
			elseif slots[i] then
				Remotes.get(Remotes.Names.SlotGlyph):FireServer(i, nil)
			end
		end)
	end

	matchBanner = Theme.label(right, {
		Position = UDim2.new(0, 0, 0, 128),
		Size = UDim2.new(1, 0, 0, 26),
		Font = Theme.TitleFont,
		TextSize = 22,
		Text = "no match yet…",
		TextColor3 = Theme.Muted,
	})

	Theme.label(right, {
		Position = UDim2.new(0, 0, 0, 160),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 14,
		TextColor3 = Theme.Muted,
		Text = "Found glyphs:",
	})
	local tray = Instance.new("Frame")
	tray.BackgroundTransparency = 1
	tray.Position = UDim2.new(0, 0, 0, 184)
	tray.Size = UDim2.new(1, 0, 1, -184)
	tray.Parent = right
	local trayLayout = Instance.new("UIGridLayout")
	trayLayout.CellSize = UDim2.new(0, 62, 0, 62)
	trayLayout.CellPadding = UDim2.new(0, 8, 0, 8)
	trayLayout.Parent = tray
	trayFrame = tray

	refreshSlots()
end

function LedgerUI.init()
	buildBook()

	ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt, player: Player)
		if player ~= Players.LocalPlayer then
			return
		end
		if prompt.ObjectText == "Spirit Ledger" then
			openBook()
		end
	end)

	Remotes.get(Remotes.Names.GlyphFound).OnClientEvent:Connect(function(_glyphId: any, data: any)
		if typeof(data) ~= "table" then
			return
		end
		if typeof(data.found) == "table" then
			found = data.found
		end
		if typeof(data.slots) == "table" then
			slots = {}
			for i = 1, 3 do
				local v = data.slots[i]
				slots[i] = if typeof(v) == "string" then v else nil
			end
		end
		refreshTray()
		refreshSlots()
	end)

	-- close the book automatically: end of run, AND the shift->shift transition (B5).
	Remotes.get(Remotes.Names.StateChanged).OnClientEvent:Connect(function(state: any)
		if state == "LobbyIdle" or state == "RunEnd" or state == "ShiftResult" or state == "ShiftIntro" then
			closeBook()
		end
	end)
end

local _ = Glyphs -- glyph defs consumed via GlyphRender

return LedgerUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">LobbyHud</string>
              <string name="Source"><![CDATA[--!strict
-- Left-side lobby hub HUD: Shop / Invite / Classes / Journal, in that order (matches the team's own
-- description and the reference screenshots exactly). Pure ScreenGui (no 3D kiosk) so it drops into
-- any hub layout unchanged. Visible only in LobbyIdle, hidden during any active-shift state.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local LobbyHud = {}

-- Lazily-created client-local BindableEvent -- see PACKET_1_LOBBY_SYSTEMS.md "READ THIS FIRST" §3:
-- this is the canonical panel-open convention Shop.luau/Journal.luau both listen on.
local function getOpenPanelBindable(): BindableEvent
	local existing = ReplicatedStorage:FindFirstChild("PorcelainOpenPanel")
	if existing and existing:IsA("BindableEvent") then
		return existing
	end
	local bindable = Instance.new("BindableEvent")
	bindable.Name = "PorcelainOpenPanel"
	bindable.Parent = ReplicatedStorage
	return bindable
end

local gui: ScreenGui? = nil

local function addButton(parent: Instance, text: string, order: number): TextButton
	return Theme.button(parent, {
		Size = UDim2.new(1, 0, 0, 72),
		LayoutOrder = order,
		TextSize = 20,
		Text = text,
	})
end

local function build()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainLobbyHud", 6)
	g.Enabled = false
	g.Parent = playerGui
	gui = g

	local column = Instance.new("Frame")
	column.BackgroundTransparency = 1
	column.AnchorPoint = Vector2.new(0, 1)
	column.Position = UDim2.new(0, 16, 1, -16)
	column.Size = UDim2.new(0.34, 0, 0, 320)
	column.Parent = g
	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MaxSize = Vector2.new(190, 1000)
	sizeConstraint.MinSize = Vector2.new(120, 100)
	sizeConstraint.Parent = column
	local layout = Instance.new("UIListLayout")
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.Padding = UDim.new(0, 10)
	layout.Parent = column

	-- RESTORED 2026-08-15: team confirmed Classes stays a separate button (see "READ THIS FIRST"
	-- §3). Order matches the team's own description ("shop invite, classes, and journal") AND the
	-- reference screenshots exactly: Shop, Invite, Classes, Journal, top to bottom.
	local shopButton = addButton(column, "SHOP", 1)
	local inviteButton = addButton(column, "INVITE", 2)
	local classesButton = addButton(column, "CLASSES", 3)
	local journalButton = addButton(column, "JOURNAL", 4)

	shopButton.Activated:Connect(function()
		SoundKit.play("UiClick")
		getOpenPanelBindable():Fire("Shop")
	end)
	-- Per "READ THIS FIRST" §3: InviteButton.luau's SocialService-based implementation is the
	-- resolved, recommended one (more current API, graceful disable-with-toast on failure). This
	-- button just tags itself and defers to that controller instead of keeping its own inline
	-- StarterGui:SetCore call.
	CollectionService:AddTag(inviteButton, "InviteButtonTag")
	classesButton.Activated:Connect(function()
		SoundKit.play("UiClick")
		getOpenPanelBindable():Fire("Classes")
	end)
	journalButton.Activated:Connect(function()
		SoundKit.play("UiClick")
		getOpenPanelBindable():Fire("Journal")
	end)
end

function LobbyHud.init()
	build()

	Remotes.get(Remotes.Names.StateChanged).OnClientEvent:Connect(function(state: any)
		local g = gui
		if g then
			g.Enabled = (state == "LobbyIdle")
		end
	end)
end

return LobbyHud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">MinigameController</string>
              <string name="Source"><![CDATA[--!strict
-- The four care minigames. Touch-first, bottom-anchored, driven by MinigameStart/Done/Cancel.
-- Failure inside the lock window just retries — TIME is the cost (Presence keeps filling).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config")) :: any
local Remotes = require(Shared:WaitForChild("Remotes")) :: any
local CareSteps = require(Shared:WaitForChild("Defs"):WaitForChild("CareSteps")) :: any
local SoundKit = require(Shared:WaitForChild("SoundKit")) :: any
local Theme = require(script.Parent.Parent:WaitForChild("Theme")) :: any

local MinigameController = {}

local gui: ScreenGui? = nil
local activePanel: Frame? = nil
local activeKey: string? = nil -- dollId..stepId
local heartbeat: RBXScriptConnection? = nil

local function closePanel()
	if heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
	end
	if activePanel then
		activePanel:Destroy()
		activePanel = nil
	end
	activeKey = nil
end

local function finish(dollId: string, stepId: string, success: boolean)
	if activeKey ~= dollId .. stepId then
		return
	end
	if success then
		SoundKit.play("StepDone")
	end
	Remotes.get(Remotes.Names.MinigameDone):FireServer(dollId, stepId, success)
	closePanel()
end

local function makePanel(title: string, subtitle: string): (Frame, Frame)
	local g = gui
	assert(g, "gui missing")
	local panel = Theme.panel(g, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -30),
		Size = UDim2.new(0, 480, 0, 300),
		BackgroundTransparency = 0.06,
	})
	Theme.label(panel, {
		Position = UDim2.new(0, 0, 0, 10),
		Size = UDim2.new(1, 0, 0, 34),
		Font = Theme.TitleFont,
		TextSize = 28,
		Text = title,
	})
	Theme.label(panel, {
		Position = UDim2.new(0, 0, 0, 44),
		Size = UDim2.new(1, 0, 0, 20),
		TextSize = 15,
		TextColor3 = Theme.Muted,
		Text = subtitle,
	})
	local arena = Instance.new("Frame")
	arena.BackgroundTransparency = 1
	arena.Position = UDim2.new(0, 16, 0, 70)
	arena.Size = UDim2.new(1, -32, 1, -86)
	arena.Parent = panel
	activePanel = panel
	return panel, arena
end

local function progressBar(panel: Frame): (Frame, (n: number) -> ())
	local barBg = Instance.new("Frame")
	barBg.AnchorPoint = Vector2.new(0.5, 1)
	barBg.Position = UDim2.new(0.5, 0, 1, -8)
	barBg.Size = UDim2.new(1, -32, 0, 10)
	barBg.BackgroundColor3 = Theme.BgSoft
	barBg.BorderSizePixel = 0
	barBg.Parent = panel
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = barBg
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0)
	fill.BackgroundColor3 = Theme.Gold
	fill.BorderSizePixel = 0
	fill.Parent = barBg
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(1, 0)
	fc.Parent = fill
	return barBg, function(n: number)
		fill.Size = UDim2.new(math.clamp(n, 0, 1), 0, 1, 0)
	end
end

-- ---------- minigames ----------

-- Procedural hairbrush icon (paddle head + bristles + handle), built from Frame/UICorner
-- instances -- same zero-asset technique as GlyphRender.luau -- so it never depends on Roblox's
-- emoji-glyph font coverage (B6: 🪮 rendered as a tofu box on some clients).
local function drawBrushIcon(parent: GuiObject)
	local canvas = Instance.new("Frame")
	canvas.BackgroundTransparency = 1
	canvas.Size = UDim2.fromScale(1, 1)
	canvas.Parent = parent

	local head = Instance.new("Frame")
	head.AnchorPoint = Vector2.new(0.5, 0.5)
	head.Position = UDim2.fromScale(0.5, 0.36)
	head.Size = UDim2.fromScale(0.62, 0.36)
	head.BackgroundColor3 = Theme.Parchment
	head.BorderSizePixel = 0
	head.Parent = canvas
	local headCorner = Instance.new("UICorner")
	headCorner.CornerRadius = UDim.new(1, 0)
	headCorner.Parent = head

	for i = 1, 5 do
		local bristle = Instance.new("Frame")
		bristle.AnchorPoint = Vector2.new(0.5, 1)
		bristle.Position = UDim2.fromScale(0.19 + (i - 1) * 0.155, 0.2)
		bristle.Size = UDim2.fromScale(0.05, 0.2)
		bristle.BackgroundColor3 = Theme.Bg
		bristle.BorderSizePixel = 0
		bristle.Parent = canvas
		local bristleCorner = Instance.new("UICorner")
		bristleCorner.CornerRadius = UDim.new(1, 0)
		bristleCorner.Parent = bristle
	end

	local handle = Instance.new("Frame")
	handle.AnchorPoint = Vector2.new(0.5, 0.5)
	handle.Position = UDim2.fromScale(0.5, 0.78)
	handle.Size = UDim2.fromScale(0.16, 0.42)
	handle.BackgroundColor3 = Theme.Gold
	handle.BorderSizePixel = 0
	handle.Parent = canvas
	local handleCorner = Instance.new("UICorner")
	handleCorner.CornerRadius = UDim.new(1, 0)
	handleCorner.Parent = handle
end

local function mashGame(dollId: string, stepId: string, speedMultiplier: number)
	local panel, arena = makePanel("Brush the Hair", "Tap the brush — smooth every tangle!")
	local _, setProgress = progressBar(panel)
	local progress = 0
	local button = Theme.button(arena, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 160, 0, 120),
		Text = "",
	})
	drawBrushIcon(button)
	button.Activated:Connect(function()
		SoundKit.play("BrushStroke")
		-- SwiftHands class buff: speedMultiplier < 1 = faster, so divide (a smaller multiplier
		-- means a bigger per-tap increment, fewer taps needed to fill the bar).
		progress += 0.09 / speedMultiplier
		setProgress(progress)
		button.Rotation = (math.random() - 0.5) * 20
		if progress >= 1 then
			finish(dollId, stepId, true)
		end
	end)
end

local function holdGame(dollId: string, stepId: string, title: string, subtitle: string, speedMultiplier: number)
	local panel, arena = makePanel(title, subtitle)
	local _, setProgress = progressBar(panel)
	local progress = 0
	local holding = false
	local circle = Theme.button(arena, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 130, 0, 130),
		TextSize = 20,
		Text = "HOLD",
	})
	local corner = circle:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(1, 0)
	end
	circle.MouseButton1Down:Connect(function()
		holding = true
	end)
	circle.MouseButton1Up:Connect(function()
		holding = false
	end)
	local t = 0
	heartbeat = RunService.Heartbeat:Connect(function(dt: number)
		t += dt
		-- circle drifts slowly; player must keep the press
		circle.Position = UDim2.new(0.5 + math.sin(t * 0.7) * 0.22, 0, 0.5 + math.cos(t * 0.9) * 0.14, 0)
		if holding then
			-- SwiftHands class buff: speedMultiplier < 1 = faster fill.
			progress += dt / (4 * speedMultiplier)
			setProgress(progress)
			if progress >= 1 then
				finish(dollId, stepId, true)
			end
		end
	end)
end

local function sequenceGame(dollId: string, stepId: string, seed: number)
	local panel, arena = makePanel("Paint the Face", "Tap the paint dots IN ORDER — 1, 2, 3, 4, 5.")
	local _, setProgress = progressBar(panel)
	local rng = Random.new(seed)
	local expected = 1
	for i = 1, 5 do
		local dot = Theme.button(arena, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.12 + rng:NextNumber() * 0.76, 0, 0.15 + rng:NextNumber() * 0.7, 0),
			Size = UDim2.new(0, 64, 0, 64),
			TextSize = 26,
			Text = tostring(i),
		})
		local corner = dot:FindFirstChildOfClass("UICorner")
		if corner then
			corner.CornerRadius = UDim.new(1, 0)
		end
		dot.Activated:Connect(function()
			if i == expected then
				expected += 1
				dot.Visible = false
				setProgress((expected - 1) / 5)
				SoundKit.play("UiClick")
				if expected > 5 then
					finish(dollId, stepId, true)
				end
			else
				-- wrong tap: reset order (retry within the lock window)
				expected = 1
				setProgress(0)
				for _, child in arena:GetChildren() do
					if child:IsA("TextButton") then
						child.Visible = true
					end
				end
			end
		end)
	end
	local _ = panel
end

local function timingGame(dollId: string, stepId: string)
	local panel, arena = makePanel("Button the Coat", "Tap when the needle is in the GOLD zone. 3 buttons.")
	local _, setProgress = progressBar(panel)
	local hits = 0
	local zoneWidth = 0.3
	local track = Instance.new("Frame")
	track.AnchorPoint = Vector2.new(0.5, 0.5)
	track.Position = UDim2.new(0.5, 0, 0.35, 0)
	track.Size = UDim2.new(0.9, 0, 0, 22)
	track.BackgroundColor3 = Theme.BgSoft
	track.BorderSizePixel = 0
	track.Parent = arena
	local zone = Instance.new("Frame")
	zone.BackgroundColor3 = Theme.Gold
	zone.BackgroundTransparency = 0.4
	zone.BorderSizePixel = 0
	zone.Parent = track
	local needle = Instance.new("Frame")
	needle.Size = UDim2.new(0, 4, 1.6, 0)
	needle.AnchorPoint = Vector2.new(0.5, 0.2)
	needle.BackgroundColor3 = Theme.Parchment
	needle.BorderSizePixel = 0
	needle.Parent = track
	local function rollZone()
		zone.Size = UDim2.new(zoneWidth, 0, 1, 0)
		zone.Position = UDim2.new(math.random() * (1 - zoneWidth), 0, 0, 0)
	end
	rollZone()
	local t = 0
	heartbeat = RunService.Heartbeat:Connect(function(dt: number)
		t += dt
		local x = (math.sin(t * 2.2) + 1) / 2
		needle.Position = UDim2.new(x, 0, 0, 0)
	end)
	local tapButton = Theme.button(arena, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.75, 0),
		Size = UDim2.new(0, 180, 0, 70),
		TextSize = 24,
		Text = "BUTTON IT",
	})
	tapButton.Activated:Connect(function()
		local x = needle.Position.X.Scale
		local z0 = zone.Position.X.Scale
		if x >= z0 and x <= z0 + zoneWidth then
			hits += 1
			setProgress(hits / 3)
			SoundKit.play("UiConfirm")
			zoneWidth = math.max(0.12, zoneWidth - 0.08)
			rollZone()
			if hits >= 3 then
				finish(dollId, stepId, true)
			end
		end
	end)
end

-- ---------- wiring ----------

function MinigameController.init()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = Theme.screenGui("PorcelainMinigames", 10)
	g.Parent = playerGui
	gui = g

	Remotes.get(Remotes.Names.MinigameStart).OnClientEvent:Connect(function(dollId: any, stepId: any, seed: any, speedMultiplierArg: any)
		if typeof(dollId) ~= "string" or typeof(stepId) ~= "string" then
			return
		end
		local speedMultiplier = if typeof(speedMultiplierArg) == "number" and speedMultiplierArg > 0
			then speedMultiplierArg
			else 1
		closePanel()
		activeKey = dollId .. stepId
		local step = CareSteps.byId[stepId]
		local kind = step and step.minigame or "mash"
		if kind == "mash" then
			mashGame(dollId, stepId, speedMultiplier)
		elseif kind == "hold" then
			if stepId == "Eyes" then
				holdGame(dollId, stepId, "Polish the Eyes", "Hold the cloth steady — follow it as it drifts.", speedMultiplier)
			else
				holdGame(dollId, stepId, "Wind the Music Box", "Hold the crank — don't let go until it sings.", speedMultiplier)
			end
		elseif kind == "sequence" then
			sequenceGame(dollId, stepId, if typeof(seed) == "number" then seed else 1)
		elseif kind == "timing" then
			timingGame(dollId, stepId)
		end
		-- client-side watchdog mirror (R2): close a bit after the server lock expires
		task.delay(Config.Care.MinigameSeconds + 2, function()
			if activeKey == dollId .. stepId then
				closePanel()
			end
		end)
	end)

	Remotes.get(Remotes.Names.MinigameCancel).OnClientEvent:Connect(function(dollId: any, stepId: any)
		if typeof(dollId) == "string" and typeof(stepId) == "string" and activeKey == dollId .. stepId then
			closePanel()
		end
	end)
end

return MinigameController
]]></string>
            </Properties>
